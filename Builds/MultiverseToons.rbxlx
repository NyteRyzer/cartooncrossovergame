<Item class="StarterPlayerScripts" referent="RBX18838"><Properties>
<string name="Name">StarterPlayerScripts</string>
</Properties>
<Item class="LocalScript" referent="RBX18839"><Properties>
<string name="Name">Client</string>
<ProtectedString name="Source"><![CDATA[--!nonstrict
-- Client entry point: two-phase startup of every controller (init wires
-- them together, start begins loops and connections).

local controllers = {}
local order = { "Input", "Hud", "CameraRig", "Movement", "CombatAssist", "Animator", "Effects", "Companions", "Vehicle", "Minimap" }
for _, name in ipairs(order) do
	local module = script:WaitForChild("Controllers"):WaitForChild(name, 10)
	if module then
		controllers[name] = require(module)
	else
		warn("[MultiverseToons] missing controller " .. name)
	end
end
for _, name in ipairs(order) do
	local c = controllers[name]
	if c and type(c.init) == "function" then
		c.init(controllers)
	end
end
for _, name in ipairs(order) do
	local c = controllers[name]
	if c and type(c.start) == "function" then
		task.spawn(c.start)
	end
end
]]></ProtectedString>
</Properties>
<Item class="Folder" referent="RBX18840"><Properties>
<string name="Name">Controllers</string>
</Properties>
<Item class="ModuleScript" referent="RBX18841"><Properties>
<string name="Name">Animator</string>
<ProtectedString name="Source"><![CDATA[--!nonstrict
-- Animates every hero in the server with Shared/Pose (the prototype's
-- procedural animation): each frame, each character's movement state becomes
-- joint angles on its R15 Motor6Ds. The local hero reads Movement's state
-- directly; other players use the attributes the server relays. Also shows
-- or hides state-dependent gear (Jake's dragon, Danny's ghost tail, Aang's
-- glider, rocket flames...), blinks the faces, and spins Cannonbolt.

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Pose = require(Shared:WaitForChild("Pose"))

local Animator = {}
local Movement
local player = Players.LocalPlayer
local rigs = {} -- [character] = cache

local JOINTS = {
	Root = { "LowerTorso", "Root" }, Waist = { "UpperTorso", "Waist" }, Neck = { "Head", "Neck" },
	LShoulder = { "LeftUpperArm", "LeftShoulder" }, LElbow = { "LeftLowerArm", "LeftElbow" },
	RShoulder = { "RightUpperArm", "RightShoulder" }, RElbow = { "RightLowerArm", "RightElbow" },
	LHip = { "LeftUpperLeg", "LeftHip" }, LKnee = { "LeftLowerLeg", "LeftKnee" }, LAnkle = { "LeftFoot", "LeftAnkle" },
	RHip = { "RightUpperLeg", "RightHip" }, RKnee = { "RightLowerLeg", "RightKnee" }, RAnkle = { "RightFoot", "RightAnkle" },
}
local BODY = {
	"UpperTorso", "LowerTorso", "LeftUpperArm", "LeftLowerArm", "LeftHand", "RightUpperArm", "RightLowerArm",
	"RightHand", "LeftUpperLeg", "LeftLowerLeg", "LeftFoot", "RightUpperLeg", "RightLowerLeg", "RightFoot",
}
local LEGS = { LeftUpperLeg = true, LeftLowerLeg = true, LeftFoot = true, RightUpperLeg = true, RightLowerLeg = true, RightFoot = true }

local rad = math.rad
local function A(x, y, z)
	return CFrame.Angles(rad(x), rad(y), rad(z))
end

local function cacheFor(character)
	local c = rigs[character]
	if c and c.Gear and c.Gear.Parent then
		return c
	end
	-- No gear yet (still being dressed): retry a few times a second, not every frame.
	if c and not c.Gear and os.clock() < (c.RetryAt or 0) then
		return c
	end
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if not humanoid or humanoid.RigType ~= Enum.HumanoidRigType.R15 then
		return nil
	end
	c = c or { WalkPhase = 0, IdleTime = 0, Emote = 0, Dodge = 0, Blink = math.random() * 3 }
	c.Humanoid = humanoid
	c.Root = character:FindFirstChild("HumanoidRootPart")
	c.Joints = {}
	for key, spec in pairs(JOINTS) do
		local part = character:FindFirstChild(spec[1])
		c.Joints[key] = part and part:FindFirstChild(spec[2])
	end
	c.Gear = character:FindFirstChild("HeroGear")
	c.RetryAt = os.clock() + 0.3
	c.Spinner, c.SpinBase = nil, nil
	c.Toggles = {}
	c.Extra = {}
	if c.Gear then
		for _, p in ipairs(c.Gear:GetChildren()) do
			if p:IsA("BasePart") then
				local when = p:GetAttribute("ShowWhen")
				if when then
					table.insert(c.Toggles, { Part = p, When = when, Base = p.Transparency })
				end
				if p:GetAttribute("Spin") then
					c.Spinner = p:FindFirstChild("GearWeld")
					c.SpinBase = c.Spinner and c.Spinner.C0
				end
			end
		end
		local head = c.Gear:FindFirstChild("ToonHead")
		c.Face = head and head:FindFirstChild("Face")
	end
	for _, d in ipairs(character:GetDescendants()) do
		if d:IsA("Motor6D") and (d.Name == "StaffJoint" or d.Name:sub(1, 8) == "ExtraArm" or d.Name:sub(1, 10) == "DragonWing") then
			c.Extra[d.Name] = d
		end
	end
	rigs[character] = c
	return c
end

local function setVisible(part, visible, base)
	part.Transparency = visible and base or 1
end

local function bodyVisibility(character, c, mode)
	-- mode: nil (normal), "Dragon" (hide human), "Ball" (Cannonbolt), "Ghost" (Danny phasing), "Tail" (hide legs)
	if c.BodyMode == mode then
		return
	end
	c.BodyMode = mode
	for _, name in ipairs(BODY) do
		local p = character:FindFirstChild(name)
		if p then
			local hide = mode == "Dragon" or mode == "Ball" or (mode == "Tail" and LEGS[name])
			p.LocalTransparencyModifier = hide and 1 or (mode == "Ghost" and 0.6 or 0)
		end
	end
	if c.Gear then
		for _, p in ipairs(c.Gear:GetChildren()) do
			if p:IsA("BasePart") and not p:GetAttribute("ShowWhen") then
				p.LocalTransparencyModifier = (mode == "Dragon" or mode == "Ball") and 1 or (mode == "Ghost" and 0.6 or 0)
			end
		end
	end
end

-- Movement state for another player's character, from relayed attributes.
local function remoteState(character, c, dt)
	local root = c.Root
	local v = root.AssemblyLinearVelocity
	local flat = Vector3.new(v.X, 0, v.Z).Magnitude
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = { character }
	local reach = c.Humanoid.HipHeight + root.Size.Y * 0.5 + 0.8
	local grounded = workspace:Raycast(root.Position, Vector3.new(0, -reach, 0), params) ~= nil
	local emoting = character:GetAttribute("MvEmote")
	if emoting and c.Emote <= 0 then
		c.Emote = Pose.EmoteTime
	elseif not emoting then
		c.Emote = 0
	end
	c.Emote = math.max(0, c.Emote - dt)
	local dodging = character:GetAttribute("MvDodge")
	if dodging and not c.WasDodging then
		c.Dodge = character:GetAttribute("MvDodgeAir") and 0.32 or 0.4
	end
	c.WasDodging = dodging
	c.Dodge = math.max(0, c.Dodge - dt)
	c.WalkPhase = c.WalkPhase + flat * dt * 0.75 / c.Scale
	if grounded and flat < 1 then
		c.IdleTime = c.IdleTime + dt
	else
		c.IdleTime = 0
	end
	local flying = character:GetAttribute("MvFlying") == true
	return {
		Speed = flat, Speed3 = v.Magnitude, VelY = v.Y, Grounded = grounded and not flying,
		Flying = flying, Gliding = character:GetAttribute("MvGliding") == true,
		Pounding = character:GetAttribute("MvPounding") == true, Dodge = c.Dodge, DodgeAir = character:GetAttribute("MvDodgeAir"),
		DodgeSide = character:GetAttribute("MvDodgeSide") or 1, EmoteTime = c.Emote, WallSlide = character:GetAttribute("MvWallSlide") and 1 or 0,
		FlyBank = character:GetAttribute("MvFlyBank") or 0, FlyPitch = character:GetAttribute("MvFlyPitch") or 0,
		Boosting = character:GetAttribute("MvBoosting"), Jetpack = character:GetAttribute("MvJetpack"),
		Scooter = character:GetAttribute("MvScooter"), Intangible = character:GetAttribute("MvIntangible"),
		TakeoffTime = character:GetAttribute("MvTakeoff") and 0.3 or 0, Breath = character:GetAttribute("MvBreath"),
		WalkPhase = c.WalkPhase, IdleTime = c.IdleTime,
		Slide = character:GetAttribute("MvSlide"), WallRun = character:GetAttribute("MvWallRun"), WallSide = character:GetAttribute("MvWallSide") or 0,
		Climb = character:GetAttribute("MvClimb"), Swing = character:GetAttribute("MvSwing"),
	}
end

local function localState(c)
	local S = Movement.state()
	local root = c.Root
	local v = root.AssemblyLinearVelocity
	return {
		Speed = Vector3.new(v.X, 0, v.Z).Magnitude, Speed3 = v.Magnitude, VelY = v.Y, Grounded = S.Grounded,
		Flying = S.Flying, Gliding = S.Gliding, Pounding = S.Pounding, PoundLand = S.PoundLand,
		Dodge = S.Dodge, DodgeAir = S.DodgeAir, DodgeSide = S.DodgeSide, AttackAnim = S.AttackAnim, AttackDur = S.AttackDur,
		AttackStep = S.AttackStep, LandTimer = S.LandTimer, IdleTime = S.IdleTime, EmoteTime = S.EmoteTime,
		FlipTime = S.FlipTime, WallSlide = S.WallSlide, FlyBank = S.FlyBank, FlyPitch = S.FlyPitch, Boosting = S.Boosting,
		TakeoffTime = S.TakeoffTime, Breath = S.Breath, Jetpack = S.Jetpack > 0, Scooter = S.Scooter > 0,
		Intangible = S.Intangible, WalkPhase = S.WalkPhase,
		Slide = S.Slide > 0, WallRun = S.WallRun ~= nil, WallSide = S.WallRun and S.WallRun.Side or 0, Climb = S.Climb,
		Swing = S.Swing ~= nil, Counter = S.CounterAnim, Block = S.BlockAnim, Takedown = S.TakedownAnim,
	}
end

local function animate(character, c, dt, now, serverNow)
	local isLocal = character == player.Character
	c.Scale = math.max(0.5, (c.Humanoid.HipHeight + c.Root.Size.Y * 0.5) / 3)
	local st = isLocal and localState(c) or remoteState(character, c, dt)
	st.Time = now
	st.Hero = character:GetAttribute("Hero") or "Ben"
	st.Form = character:GetAttribute("Form")
	if not isLocal then
		-- Attacks come from the server's record of the swing.
		local at = character:GetAttribute("AttackAt")
		if at then
			local dur = character:GetAttribute("AttackDur") or 0.25
			st.AttackAnim = math.max(0, dur - (serverNow - at))
			st.AttackDur = dur
			st.AttackStep = character:GetAttribute("AttackStep") or 0
		end
	end
	if not isLocal then
		-- Counters and blocks come from the server's record.
		local counterAt = character:GetAttribute("CounterAt")
		if counterAt then
			st.Counter = math.max(0, 0.3 - (serverNow - counterAt))
		end
		local blockAt = character:GetAttribute("BlockAt")
		if blockAt then
			st.Block = math.max(0, 0.5 - (serverNow - blockAt))
		end
	end
	local hurtAt = character:GetAttribute("HurtAt")
	if hurtAt then
		st.Hurt = math.max(0, 0.25 - (serverNow - hurtAt))
	end
	local O = Pose.Compute(st)

	-- Prototype space -> R15 joint space (see Shared/Pose for conventions).
	local k = c.Scale * 3 * 1.73 / 150
	local J = c.Joints
	if J.Root then
		J.Root.Transform = CFrame.new(-O.ShiftX * k, O.Bob * k, 0)
			* A(0, 0, -O.BodyRoll) * A(-O.BodyPitch, 0, 0) * A(-O.Lean, 0, 0) * A(0, 0, -O.HipRoll) * A(0, O.HipTwist + O.Spin, 0)
	end
	if J.Waist then
		J.Waist.Transform = A(0, O.ChestTwist - O.HipTwist, 0)
	end
	if J.Neck then
		J.Neck.Transform = A(-O.HeadPitch, O.HeadYaw, -O.HeadRoll)
	end
	if J.LShoulder then
		J.LShoulder.Transform = A(O.ShFwd[1], 0, 0) * A(0, 0, -O.ShAbd[1])
	end
	if J.RShoulder then
		J.RShoulder.Transform = A(O.ShFwd[2], 0, 0) * A(0, 0, O.ShAbd[2])
	end
	if J.LElbow then
		J.LElbow.Transform = A(O.Elbow[1], 0, 0)
	end
	if J.RElbow then
		J.RElbow.Transform = A(O.Elbow[2], 0, 0)
	end
	if J.LHip then
		J.LHip.Transform = A(O.Thigh[1], 0, 0) * A(0, 0, -(2 + O.ThighAbd[1]))
	end
	if J.RHip then
		J.RHip.Transform = A(O.Thigh[2], 0, 0) * A(0, 0, 2 + O.ThighAbd[2])
	end
	if J.LKnee then
		J.LKnee.Transform = A(-O.Knee[1], 0, 0)
	end
	if J.RKnee then
		J.RKnee.Transform = A(-O.Knee[2], 0, 0)
	end
	if J.LAnkle then
		J.LAnkle.Transform = A(O.Ankle[1], 0, 0)
	end
	if J.RAnkle then
		J.RAnkle.Transform = A(O.Ankle[2], 0, 0)
	end
	local X = c.Extra
	if X.ExtraArmL then
		X.ExtraArmL.Transform = A(O.ShFwd[2] * 0.8, 0, 0) * A(0, 0, -25)
	end
	if X.ExtraArmR then
		X.ExtraArmR.Transform = A(O.ShFwd[1] * 0.8, 0, 0) * A(0, 0, 25)
	end
	if X.StaffJoint then
		X.StaffJoint.Transform = A(0, O.StaffSpin, 0)
	end
	local flap
	if st.Flying then
		local dive = (st.VelY or 0) < -23 and not st.Boosting
		c.FlapPhase = (c.FlapPhase or 0) + dt * (dive and 1 or 6 + (st.Boosting and 5 or 0) + math.max(0, st.VelY or 0) / 10)
		flap = dive and -28 or math.sin(c.FlapPhase) * 38
	end
	if X.DragonWingL and flap then
		X.DragonWingL.Transform = A(0, 0, -flap)
	end
	if X.DragonWingR and flap then
		X.DragonWingR.Transform = A(0, 0, flap)
	end

	-- State-dependent gear and body visibility.
	local hero, form = st.Hero, st.Form
	local mode = nil
	if hero == "Jake" and not form and st.Flying then
		mode = "Dragon"
	elseif character:GetAttribute("HideBody") then
		mode = "Ball"
	elseif hero == "Danny" and (st.Intangible or ((st.Dodge or 0) > 0 and not st.Flying)) then
		mode = "Ghost"
	elseif hero == "Danny" and st.Flying then
		mode = "Tail"
	end
	bodyVisibility(character, c, mode)
	for _, t in ipairs(c.Toggles) do
		local w = t.When
		local show = (w == "Always")
			or (w == "Flying" and st.Flying)
			or (w == "Gliding" and st.Gliding)
			or (w == "NotGliding" and not st.Gliding)
			or (w == "Scooter" and st.Scooter)
			or (w == "Jetpack" and st.Jetpack)
			or (w == "FlyingOrDodge" and (st.Flying or (st.Dodge or 0) > 0))
		setVisible(t.Part, show, t.Base)
	end
	-- Jake's dragon is the whole body in flight: bank and pitch it with the flight.
	if mode == "Dragon" and J.Root then
		J.Root.Transform = A(0, 0, -(st.FlyBank or 0)) * A((st.FlyPitch or 0) * 0.7 - 8, 0, 0)
	end
	-- Cannonbolt rolls.
	if c.Spinner and c.SpinBase then
		c.Roll = (c.Roll or 0) + (st.Speed or 0) * dt * 0.5
		c.Spinner.C0 = c.SpinBase * CFrame.Angles(-c.Roll, 0, 0)
	end
	-- Blink.
	if c.Face then
		c.Blink = c.Blink - dt
		local closed = c.Blink < 0.12
		if c.Blink < 0 then
			c.Blink = 2.5 + math.random() * 3
		end
		for _, name in ipairs({ "EyeL", "EyeR" }) do
			local eye = c.Face:FindFirstChild(name)
			if eye then
				local base = eye:GetAttribute("BaseY")
				if not base then
					base = eye.Size.Y.Scale
					eye:SetAttribute("BaseY", base)
				end
				eye.Size = UDim2.fromScale(eye.Size.X.Scale, closed and base * 0.12 or base)
			end
		end
	end
end

function Animator.init(controllers)
	Movement = controllers.Movement
end

function Animator.start()
	RunService.Stepped:Connect(function(time, dt)
		local now = os.clock()
		local serverNow = workspace:GetServerTimeNow()
		for _, p in ipairs(Players:GetPlayers()) do
			local character = p.Character
			if character and character.Parent then
				local c = cacheFor(character)
				if c and c.Root and c.Root.Parent then
					local ok, err = pcall(animate, character, c, dt, now, serverNow)
					if not ok then
						warn("[Animator] " .. tostring(err))
						rigs[character] = nil
					end
				end
			end
		end
		for character in pairs(rigs) do
			if not character.Parent then
				rigs[character] = nil
			end
		end
	end)
	-- Rebuild a rig's cache when its gear is rebuilt (hero or form change).
	workspace.DescendantAdded:Connect(function(d)
		if d.Name == "HeroGear" and d.Parent and rigs[d.Parent] then
			task.delay(0.2, function()
				local c = rigs[d.Parent]
				if c then
					c.Gear = nil
					c.BodyMode = "reset"
				end
			end)
		end
	end)
end

return Animator
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX18842"><Properties>
<string name="Name">CameraRig</string>
<ProtectedString name="Source"><![CDATA[--!nonstrict
-- Third-person camera like the prototype's: orbit with mouse (cursor locked),
-- touch drag or right stick; over-the-shoulder offset; pulls back and widens
-- the field of view at speed; screen shake; never clips into walls.

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local CameraRig = {}
local player = Players.LocalPlayer
local camera
local yaw, pitch = 0, -12
local dist = 14
local fov = 70
local shake = 0
local cursorFree = false
local touchId = nil
local Movement

function CameraRig.init(controllers)
	Movement = controllers.Movement
end

function CameraRig.shake(amount)
	shake = math.max(shake, amount)
end

-- Menus free the cursor; gameplay locks it to the centre for mouse-look.
-- A quick zoom kick for big hits (finishers, takedowns).
local punch = 0
function CameraRig.punch()
	punch = 1
end

function CameraRig.setCursorFree(free)
	cursorFree = free
end

function CameraRig.yaw()
	return yaw
end

function CameraRig.setYaw(deg)
	yaw = deg
end

function CameraRig.lookVector()
	return camera and camera.CFrame.LookVector or Vector3.new(0, 0, -1)
end

-- Point under the crosshair (for aiming), ignoring the local character.
function CameraRig.aimPoint()
	local cf = camera.CFrame
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = { player.Character }
	local hit = workspace:Raycast(cf.Position, cf.LookVector * 1000, params)
	local point = hit and hit.Position or cf.Position + cf.LookVector * 1000
	-- Ignore things between the camera and the hero.
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if root and hit and (hit.Position - cf.Position).Magnitude < (root.Position - cf.Position).Magnitude + 2 then
		point = cf.Position + cf.LookVector * 1000
	end
	return point
end

function CameraRig.start()
	camera = workspace.CurrentCamera
	camera.CameraType = Enum.CameraType.Scriptable

	UserInputService.InputChanged:Connect(function(input, processed)
		if input.UserInputType == Enum.UserInputType.MouseMovement and not cursorFree then
			yaw = yaw - input.Delta.X * 0.25
			pitch = math.clamp(pitch - input.Delta.Y * 0.25, -75, 65)
		elseif input.UserInputType == Enum.UserInputType.Touch and input == touchId then
			yaw = yaw - input.Delta.X * 0.35
			pitch = math.clamp(pitch - input.Delta.Y * 0.35, -75, 65)
		elseif input.KeyCode == Enum.KeyCode.Thumbstick2 then
			-- handled per frame below
		end
	end)
	UserInputService.TouchStarted:Connect(function(input, processed)
		-- Drags on the right half of the screen (not on buttons) orbit the camera.
		if not processed and not touchId and input.Position.X > camera.ViewportSize.X * 0.4 then
			touchId = input
		end
	end)
	UserInputService.TouchEnded:Connect(function(input)
		if input == touchId then
			touchId = nil
		end
	end)
	UserInputService.InputBegan:Connect(function(input)
		-- Esc may be taken by Roblox's menu, so M also frees / locks the mouse.
		if input.KeyCode == Enum.KeyCode.Escape or input.KeyCode == Enum.KeyCode.M then
			cursorFree = not cursorFree
		end
	end)

	RunService:BindToRenderStep("MultiverseCamera", Enum.RenderPriority.Camera.Value, function(dt)
		camera.CameraType = Enum.CameraType.Scriptable
		UserInputService.MouseBehavior = cursorFree and Enum.MouseBehavior.Default or Enum.MouseBehavior.LockCenter
		UserInputService.MouseIconEnabled = cursorFree
		for _, pad in ipairs(UserInputService:GetConnectedGamepads()) do
			for _, s in ipairs(UserInputService:GetGamepadState(pad)) do
				if s.KeyCode == Enum.KeyCode.Thumbstick2 and s.Position.Magnitude > 0.15 then
					yaw = yaw - s.Position.X * 180 * dt
					pitch = math.clamp(pitch + s.Position.Y * 120 * dt, -75, 65)
				end
			end
		end

		local character = player.Character
		local root = character and character:FindFirstChild("HumanoidRootPart")
		local humanoid = character and character:FindFirstChildOfClass("Humanoid")
		if not root or not humanoid then
			return
		end
		local seat = humanoid.SeatPart
		local scale = math.max(0.6, (humanoid.HipHeight + root.Size.Y * 0.5) / 3)
		local focusPart = seat and seat.Parent and seat.Parent.PrimaryPart or root
		local focus = focusPart.Position + Vector3.new(0, 1.6 * scale + (seat and 3 or 0), 0)
		local velocity = focusPart.AssemblyLinearVelocity
		local speed = velocity.Magnitude
		local state = Movement and Movement.state() or {}
		local fast = state.Flying or state.Gliding or seat ~= nil or character:GetAttribute("Form") == "XLR8"
		local want = 14 * math.pow(scale, 0.85)
		if seat then
			want = 30
		elseif fast then
			want = want + 4 + 5 * math.clamp(speed / 100, 0, 1)
		end
		dist = dist + (want - dist) * math.min(1, dt * 5)
		local fovWant = 70 + (fast and 18 * math.clamp((speed - 43) / 73, 0, 1) or 0) + (state.BoostFx or 0) * 25
		fov = fov + (fovWant - fov) * math.min(1, dt * 4)
		punch = math.max(0, punch - dt * 4)
		camera.FieldOfView = fov - punch * 12

		local rot = CFrame.Angles(0, math.rad(yaw), 0) * CFrame.Angles(math.rad(pitch), 0, 0)
		local shoulder = seat and 0 or 1.5 * math.sqrt(scale)
		local wantPos = focus + rot:VectorToWorldSpace(Vector3.new(shoulder, 0, dist))
		-- Keep out of walls.
		local params = RaycastParams.new()
		params.FilterType = Enum.RaycastFilterType.Exclude
		local ignore = { character, workspace:FindFirstChild("Enemies"), workspace:FindFirstChild("Shards") }
		if seat and seat.Parent then
			table.insert(ignore, seat.Parent)
		end
		params.FilterDescendantsInstances = ignore
		local offset = wantPos - focus
		if not state.Intangible then
			local hit = workspace:Raycast(focus, offset, params)
			if hit then
				wantPos = focus + offset.Unit * math.max(1, hit.Distance - 0.8)
			end
		end
		shake = math.max(0, shake - dt * 2.5)
		if shake > 0 then
			local a = shake * shake * 0.7
			wantPos = wantPos + Vector3.new((math.random() - 0.5) * a, (math.random() - 0.5) * a, (math.random() - 0.5) * a)
		end
		camera.CFrame = CFrame.new(wantPos) * rot
		camera.Focus = CFrame.new(focus)
	end)
end

return CameraRig
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX18843"><Properties>
<string name="Name">CombatAssist</string>
<ProtectedString name="Source"><![CDATA[--!nonstrict
-- Freeflow combat helpers on the client:
--  * soft targeting: the enemy nearest the crosshair is the attack target, and
--    melee attacks lunge to it (Movement reads CombatAssist.target());
--  * hard lock-on (Z / middle mouse / R3): the camera tracks the target;
--  * counter prompts: when an enemy winds up an attack on you, a "!" appears
--    over it and a COUNTER prompt flashes; press Counter (right click / X / R1)
--    in time to reverse it, or just to block;
--  * takedowns: at a high enough combo, T performs a special takedown.

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Debris = game:GetService("Debris")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))

local CombatAssist = {}
local player = Players.LocalPlayer
local Input, CameraRig, Movement, Hud
local current = nil   -- soft or hard target model
local locked = nil    -- hard-locked model
local reticle
local threats = {}    -- [model] = expiry time (enemies winding up on me)

local function alive(model)
	if not model or not model.Parent or not model.PrimaryPart then
		return false
	end
	local h = model:GetAttribute("Health")
	return h == nil or h > 0
end

local function enemies()
	local out = {}
	local folder = workspace:FindFirstChild("Enemies")
	if folder then
		for _, m in ipairs(folder:GetChildren()) do
			if m:IsA("Model") and m:GetAttribute("Enemy") and alive(m) then
				table.insert(out, m)
			end
		end
	end
	return out
end

local function pick()
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if not root then
		return nil
	end
	local look = CameraRig.lookVector()
	local best, bestScore = nil, math.huge
	for _, m in ipairs(enemies()) do
		local to = m.PrimaryPart.Position - root.Position
		local d = to.Magnitude
		if d < Config.Combat.LockRange then
			local flat = Vector3.new(to.X, 0, to.Z)
			local lookFlat = Vector3.new(look.X, 0, look.Z)
			local angle = (flat.Magnitude > 0.1 and lookFlat.Magnitude > 0.1) and math.acos(math.clamp(flat.Unit:Dot(lookFlat.Unit), -1, 1)) or 0
			-- Prefer what you're looking at, then what's close.
			local score = angle * 40 + d
			if angle < math.rad(70) and score < bestScore then
				best, bestScore = m, score
			end
		end
	end
	return best
end

function CombatAssist.target()
	if alive(locked) then
		return locked
	end
	if alive(current) then
		return current
	end
	return nil
end

function CombatAssist.isLocked()
	return alive(locked)
end

local function ensureReticle()
	if reticle then
		return reticle
	end
	reticle = Instance.new("BillboardGui")
	reticle.Name = "TargetReticle"
	reticle.Size = UDim2.fromOffset(46, 46)
	reticle.AlwaysOnTop = true
	local ring = Instance.new("Frame")
	ring.Size = UDim2.fromScale(1, 1)
	ring.BackgroundTransparency = 1
	local stroke = Instance.new("UIStroke")
	stroke.Thickness = 3
	stroke.Color = Color3.fromRGB(255, 230, 120)
	stroke.Parent = ring
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0.5, 0)
	corner.Parent = ring
	ring.Parent = reticle
	reticle.Parent = player:WaitForChild("PlayerGui")
	return reticle
end

-- "!" over an enemy that's about to strike.
local function showThreat(model, time, mine, label)
	if not model or not model.PrimaryPart then
		return
	end
	local gui = Instance.new("BillboardGui")
	gui.Size = UDim2.fromOffset(60, 60)
	gui.StudsOffset = Vector3.new(0, model.PrimaryPart.Size.Y * 0.7 + 2, 0)
	gui.AlwaysOnTop = true
	gui.Adornee = model.PrimaryPart
	local text = Instance.new("TextLabel")
	text.BackgroundTransparency = 1
	text.Size = UDim2.fromScale(1, 1)
	text.Font = Enum.Font.FredokaOne
	text.TextScaled = true
	text.Text = label and ("! " .. label) or "!"
	text.TextColor3 = mine and Color3.fromRGB(255, 70, 70) or Color3.fromRGB(255, 200, 80)
	text.TextStrokeTransparency = 0
	text.Parent = gui
	gui.Parent = player:WaitForChild("PlayerGui")
	Debris:AddItem(gui, time + 0.1)
	local h = Instance.new("Highlight")
	h.FillColor = Color3.fromRGB(255, 60, 60)
	h.FillTransparency = 0.55
	h.OutlineColor = Color3.fromRGB(255, 220, 220)
	h.Parent = model
	Debris:AddItem(h, time)
	if mine then
		threats[model] = os.clock() + time
	end
end

function CombatAssist.onTelegraph(fx)
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	local model = fx.Model
	local mine = fx.Target == player
	if not mine and root and model and model.PrimaryPart and (model.PrimaryPart.Position - root.Position).Magnitude < Config.Combat.CounterRange then
		mine = true
	end
	showThreat(model, fx.Time or 0.6, mine, fx.Label)
end

function CombatAssist.threatened()
	local now = os.clock()
	for m, t in pairs(threats) do
		if t < now or not m.Parent then
			threats[m] = nil
		end
	end
	return next(threats) ~= nil
end

function CombatAssist.takedownReady()
	local combo = player:GetAttribute("Combo") or 0
	local at = player:GetAttribute("ComboAt") or 0
	return combo >= Config.Combat.TakedownCombo and workspace:GetServerTimeNow() - at < Config.Combat.ComboTimeout
end

function CombatAssist.init(controllers)
	Input, CameraRig, Movement, Hud = controllers.Input, controllers.CameraRig, controllers.Movement, controllers.Hud
	Input.on("LockOn", function(down)
		if not down then
			return
		end
		if alive(locked) then
			locked = nil
		else
			locked = pick()
		end
	end)
	Input.on("Counter", function(down)
		if not down then
			return
		end
		local S = Movement.state()
		if CombatAssist.threatened() then
			S.CounterAnim = 0.3
			threats = {}
		else
			S.BlockAnim = Config.Combat.BlockTime
		end
		ReplicatedStorage.Remotes.Counter:FireServer()
	end)
	Input.on("Takedown", function(down)
		if down and CombatAssist.takedownReady() then
			Movement.state().TakedownAnim = 0.6
			ReplicatedStorage.Remotes.Takedown:FireServer()
		end
	end)
end

function CombatAssist.start()
	RunService.RenderStepped:Connect(function(dt)
		if locked and not alive(locked) then
			locked = nil
		end
		current = alive(locked) and locked or pick()
		local r = ensureReticle()
		r.Adornee = current and current.PrimaryPart or nil
		r.Enabled = current ~= nil
		local stroke = r:FindFirstChildOfClass("Frame"):FindFirstChildOfClass("UIStroke")
		stroke.Color = alive(locked) and Color3.fromRGB(255, 80, 80) or Color3.fromRGB(255, 230, 120)
		stroke.Transparency = alive(locked) and 0 or 0.4
		-- Hard lock: steer the camera toward the target.
		if alive(locked) then
			local character = player.Character
			local root = character and character:FindFirstChild("HumanoidRootPart")
			if root then
				local to = locked.PrimaryPart.Position - root.Position
				local want = math.deg(math.atan2(-to.X, -to.Z))
				local yaw = CameraRig.yaw()
				local d = (want - yaw + 540) % 360 - 180
				CameraRig.setYaw(yaw + d * math.min(1, dt * 8))
			end
		end
		if Hud then
			Hud.setPrompts(CombatAssist.threatened(), CombatAssist.takedownReady())
		end
	end)
end

return CombatAssist
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX18844"><Properties>
<string name="Name">Companions</string>
<ProtectedString name="Source"><![CDATA[--!nonstrict
-- Sidekicks drawn on every client: Cosmo & Wanda orbit any Timmy (and ride
-- below him as his cloud-board in flight), and Goddard trots after any Jimmy.

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local Companions = {}
local pals = {} -- [character] = { Models, Kind, Pos, Yaw }
local folder

local function ballPart(model, size, color, neon)
	local p = Instance.new("Part")
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CastShadow = false
	p.Size = size
	p.Color = color
	p.Material = neon and Enum.Material.Neon or Enum.Material.SmoothPlastic
	local mesh = Instance.new("SpecialMesh")
	mesh.MeshType = Enum.MeshType.Sphere
	mesh.Parent = p
	p.Parent = model
	return p
end

local function boxPart(model, size, color)
	local p = Instance.new("Part")
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.Size = size
	p.Color = color
	p.Material = Enum.Material.SmoothPlastic
	p.TopSurface = Enum.SurfaceType.Smooth
	p.Parent = model
	return p
end

-- A fairy: { part, offset } pairs posed relative to a centre each frame.
local function fairy(hair, shirt)
	local model = Instance.new("Model")
	model.Name = "Fairy"
	local pieces = {
		{ ballPart(model, Vector3.new(0.6, 0.6, 0.6), Color3.fromRGB(250, 215, 185)), CFrame.new(0, 0.2, 0) },
		{ ballPart(model, Vector3.new(0.8, 0.7, 0.8), hair), CFrame.new(0, 0.6, 0.05) },
		{ boxPart(model, Vector3.new(0.4, 0.55, 0.3), shirt), CFrame.new(0, -0.3, 0) },
		{ ballPart(model, Vector3.new(0.25, 0.25, 0.25), Color3.fromRGB(255, 220, 60), true), CFrame.new(0, 1.15, 0) },
		{ boxPart(model, Vector3.new(0.5, 0.35, 0.05), Color3.fromRGB(220, 240, 255)), CFrame.new(0.3, -0.05, 0.25), true },
		{ boxPart(model, Vector3.new(0.5, 0.35, 0.05), Color3.fromRGB(220, 240, 255)), CFrame.new(-0.3, -0.05, 0.25), true },
	}
	model.Parent = folder
	return { Model = model, Pieces = pieces }
end

local function goddard()
	local model = Instance.new("Model")
	model.Name = "Goddard"
	local grey, dark, red = Color3.fromRGB(210, 215, 225), Color3.fromRGB(70, 75, 90), Color3.fromRGB(255, 70, 70)
	local pieces = {
		{ boxPart(model, Vector3.new(1.4, 1.1, 2.2), grey), CFrame.new(0, 1.4, 0) },
		{ boxPart(model, Vector3.new(1.1, 1.0, 1.1), grey), CFrame.new(0, 2.3, -1.2) },
		{ boxPart(model, Vector3.new(0.8, 0.5, 0.6), dark), CFrame.new(0, 2.1, -1.9) },
		{ ballPart(model, Vector3.new(0.3, 0.3, 0.3), red, true), CFrame.new(0.3, 2.5, -1.75) },
		{ ballPart(model, Vector3.new(0.3, 0.3, 0.3), red, true), CFrame.new(-0.3, 2.5, -1.75) },
		{ boxPart(model, Vector3.new(0.2, 0.9, 0.5), dark), CFrame.new(0.5, 3.0, -1.1) },
		{ boxPart(model, Vector3.new(0.2, 0.9, 0.5), dark), CFrame.new(-0.5, 3.0, -1.1) },
		{ boxPart(model, Vector3.new(0.12, 0.8, 0.12), dark), CFrame.new(0, 2.0, 1.2) * CFrame.Angles(-0.6, 0, 0) },
	}
	for _, x in ipairs({ -0.45, 0.45 }) do
		for _, z in ipairs({ -0.7, 0.7 }) do
			table.insert(pieces, { boxPart(model, Vector3.new(0.3, 0.9, 0.3), dark), CFrame.new(x, 0.45, z), "leg" })
		end
	end
	model.Parent = folder
	return { Model = model, Pieces = pieces }
end

local function pose(rig, center, extra)
	for _, piece in ipairs(rig.Pieces) do
		local cf = center * piece[2]
		if extra then
			cf = extra(piece, cf) or cf
		end
		piece[1].CFrame = cf
	end
end

function Companions.start()
	folder = Instance.new("Folder")
	folder.Name = "Companions"
	folder.Parent = workspace
	RunService.RenderStepped:Connect(function(dt)
		local t = os.clock()
		local seen = {}
		for _, p in ipairs(Players:GetPlayers()) do
			local character = p.Character
			local root = character and character:FindFirstChild("HumanoidRootPart")
			local hero = character and character:GetAttribute("Hero")
			local form = character and character:GetAttribute("Form")
			local kind = (hero == "Timmy" and "Fairies") or (hero == "Jimmy" and "Goddard") or nil
			if form then
				kind = nil
			end
			if root and kind then
				seen[character] = true
				local entry = pals[character]
				if entry and entry.Kind ~= kind then
					for _, m in ipairs(entry.Rigs) do
						m.Model:Destroy()
					end
					entry = nil
				end
				if not entry then
					if kind == "Fairies" then
						entry = { Kind = kind, Rigs = { fairy(Color3.fromRGB(90, 210, 100), Color3.fromRGB(245, 245, 250)), fairy(Color3.fromRGB(245, 120, 185), Color3.fromRGB(250, 220, 80)) } }
					else
						entry = { Kind = kind, Rigs = { goddard() }, Pos = root.Position, Yaw = 0 }
					end
					pals[character] = entry
				end
				if kind == "Fairies" then
					local flying = character:GetAttribute("MvFlying")
					for i, rig in ipairs(entry.Rigs) do
						local center
						if flying then
							center = root.CFrame * CFrame.new(i == 1 and -0.8 or 0.8, -3.4, 0)
						else
							local a = t * 2 + (i - 1) * math.pi
							center = CFrame.new(root.Position + Vector3.new(math.cos(a) * 3, 2.2 + math.sin(t * 4 + i) * 0.3, math.sin(a) * 3)) * CFrame.Angles(0, -a, 0)
						end
						local flap = math.sin(t * 30) * 0.5
						pose(rig, center, function(piece, cf)
							if piece[3] then
								return cf * CFrame.Angles(0, piece[2].X > 0 and flap or -flap, 0)
							end
						end)
					end
				else
					-- Goddard follows a few studs behind and to the side.
					local want = root.Position + root.CFrame:VectorToWorldSpace(Vector3.new(4, 0, 4))
					local params = RaycastParams.new()
					params.FilterType = Enum.RaycastFilterType.Exclude
					params.FilterDescendantsInstances = { character, folder }
					local ground = workspace:Raycast(want + Vector3.new(0, 6, 0), Vector3.new(0, -40, 0), params)
					if ground then
						want = ground.Position
					else
						want = want - Vector3.new(0, 3, 0)
					end
					local to = want - entry.Pos
					local speed = math.min(to.Magnitude * 4, 60)
					if to.Magnitude > 0.2 then
						entry.Pos = entry.Pos + to.Unit * math.min(to.Magnitude, speed * dt)
						entry.Yaw = math.atan2(-to.X, -to.Z)
					end
					if to.Magnitude > 120 then
						entry.Pos = want
					end
					local trot = math.sin(t * 14) * math.clamp(speed / 20, 0, 1)
					pose(entry.Rigs[1], CFrame.new(entry.Pos) * CFrame.Angles(0, entry.Yaw, 0), function(piece, cf)
						if piece[3] == "leg" then
							local s = (piece[2].X > 0) == (piece[2].Z > 0) and 1 or -1
							return cf * CFrame.Angles(trot * 0.6 * s, 0, 0)
						end
					end)
				end
			end
		end
		for character, entry in pairs(pals) do
			if not seen[character] then
				for _, m in ipairs(entry.Rigs) do
					m.Model:Destroy()
				end
				pals[character] = nil
			end
		end
	end)
end

return Companions
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX18845"><Properties>
<string name="Name">Effects</string>
<ProtectedString name="Source"><![CDATA[--!nonstrict
-- Client-side visuals for server events (Remotes "Fx"): particle bursts,
-- projectiles, melee slashes, shockwaves, hit flashes, Jake's fire breath,
-- Danny's wail, collected shards, the next course gate. Also flight trails,
-- speed lines, sonic booms, ground-pound rings, and the marker that points to
-- the nearest rift shard.

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local Debris = game:GetService("Debris")

local Effects = {}
local player = Players.LocalPlayer
local Hud, CameraRig, Movement, CombatAssist
local fxFolder
local shots = {}        -- [id] = { Part, Vel, Life }
local takenShards = {}  -- [id] = true
local breath = {}       -- [player] = emitter
local trails = {}       -- [character] = emitter

local function part(props)
	local p = Instance.new("Part")
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = false
	p.Material = Enum.Material.Neon
	for k, v in pairs(props) do
		p[k] = v
	end
	p.Parent = fxFolder
	return p
end

function Effects.burst(pos, color, count, gravity)
	if not pos then
		return
	end
	local holder = part({ Transparency = 1, Size = Vector3.new(0.2, 0.2, 0.2), CFrame = CFrame.new(pos) })
	local e = Instance.new("ParticleEmitter")
	e.Color = ColorSequence.new(color or Color3.new(1, 1, 1))
	e.LightEmission = 0.8
	e.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.6), NumberSequenceKeypoint.new(1, 0) })
	e.Speed = NumberRange.new(8, 26)
	e.SpreadAngle = Vector2.new(180, 180)
	e.Lifetime = NumberRange.new(0.3, 0.8)
	e.Acceleration = gravity and Vector3.new(0, -60, 0) or Vector3.zero
	e.Rate = 0
	e.Parent = holder
	e:Emit(count or 20)
	Debris:AddItem(holder, 1.5)
end

-- An expanding flat ring (shockwaves, landings, sonic booms).
function Effects.ring(pos, normal, radius, time, color)
	local disc = part({ Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.3, 1, 1), Color = color or Color3.new(1, 1, 1), Transparency = 0.2 })
	local up = (normal or Vector3.new(0, 1, 0)).Unit
	disc.CFrame = CFrame.lookAt(pos, pos + up) * CFrame.Angles(0, math.pi / 2, 0)
	TweenService:Create(disc, TweenInfo.new(time or 0.5, Enum.EasingStyle.Quad), { Size = Vector3.new(0.3, radius * 2, radius * 2), Transparency = 1 }):Play()
	Debris:AddItem(disc, (time or 0.5) + 0.1)
end

local function slash(pos, dir, color, finisher)
	local count = finisher and 10 or 6
	local base = CFrame.lookAt(pos, pos + dir)
	for i = 1, count do
		local a = math.rad(-70 + 140 * (i - 1) / (count - 1))
		local p = part({ Size = Vector3.new(0.4, 0.4, finisher and 2.4 or 1.6), Color = color, Transparency = 0.1 })
		p.CFrame = base * CFrame.Angles(0, a, 0) * CFrame.new(0, 0, -2)
		TweenService:Create(p, TweenInfo.new(0.25), { Transparency = 1, Size = p.Size * Vector3.new(0.2, 0.2, 1.5) }):Play()
		Debris:AddItem(p, 0.3)
	end
end

local function flash(model)
	if not model or not model.Parent then
		return
	end
	local h = Instance.new("Highlight")
	h.FillColor = Color3.new(1, 1, 1)
	h.FillTransparency = 0.1
	h.OutlineTransparency = 1
	h.Parent = model
	Debris:AddItem(h, 0.12)
end

local function setBreath(who, on)
	local character = who and who.Character
	local existing = breath[who]
	if existing then
		existing:Destroy()
		breath[who] = nil
	end
	if not on or not character then
		return
	end
	local head = character:FindFirstChild("Head")
	if not head then
		return
	end
	local att = Instance.new("Attachment")
	att.Name = "BreathFx"
	att.Position = Vector3.new(0, 0, -1)
	att.Parent = head
	local e = Instance.new("ParticleEmitter")
	e.Color = ColorSequence.new(Color3.fromRGB(255, 220, 60), Color3.fromRGB(255, 90, 20))
	e.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.8), NumberSequenceKeypoint.new(1, 3) })
	e.Transparency = NumberSequence.new(0, 1)
	e.LightEmission = 1
	e.Speed = NumberRange.new(40, 55)
	e.SpreadAngle = Vector2.new(14, 14)
	e.Lifetime = NumberRange.new(0.4, 0.6)
	e.Rate = 120
	e.EmissionDirection = Enum.NormalId.Front
	e.Parent = att
	breath[who] = att
end

local function onFx(fx)
	if type(fx) ~= "table" then
		return
	end
	local kind = fx.Kind
	if kind == "Burst" then
		Effects.burst(fx.Pos, fx.Color, fx.Count, fx.Gravity)
	elseif kind == "Shot" then
		local p = part({ Shape = Enum.PartType.Ball, Size = Vector3.new(1, 1, 1) * math.max(0.6, fx.Radius * 1.6), Color = fx.Color, CFrame = CFrame.new(fx.Pos) })
		local light = Instance.new("PointLight")
		light.Color = fx.Color
		light.Range = 8
		light.Parent = p
		shots[fx.Id] = { Part = p, Vel = fx.Vel, Life = fx.Life }
	elseif kind == "ShotEnd" then
		local s = shots[fx.Id]
		if s then
			s.Part:Destroy()
			shots[fx.Id] = nil
		end
		Effects.burst(fx.Pos, Color3.new(1, 1, 1), 6)
	elseif kind == "Slash" then
		slash(fx.Pos, fx.Dir, fx.Color, fx.Finisher)
		if fx.Finisher then
			Effects.ring(fx.Pos - Vector3.new(0, 2, 0), Vector3.new(0, 1, 0), 10, 0.35, fx.Color)
		end
		if fx.Player == player and (fx.Hits or 0) > 0 then
			CameraRig.shake(fx.Finisher and 0.45 or 0.2)
		end
	elseif kind == "Hit" then
		flash(fx.Model)
		Effects.burst(fx.Pos, Color3.new(1, 1, 1), 6)
		if fx.Attacker == player then
			Hud.addHit()
		end
	elseif kind == "Shockwave" then
		Effects.ring(fx.Pos, Vector3.new(0, 1, 0), fx.Radius, fx.Time, fx.Color)
		local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
		if root and (root.Position - fx.Pos).Magnitude < fx.Radius then
			CameraRig.shake(0.5)
		end
	elseif kind == "Shake" then
		local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
		if root and (root.Position - fx.Pos).Magnitude < 80 then
			CameraRig.shake(fx.Amount or 0.4)
		end
	elseif kind == "Breath" then
		setBreath(fx.Player, fx.On)
	elseif kind == "Wail" then
		local character = fx.Player and fx.Player.Character
		local head = character and character:FindFirstChild("Head")
		if head then
			for i = 1, 4 do
				task.delay(i * 0.06, function()
					Effects.ring(head.Position + fx.Dir * i * 4, fx.Dir, 3 + i * 3, 0.4, Color3.fromRGB(120, 255, 150))
				end)
			end
		end
	elseif kind == "ShardTaken" then
		takenShards[fx.Id] = true
		local shard = workspace:FindFirstChild("Shards") and workspace.Shards:FindFirstChild("RiftShard_" .. fx.Id)
		if shard then
			shard.Parent = nil -- hidden for this player only
		end
		if not fx.Silent then
			Effects.burst(fx.Pos, Color3.fromRGB(190, 130, 255), 30)
			Effects.ring(fx.Pos, Vector3.new(0, 1, 0), 8, 0.4, Color3.fromRGB(120, 230, 255))
		end
	elseif kind == "Telegraph" then
		if CombatAssist then
			CombatAssist.onTelegraph(fx)
		end
	elseif kind == "Stagger" then
		local model = fx.Model
		if model and model.Parent then
			local h = Instance.new("Highlight")
			h.FillColor = Color3.fromRGB(255, 220, 60)
			h.FillTransparency = 0.4
			h.OutlineColor = Color3.new(1, 1, 1)
			h.Parent = model
			Debris:AddItem(h, 2.5)
			local gui = Instance.new("BillboardGui")
			gui.Size = UDim2.fromOffset(160, 36)
			gui.StudsOffset = Vector3.new(0, (model.PrimaryPart and model.PrimaryPart.Size.Y or 3) * 0.7 + 2, 0)
			gui.AlwaysOnTop = true
			gui.Adornee = model.PrimaryPart
			local l = Instance.new("TextLabel")
			l.BackgroundTransparency = 1
			l.Size = UDim2.fromScale(1, 1)
			l.Font = Enum.Font.FredokaOne
			l.TextScaled = true
			l.Text = "STAGGERED - FINISH IT!"
			l.TextColor3 = Color3.fromRGB(255, 220, 60)
			l.TextStrokeTransparency = 0
			l.Parent = gui
			gui.Parent = player:WaitForChild("PlayerGui")
			Debris:AddItem(gui, 2.5)
		end
		Effects.ring(fx.Pos, Vector3.new(0, 1, 0), 9, 0.35, Color3.fromRGB(255, 220, 60))
	elseif kind == "Finisher" or kind == "Takedown" then
		Effects.burst(fx.Pos, Color3.fromRGB(255, 230, 120), 50, true)
		Effects.ring(fx.Pos, Vector3.new(0, 1, 0), 16, 0.45, Color3.new(1, 1, 1))
		if fx.Attacker == player or fx.Player == player then
			CameraRig.shake(0.9)
			if CameraRig.punch then
				CameraRig.punch()
			end
		end
	elseif kind == "Counter" then
		Effects.ring(fx.Pos, Vector3.new(0, 1, 0), 14, 0.3, Color3.fromRGB(120, 220, 255))
		Effects.burst(fx.Pos + Vector3.new(0, 2, 0), Color3.fromRGB(180, 240, 255), 20)
		if fx.Player == player then
			CameraRig.shake(0.4)
		end
	elseif kind == "Block" then
		local character = fx.Player and fx.Player.Character
		local root = character and character:FindFirstChild("HumanoidRootPart")
		if root then
			Effects.burst(root.Position + root.CFrame.LookVector * 2, Color3.fromRGB(255, 240, 200), 8)
		end
	elseif kind == "Deflect" then
		local d = fx.To - fx.From
		local p = part({ Size = Vector3.new(0.4, 0.4, d.Magnitude), Color = Color3.fromRGB(120, 220, 255), CFrame = CFrame.lookAt(fx.From + d / 2, fx.To) })
		TweenService:Create(p, TweenInfo.new(0.3), { Transparency = 1 }):Play()
		Debris:AddItem(p, 0.35)
	elseif kind == "Reward" then
		Hud.reward(fx.Xp, fx.Cash, fx.Reason)
	elseif kind == "Gate" then
		if Effects.lastGate and Effects.lastGate.Parent then
			for _, d in ipairs(Effects.lastGate:GetDescendants()) do
				if d:IsA("BasePart") then
					d.Color = Color3.fromRGB(120, 255, 210)
				end
			end
		end
		Effects.lastGate = fx.Gate
		if fx.Gate then
			for _, d in ipairs(fx.Gate:GetDescendants()) do
				if d:IsA("BasePart") then
					d.Color = Color3.fromRGB(255, 220, 60)
				end
			end
		end
		local text = fx.Next == 1 and (fx.Name .. (fx.Best and ("  best %.2fs"):format(fx.Best) or "")) or ("%s  gate %d/%d"):format(fx.Name, fx.Next, fx.Count)
		Hud.setCourse(text)
	end
end

-- Flight trails for everyone who's flying.
local function updateTrails()
	for _, p in ipairs(Players:GetPlayers()) do
		local character = p.Character
		local root = character and character:FindFirstChild("HumanoidRootPart")
		local flying = character and (character:GetAttribute("MvFlying") or (p == player and Movement.state().Flying))
		local hero = character and character:GetAttribute("Hero")
		local existing = character and trails[character]
		if root and flying and not existing and (hero == "Danny" or hero == "XJ9" or hero == "Timmy" or hero == "Jake") then
			local att = Instance.new("Attachment")
			att.Name = "FlightTrail"
			att.Parent = root
			local e = Instance.new("ParticleEmitter")
			local colors = {
				Danny = ColorSequence.new(Color3.fromRGB(120, 255, 170), Color3.fromRGB(240, 255, 250)),
				XJ9 = ColorSequence.new(Color3.fromRGB(255, 200, 70), Color3.fromRGB(200, 205, 215)),
				Timmy = ColorSequence.new(Color3.fromRGB(255, 230, 80), Color3.fromRGB(245, 140, 200)),
				Jake = ColorSequence.new(Color3.fromRGB(255, 150, 60), Color3.fromRGB(255, 240, 200)),
			}
			e.Color = colors[hero]
			e.LightEmission = 0.8
			e.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, hero == "XJ9" and 1.2 or 0.7), NumberSequenceKeypoint.new(1, 0) })
			e.Transparency = NumberSequence.new(0.1, 1)
			e.Lifetime = NumberRange.new(0.4, 0.7)
			e.Speed = NumberRange.new(0, 2)
			e.Rate = 60
			e.LockedToPart = false
			e.Parent = att
			trails[character] = att
		elseif existing and (not flying or not root) then
			existing:Destroy()
			trails[character] = nil
		end
	end
	for character, att in pairs(trails) do
		if not character.Parent then
			att:Destroy()
			trails[character] = nil
		end
	end
end

-- Marker on the nearest rift shard this player hasn't collected.
local marker
local function updateMarker()
	local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
	local folder = workspace:FindFirstChild("Shards")
	if not root or not folder then
		return
	end
	local best, bestDist = nil, 500
	for _, shard in ipairs(folder:GetChildren()) do
		local id = shard:GetAttribute("ShardId")
		if id and not takenShards[id] and shard.PrimaryPart then
			local d = (shard.PrimaryPart.Position - root.Position).Magnitude
			if d < bestDist then
				best, bestDist = shard, d
			end
		end
	end
	if not marker then
		marker = Instance.new("BillboardGui")
		marker.Size = UDim2.fromOffset(90, 40)
		marker.AlwaysOnTop = true
		marker.StudsOffset = Vector3.new(0, 3, 0)
		local l = Instance.new("TextLabel")
		l.Name = "Text"
		l.BackgroundTransparency = 1
		l.Size = UDim2.fromScale(1, 1)
		l.Font = Enum.Font.FredokaOne
		l.TextScaled = true
		l.TextColor3 = Color3.fromRGB(220, 200, 255)
		l.TextStrokeTransparency = 0.3
		l.Parent = marker
		marker.Parent = player:WaitForChild("PlayerGui")
	end
	marker.Adornee = best and best.PrimaryPart or nil
	marker.Enabled = best ~= nil
	if best then
		marker.Text.Text = ("◆ %d m"):format(bestDist * 0.3)
	end
end

function Effects.init(controllers)
	Hud, CameraRig, Movement, CombatAssist = controllers.Hud, controllers.CameraRig, controllers.Movement, controllers.CombatAssist
	Movement.onBoom = function(pos, dir)
		Effects.ring(pos, dir, 10, 0.45, Color3.fromRGB(235, 245, 255))
	end
	Movement.onPound = function(pos)
		Effects.ring(pos + Vector3.new(0, 0.5, 0), Vector3.new(0, 1, 0), 22, 0.4, Color3.fromRGB(215, 205, 185))
		Effects.burst(pos, Color3.fromRGB(200, 190, 170), 24, true)
	end
	Movement.onEmotePeak = function(pos, color)
		Effects.ring(pos, Vector3.new(0, 1, 0), 12, 0.5, color)
		Effects.burst(pos + Vector3.new(0, 2, 0), color, 24)
	end
end

function Effects.start()
	fxFolder = Instance.new("Folder")
	fxFolder.Name = "LocalFx"
	fxFolder.Parent = workspace
	ReplicatedStorage:WaitForChild("Remotes").Fx.OnClientEvent:Connect(onFx)
	Players.PlayerRemoving:Connect(function(p)
		setBreath(p, false)
	end)
	local accum = 0
	RunService.RenderStepped:Connect(function(dt)
		for id, s in pairs(shots) do
			s.Life = s.Life - dt
			if s.Life <= 0 then
				s.Part:Destroy()
				shots[id] = nil
			else
				s.Part.CFrame = s.Part.CFrame + s.Vel * dt
			end
		end
		-- Spin the shards locally.
		local folder = workspace:FindFirstChild("Shards")
		if folder then
			local spin = CFrame.Angles(0, dt * 2.2, 0)
			for _, shard in ipairs(folder:GetChildren()) do
				if shard:IsA("Model") and shard.PrimaryPart then
					shard:PivotTo(shard:GetPivot() * spin)
				end
			end
		end
		-- Speed lines for the local hero at high speed.
		local S = Movement.state()
		local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
		if root and (S.Flying or S.Gliding) then
			local v = root.AssemblyLinearVelocity
			if v.Magnitude > 63 and math.random() < 0.6 then
				local p = part({ Size = Vector3.new(0.08, 0.08, 4), Color = Color3.fromRGB(240, 248, 255), Transparency = 0.3 })
				local offset = Vector3.new(math.random(-9, 9), math.random(-7, 7), math.random(-9, 9))
				p.CFrame = CFrame.lookAt(root.Position + offset, root.Position + offset + v)
				TweenService:Create(p, TweenInfo.new(0.25), { Transparency = 1 }):Play()
				Debris:AddItem(p, 0.3)
			end
		end
		accum = accum + dt
		if accum > 0.25 then
			accum = 0
			updateTrails()
			updateMarker()
		end
	end)
end

return Effects
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX18846"><Properties>
<string name="Name">Hud</string>
<ProtectedString name="Source"><![CDATA[--!nonstrict
-- On-screen UI, built in code: hero card with health / energy / ultimate,
-- world info (shards, KOs, course), messages and banners, hit-combo counter,
-- crosshair, the dimensional-terminal hero menu, Ben's Omnitrix dial, and
-- the controls overlay (F1).

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local MapData = require(Shared:WaitForChild("MapData"))
local Rules = require(Shared:WaitForChild("Progression"))

local Hud = {}
local player = Players.LocalPlayer
local Input, CameraRig, Movement, Minimap
local gui, card, bars, info, msgFrame, banner, combo, menu, dial, help
local stats, stars, bossBar, missionPanel, prompts, skillsMenu, shopMenu, rewardFeed
local mission = nil
local dialIsOpen = false
local comboCount, comboTimer = 0, 0
local FONT = Enum.Font.FredokaOne

local function new(class, props, parent)
	local i = Instance.new(class)
	for k, v in pairs(props) do
		i[k] = v
	end
	i.Parent = parent
	return i
end

local function corner(parent, r)
	new("UICorner", { CornerRadius = UDim.new(r or 0.2, 0) }, parent)
end

local function label(parent, text, size, pos, color, xAlign)
	return new("TextLabel", {
		BackgroundTransparency = 1, Font = FONT, Text = text, TextColor3 = color or Color3.new(1, 1, 1),
		TextStrokeTransparency = 0.4, TextScaled = true, Size = size, Position = pos,
		TextXAlignment = xAlign or Enum.TextXAlignment.Left,
	}, parent)
end

local function bar(parent, y, color, title)
	local back = new("Frame", { BackgroundColor3 = Color3.fromRGB(20, 20, 30), BackgroundTransparency = 0.3, Size = UDim2.new(1, -90, 0, 14), Position = UDim2.new(0, 84, 0, y), BorderSizePixel = 0 }, parent)
	corner(back, 0.5)
	local fill = new("Frame", { BackgroundColor3 = color, Size = UDim2.fromScale(1, 1), BorderSizePixel = 0 }, back)
	corner(fill, 0.5)
	local text = label(back, title, UDim2.new(1, -8, 1, 0), UDim2.fromOffset(6, 0), Color3.new(1, 1, 1))
	text.ZIndex = 3
	return { Fill = fill, Text = text, Title = title }
end

local function setBar(b, frac, suffix)
	b.Fill.Size = UDim2.fromScale(math.clamp(frac, 0, 1), 1)
	b.Text.Text = b.Title .. (suffix or "")
end

function Hud.message(text, color, seconds)
	if not msgFrame or not text or text == "" then
		return
	end
	local l = label(msgFrame, text, UDim2.new(1, 0, 0, 26), UDim2.new(0, 0, 1, 0), color or Color3.new(1, 1, 1), Enum.TextXAlignment.Center)
	l.LayoutOrder = math.floor(os.clock() * 100)
	task.delay(seconds or 3.5, function()
		TweenService:Create(l, TweenInfo.new(0.4), { TextTransparency = 1, TextStrokeTransparency = 1 }):Play()
		task.wait(0.45)
		l:Destroy()
	end)
	local children = msgFrame:GetChildren()
	if #children > 7 then
		for _, c in ipairs(children) do
			if c:IsA("TextLabel") then
				c:Destroy()
				break
			end
		end
	end
end

function Hud.banner(text, color)
	banner.Text = text
	banner.TextColor3 = color or Color3.fromRGB(255, 230, 120)
	banner.TextTransparency = 0
	banner.TextStrokeTransparency = 0.2
	local stamp = os.clock()
	banner:SetAttribute("Stamp", stamp)
	task.delay(2.5, function()
		if banner:GetAttribute("Stamp") == stamp then
			TweenService:Create(banner, TweenInfo.new(0.5), { TextTransparency = 1, TextStrokeTransparency = 1 }):Play()
		end
	end)
end

function Hud.addHit()
	comboCount = comboCount + 1
	comboTimer = 2
end

function Hud.dialOpen()
	return dialIsOpen
end

function Hud.setDial(open)
	dialIsOpen = open
	dial.Visible = open
end

local function closeMenu()
	menu.Visible = false
	Input.setEnabled(true)
	CameraRig.setCursorFree(false)
end

local function openMenu(t)
	for _, c in ipairs(menu.Grid:GetChildren()) do
		if c:IsA("TextButton") then
			c:Destroy()
		end
	end
	menu.Title.Text = (t.Universe or "Dimensional") .. " Terminal - pick a hero (1-8)"
	for i, id in ipairs(Config.HeroOrder) do
		local h = Config.Heroes[id]
		local b = new("TextButton", {
			Name = id, LayoutOrder = i, BackgroundColor3 = h.Accent, AutoButtonColor = true, Text = "", BorderSizePixel = 0,
		}, menu.Grid)
		corner(b, 0.12)
		local stroke = new("UIStroke", { Thickness = id == t.Hero and 4 or 2, Color = id == t.Hero and Color3.new(1, 1, 1) or Color3.fromRGB(20, 20, 30) }, b)
		stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
		local portrait = new("Frame", { BackgroundColor3 = h.Look.Skin, Size = UDim2.fromScale(0.5, 0.5), Position = UDim2.fromScale(0.25, 0.08), SizeConstraint = Enum.SizeConstraint.RelativeYY, BorderSizePixel = 0 }, b)
		corner(portrait, 0.5)
		new("UIAspectRatioConstraint", {}, portrait)
		if h.Portrait then
			new("ImageLabel", { BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), Image = h.Portrait }, portrait)
		else
			label(portrait, id:sub(1, 1), UDim2.fromScale(1, 1), UDim2.new(), Color3.fromRGB(30, 30, 40), Enum.TextXAlignment.Center)
		end
		label(b, i .. "  " .. h.Name, UDim2.new(0.9, 0, 0.18, 0), UDim2.fromScale(0.05, 0.62), Color3.new(1, 1, 1), Enum.TextXAlignment.Center)
		label(b, h.Universe, UDim2.new(0.9, 0, 0.12, 0), UDim2.fromScale(0.05, 0.82), Color3.fromRGB(30, 30, 40), Enum.TextXAlignment.Center).TextStrokeTransparency = 1
		b.Activated:Connect(function()
			ReplicatedStorage.Remotes.SelectHero:FireServer(id)
			closeMenu()
		end)
	end
	menu.Travel.Visible = t.Travel ~= nil
	menu.Travel.Text = t.Travel and ("Travel to " .. (MapData.Levels[t.Travel] and MapData.Levels[t.Travel].Name or t.Travel) .. "  (T)") or ""
	menu:SetAttribute("Travel", t.Travel)
	menu.Visible = true
	Input.setEnabled(false)
	CameraRig.setCursorFree(true)
end

local function build()
	gui = new("ScreenGui", { Name = "MultiverseHud", ResetOnSpawn = false, IgnoreGuiInset = true, ZIndexBehavior = Enum.ZIndexBehavior.Sibling }, player:WaitForChild("PlayerGui"))
	local scale = new("UIScale", {}, gui)
	local function rescale()
		local vp = workspace.CurrentCamera.ViewportSize
		scale.Scale = math.clamp(vp.Y / 900, 0.6, 1.4)
	end
	rescale()
	workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(rescale)

	-- Hero card.
	card = new("Frame", { BackgroundColor3 = Color3.fromRGB(15, 15, 25), BackgroundTransparency = 0.35, Size = UDim2.fromOffset(330, 100), Position = UDim2.fromOffset(16, 16), BorderSizePixel = 0 }, gui)
	corner(card, 0.15)
	local portrait = new("Frame", { Name = "Portrait", Size = UDim2.fromOffset(68, 68), Position = UDim2.fromOffset(8, 16), BorderSizePixel = 0 }, card)
	corner(portrait, 0.5)
	new("UIStroke", { Thickness = 3, Color = Color3.new(1, 1, 1) }, portrait)
	local initial = label(portrait, "J", UDim2.fromScale(1, 1), UDim2.new(), Color3.fromRGB(30, 30, 40), Enum.TextXAlignment.Center)
	initial.Name = "Initial"
	local name = label(card, "Jimmy Neutron", UDim2.new(1, -90, 0, 24), UDim2.fromOffset(84, 6))
	name.Name = "HeroName"
	local trav = label(card, "", UDim2.new(1, -90, 0, 14), UDim2.fromOffset(84, 30), Color3.fromRGB(200, 200, 220))
	trav.Name = "Traversal"
	bars = {
		Health = bar(card, 48, Color3.fromRGB(235, 70, 70), "HP"),
		Energy = bar(card, 64, Color3.fromRGB(90, 220, 140), "ENERGY"),
		Meter = bar(card, 80, Color3.fromRGB(110, 120, 240), "ULTIMATE"),
	}

	-- World info.
	info = new("Frame", { BackgroundTransparency = 1, Size = UDim2.fromOffset(360, 120), Position = UDim2.new(1, -376, 0, 16) }, gui)
	new("UIListLayout", { HorizontalAlignment = Enum.HorizontalAlignment.Right, SortOrder = Enum.SortOrder.LayoutOrder }, info)
	for i, key in ipairs({ "Level", "Speed", "Shards", "Kills", "Course" }) do
		local l = label(info, "", UDim2.new(1, 0, 0, i == 1 and 26 or 18), UDim2.new(), i == 1 and Color3.new(1, 1, 1) or Color3.fromRGB(220, 220, 235), Enum.TextXAlignment.Right)
		l.Name = key
		l.LayoutOrder = i
	end

	-- Messages, banner, combo, crosshair.
	msgFrame = new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(0.6, 0, 0, 200), Position = UDim2.new(0.2, 0, 1, -330) }, gui)
	new("UIListLayout", { VerticalAlignment = Enum.VerticalAlignment.Bottom, SortOrder = Enum.SortOrder.LayoutOrder }, msgFrame)
	banner = label(gui, "", UDim2.new(0.8, 0, 0, 64), UDim2.new(0.1, 0, 0.18, 0), Color3.fromRGB(255, 230, 120), Enum.TextXAlignment.Center)
	banner.TextTransparency = 1
	banner.TextStrokeTransparency = 1
	combo = label(gui, "", UDim2.fromOffset(260, 40), UDim2.new(0.5, 140, 0.5, -120), Color3.fromRGB(255, 220, 90))
	local cross = new("Frame", { Size = UDim2.fromOffset(6, 6), Position = UDim2.new(0.5, -3, 0.5, -3), BackgroundColor3 = Color3.new(1, 1, 1), BorderSizePixel = 0 }, gui)
	corner(cross, 0.5)
	new("UIStroke", { Thickness = 1.5, Color = Color3.new(0, 0, 0) }, cross)

	-- Terminal menu.
	menu = new("Frame", { Name = "TerminalMenu", Visible = false, BackgroundColor3 = Color3.fromRGB(15, 15, 30), BackgroundTransparency = 0.15, Size = UDim2.fromOffset(820, 520), Position = UDim2.new(0.5, -410, 0.5, -260), BorderSizePixel = 0 }, gui)
	corner(menu, 0.05)
	local title = label(menu, "", UDim2.new(1, -40, 0, 36), UDim2.fromOffset(20, 12), Color3.fromRGB(255, 230, 120), Enum.TextXAlignment.Center)
	title.Name = "Title"
	local grid = new("Frame", { Name = "Grid", BackgroundTransparency = 1, Size = UDim2.new(1, -40, 0, 380), Position = UDim2.fromOffset(20, 56) }, menu)
	new("UIGridLayout", { CellSize = UDim2.fromOffset(180, 180), CellPadding = UDim2.fromOffset(12, 12), SortOrder = Enum.SortOrder.LayoutOrder, HorizontalAlignment = Enum.HorizontalAlignment.Center }, grid)
	local travel = new("TextButton", { Name = "Travel", BackgroundColor3 = Color3.fromRGB(255, 200, 80), Font = FONT, TextScaled = true, Size = UDim2.fromOffset(360, 36), Position = UDim2.new(0.5, -270, 1, -50), BorderSizePixel = 0 }, menu)
	corner(travel, 0.3)
	travel.Activated:Connect(function()
		local target = menu:GetAttribute("Travel")
		if target then
			ReplicatedStorage.Remotes.Travel:FireServer(target)
		end
		closeMenu()
	end)
	local close = new("TextButton", { Name = "Close", Text = "Close (Esc)", BackgroundColor3 = Color3.fromRGB(80, 80, 100), TextColor3 = Color3.new(1, 1, 1), Font = FONT, TextScaled = true, Size = UDim2.fromOffset(160, 36), Position = UDim2.new(0.5, 110, 1, -50), BorderSizePixel = 0 }, menu)
	corner(close, 0.3)
	close.Activated:Connect(closeMenu)

	-- Omnitrix dial.
	dial = new("Frame", { Name = "OmnitrixDial", Visible = false, BackgroundColor3 = Color3.fromRGB(10, 30, 10), BackgroundTransparency = 0.25, Size = UDim2.fromOffset(420, 420), Position = UDim2.new(0.5, -210, 0.5, -210), BorderSizePixel = 0 }, gui)
	corner(dial, 0.5)
	new("UIStroke", { Thickness = 4, Color = Color3.fromRGB(90, 255, 90) }, dial)
	for k = 1, 3 do
		local f = Config.Forms[k]
		local a = math.rad(-90 + (k - 1) * 120)
		local b = new("TextButton", { Text = k .. "\n" .. f.Id, Font = FONT, TextScaled = true, TextColor3 = Color3.new(1, 1, 1), BackgroundColor3 = f.Body, Size = UDim2.fromOffset(110, 110), Position = UDim2.new(0.5, math.cos(a) * 130 - 55, 0.5, math.sin(a) * 130 - 55), BorderSizePixel = 0 }, dial)
		corner(b, 0.5)
		b.Activated:Connect(function()
			ReplicatedStorage.Remotes.Omnitrix:FireServer("slot", k - 1)
			Hud.setDial(false)
		end)
	end
	label(dial, "OMNITRIX: 1/2/3 to transform, Q to cancel", UDim2.new(1, -60, 0, 24), UDim2.new(0, 30, 1, -40), Color3.fromRGB(200, 255, 200), Enum.TextXAlignment.Center)

	-- Controls overlay.
	help = new("Frame", { BackgroundColor3 = Color3.new(0, 0, 0), BackgroundTransparency = 0.4, Size = UDim2.fromOffset(840, 228), Position = UDim2.new(0.5, -420, 1, -430), BorderSizePixel = 0 }, gui)
	corner(help, 0.06)
	local lines = {
		"CONTROLS  (F1 to toggle)",
		"WASD move   Mouse look   Space jump / ascend (jump at walls to wall-jump)   Ctrl or C descend   Shift sprint / boost",
		"Click attack (3-hit combos)   Q signature   R Ghost Wail / Earth Pillar   F ultimate   Tab fly (flyers)",
		"V or Alt dodge / air dash / barrel roll   Ctrl in the air: ground pound   B emote   Hold Space falling: glide (Aang)",
		"E terminals (swap hero / travel) and Jimmy's hover car   P return to the Nexus   M (or Esc) free the mouse",
		"Ben: 1/2/3 transform, Q Omnitrix dial, G Master Control Glitch, F Way Big (full meter)",
		"Right click / X counter (on a red !)   T takedown (8+ combo)   Z lock-on   K skills   Shift: wall-run, climb, slide (+Ctrl)",
	}
	for i, text in ipairs(lines) do
		label(help, text, UDim2.new(1, -24, 0, 22), UDim2.fromOffset(12, 8 + (i - 1) * 30), i == 1 and Color3.fromRGB(255, 230, 120) or Color3.new(1, 1, 1))
	end
	task.delay(14, function()
		help.Visible = false
	end)
end

-- Cash, level, XP, wanted stars, boss bar, mission timer.
local function refreshExtras()
	local level = player:GetAttribute("Level") or 1
	local xp = player:GetAttribute("Xp") or 0
	local need = Rules.xpToNext(level, Config)
	stats.Level.Text = ("LV %d"):format(level)
	stats.Cash.Text = ("$%d"):format(player:GetAttribute("Cash") or 0)
	local points = player:GetAttribute("SkillPoints") or 0
	stats.Points.Text = points > 0 and ("%d skill point%s (K)"):format(points, points > 1 and "s" or "") or ""
	stats.XpFill.Size = UDim2.fromScale(math.clamp(xp / need, 0, 1), 1)
	local heat = player:GetAttribute("Heat") or 0
	local cooling = player:GetAttribute("HeatCooling")
	local n = math.floor(heat)
	local blink = cooling and (os.clock() % 0.6 < 0.3)
	for i, star in ipairs(stars) do
		star.TextColor3 = i <= n and Color3.fromRGB(255, 215, 60) or Color3.fromRGB(70, 70, 80)
		star.TextTransparency = (i <= n and blink) and 0.7 or (n > 0 and 0 or 1)
		star.TextStrokeTransparency = n > 0 and 0.3 or 1
	end
	local bossOn = workspace:GetAttribute("BossActive")
	bossBar.Visible = bossOn == true
	if bossOn then
		local hp, max = workspace:GetAttribute("BossHealth") or 0, workspace:GetAttribute("BossMax") or 1
		bossBar.Fill.Size = UDim2.fromScale(math.clamp(hp / max, 0, 1), 1)
		bossBar.Title.Text = (workspace:GetAttribute("BossName") or "Boss") .. ("  %d / %d"):format(hp, max)
	end
	if mission then
		local left = math.max(0, mission.Ends - workspace:GetServerTimeNow())
		missionPanel.Visible = true
		missionPanel.Title.Text = ("%s   %d:%02d"):format(mission.Name, math.floor(left / 60), math.floor(left % 60))
		missionPanel.Body.Text = mission.Text or ""
	else
		missionPanel.Visible = false
	end
end

function Hud.setPrompts(threat, takedown)
	if not prompts then
		return
	end
	prompts.Counter.Visible = threat
	prompts.Counter.TextTransparency = (os.clock() % 0.25 < 0.12) and 0 or 0.25
	prompts.Takedown.Visible = takedown
end

function Hud.reward(xp, cash, reason)
	if not rewardFeed then
		return
	end
	local parts = {}
	if xp and xp > 0 then
		table.insert(parts, "+" .. xp .. " XP")
	end
	if cash and cash > 0 then
		table.insert(parts, "+$" .. cash)
	end
	if #parts == 0 then
		return
	end
	local l = label(rewardFeed, table.concat(parts, "   ") .. (reason and ("  " .. reason) or ""), UDim2.new(1, 0, 0, 20), UDim2.new(), Color3.fromRGB(255, 225, 120), Enum.TextXAlignment.Right)
	l.LayoutOrder = math.floor(os.clock() * 100)
	task.delay(2.5, function()
		TweenService:Create(l, TweenInfo.new(0.4), { TextTransparency = 1, TextStrokeTransparency = 1 }):Play()
		task.wait(0.45)
		l:Destroy()
	end)
end

function Hud.setMission(m)
	mission = m
	if Minimap then
		Minimap.setWaypoint(m and m.Pos or nil)
	end
end

local function menuFrame(name, title, height)
	local f = new("Frame", { Name = name, Visible = false, BackgroundColor3 = Color3.fromRGB(15, 15, 30), BackgroundTransparency = 0.12, Size = UDim2.fromOffset(520, height), Position = UDim2.new(0.5, -260, 0.5, -height / 2), BorderSizePixel = 0 }, gui)
	corner(f, 0.05)
	label(f, title, UDim2.new(1, -40, 0, 34), UDim2.fromOffset(20, 10), Color3.fromRGB(255, 230, 120), Enum.TextXAlignment.Center)
	local list = new("Frame", { Name = "List", BackgroundTransparency = 1, Size = UDim2.new(1, -40, 1, -110), Position = UDim2.fromOffset(20, 52) }, f)
	new("UIListLayout", { Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder }, list)
	local close = new("TextButton", { Text = "Close", BackgroundColor3 = Color3.fromRGB(80, 80, 100), TextColor3 = Color3.new(1, 1, 1), Font = FONT, TextScaled = true, Size = UDim2.fromOffset(140, 32), Position = UDim2.new(0.5, -70, 1, -44), BorderSizePixel = 0 }, f)
	corner(close, 0.3)
	close.Activated:Connect(function()
		f.Visible = false
		Input.setEnabled(true)
		CameraRig.setCursorFree(false)
	end)
	return f
end

local function row(list, order, text, button, onClick)
	local r = new("Frame", { BackgroundColor3 = Color3.fromRGB(40, 40, 60), BackgroundTransparency = 0.2, Size = UDim2.new(1, 0, 0, 44), LayoutOrder = order, BorderSizePixel = 0 }, list)
	corner(r, 0.2)
	label(r, text, UDim2.new(1, -150, 1, -8), UDim2.fromOffset(10, 4))
	local b = new("TextButton", { Text = button, Font = FONT, TextScaled = true, BackgroundColor3 = Color3.fromRGB(255, 200, 80), Size = UDim2.fromOffset(120, 32), Position = UDim2.new(1, -128, 0, 6), BorderSizePixel = 0 }, r)
	corner(b, 0.3)
	b.Activated:Connect(onClick)
	return r
end

local function openSkills()
	for _, c in ipairs(skillsMenu.List:GetChildren()) do
		if c:IsA("Frame") then
			c:Destroy()
		end
	end
	local points = player:GetAttribute("SkillPoints") or 0
	skillsMenu:FindFirstChildOfClass("TextLabel").Text = ("SKILLS  -  %d point%s to spend"):format(points, points == 1 and "" or "s")
	for i, id in ipairs(Config.SkillOrder) do
		local def = Config.Skills[id]
		local rank = player:GetAttribute("Skill_" .. id) or 0
		row(skillsMenu.List, i, ("%s  %d/%d\n%s"):format(def.Name, rank, def.Max, def.Desc), rank >= def.Max and "MAX" or "+1", function()
			ReplicatedStorage.Remotes.Skill:FireServer(id)
			task.delay(0.3, openSkills)
		end)
	end
	skillsMenu.Visible = true
	Input.setEnabled(false)
	CameraRig.setCursorFree(true)
end

local function openShop(prices)
	for _, c in ipairs(shopMenu.List:GetChildren()) do
		if c:IsA("Frame") then
			c:Destroy()
		end
	end
	for i, item in ipairs(Config.Shop) do
		local price = prices and prices[item.Id] or item.Price
		row(shopMenu.List, i, ("%s  -  $%d\n%s"):format(item.Name, price, item.Desc), "Buy", function()
			ReplicatedStorage.Remotes.Shop:FireServer(item.Id)
		end)
	end
	shopMenu.Visible = true
	Input.setEnabled(false)
	CameraRig.setCursorFree(true)
end

local function buildExtras()
	-- Level / XP / cash under the hero card.
	stats = new("Frame", { BackgroundColor3 = Color3.fromRGB(15, 15, 25), BackgroundTransparency = 0.35, Size = UDim2.fromOffset(330, 46), Position = UDim2.fromOffset(16, 122), BorderSizePixel = 0 }, gui)
	corner(stats, 0.2)
	local lv = label(stats, "LV 1", UDim2.fromOffset(70, 24), UDim2.fromOffset(10, 4), Color3.fromRGB(255, 230, 120))
	lv.Name = "Level"
	local cash = label(stats, "$0", UDim2.fromOffset(110, 24), UDim2.fromOffset(84, 4), Color3.fromRGB(140, 255, 160))
	cash.Name = "Cash"
	local pts = label(stats, "", UDim2.fromOffset(140, 18), UDim2.fromOffset(184, 7), Color3.fromRGB(255, 200, 90))
	pts.Name = "Points"
	local xpBack = new("Frame", { BackgroundColor3 = Color3.fromRGB(30, 30, 45), Size = UDim2.new(1, -20, 0, 8), Position = UDim2.fromOffset(10, 32), BorderSizePixel = 0 }, stats)
	corner(xpBack, 0.5)
	stats.XpFill = new("Frame", { BackgroundColor3 = Color3.fromRGB(255, 210, 80), Size = UDim2.fromScale(0, 1), BorderSizePixel = 0 }, xpBack)
	corner(stats.XpFill, 0.5)
	-- Wanted stars, top centre.
	local starRow = new("Frame", { BackgroundTransparency = 1, Size = UDim2.fromOffset(200, 34), Position = UDim2.new(0.5, -100, 0, 12) }, gui)
	new("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, HorizontalAlignment = Enum.HorizontalAlignment.Center }, starRow)
	stars = {}
	for i = 1, Config.Heat.Max do
		local s = label(starRow, "★", UDim2.fromOffset(34, 34), UDim2.new(), Color3.fromRGB(70, 70, 80), Enum.TextXAlignment.Center)
		s.LayoutOrder = i
		stars[i] = s
	end
	-- Boss bar.
	bossBar = new("Frame", { Visible = false, BackgroundColor3 = Color3.fromRGB(20, 10, 30), BackgroundTransparency = 0.2, Size = UDim2.new(0.5, 0, 0, 22), Position = UDim2.new(0.25, 0, 0, 56), BorderSizePixel = 0 }, gui)
	corner(bossBar, 0.4)
	bossBar.Fill = new("Frame", { BackgroundColor3 = Color3.fromRGB(230, 60, 180), Size = UDim2.fromScale(1, 1), BorderSizePixel = 0 }, bossBar)
	corner(bossBar.Fill, 0.4)
	bossBar.Title = label(bossBar, "", UDim2.new(1, -10, 1, 0), UDim2.fromOffset(5, 0), Color3.new(1, 1, 1), Enum.TextXAlignment.Center)
	bossBar.Title.ZIndex = 3
	-- Mission panel.
	missionPanel = new("Frame", { Visible = false, BackgroundColor3 = Color3.fromRGB(15, 15, 25), BackgroundTransparency = 0.3, Size = UDim2.fromOffset(330, 62), Position = UDim2.fromOffset(16, 176), BorderSizePixel = 0 }, gui)
	corner(missionPanel, 0.15)
	missionPanel.Title = label(missionPanel, "", UDim2.new(1, -16, 0, 26), UDim2.fromOffset(8, 4), Color3.fromRGB(255, 220, 90))
	missionPanel.Body = label(missionPanel, "", UDim2.new(1, -16, 0, 22), UDim2.fromOffset(8, 34), Color3.new(1, 1, 1))
	-- Combat prompts.
	prompts = {}
	prompts.Counter = label(gui, "COUNTER! (Right click / X)", UDim2.fromOffset(360, 40), UDim2.new(0.5, -180, 0.5, 60), Color3.fromRGB(255, 80, 80), Enum.TextXAlignment.Center)
	prompts.Counter.Visible = false
	prompts.Takedown = label(gui, "TAKEDOWN READY (T)", UDim2.fromOffset(300, 30), UDim2.new(0.5, -150, 0.5, 104), Color3.fromRGB(255, 220, 90), Enum.TextXAlignment.Center)
	prompts.Takedown.Visible = false
	-- Reward feed (right side, under world info).
	rewardFeed = new("Frame", { BackgroundTransparency = 1, Size = UDim2.fromOffset(320, 140), Position = UDim2.new(1, -336, 0, 140) }, gui)
	new("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder, HorizontalAlignment = Enum.HorizontalAlignment.Right }, rewardFeed)
	skillsMenu = menuFrame("SkillsMenu", "SKILLS", 420)
	shopMenu = menuFrame("ShopMenu", "GEAR LOCKER", 300)
end

local function refresh(dt)
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if not humanoid then
		return
	end
	local heroId = character:GetAttribute("Hero") or "Jimmy"
	local h = Config.Heroes[heroId] or Config.Heroes.Jimmy
	local form = character:GetAttribute("Form")
	card.HeroName.Text = form and ("Ben as " .. form) or h.Name
	card.Traversal.Text = h.Universe .. "  |  " .. h.Traversal
	card.Portrait.BackgroundColor3 = h.Accent
	card.Portrait.Initial.Text = heroId:sub(1, 1)
	setBar(bars.Health, humanoid.Health / humanoid.MaxHealth, ("  %d"):format(humanoid.Health))
	local S = Movement.state()
	setBar(bars.Energy, S.Energy / Movement.maxEnergy())
	local meter = character:GetAttribute("Meter") or 0
	setBar(bars.Meter, meter / 100, meter >= 100 and "  READY (F)" or ("  %d%%"):format(meter))
	if heroId == "Ben" then
		local state = character:GetAttribute("Omnitrix") or "Human"
		local t = character:GetAttribute("AlienTime") or 0
		card.Traversal.Text = "Omnitrix: " .. state .. ((state == "Alien" and t > 0) and ("  " .. t .. "s") or "")
	end

	local levelName = player:GetAttribute("Level") or Config.Levels.Nexus
	local level = MapData.Levels[levelName]
	info.Level.Text = level and level.Name or levelName
	local root = character:FindFirstChild("HumanoidRootPart")
	local speed = root and root.AssemblyLinearVelocity.Magnitude or 0
	info.Speed.Text = ("%d km/h"):format(speed * 0.3 * 3.6)
	info.Shards.Text = ("Rift shards: %d/%d"):format(player:GetAttribute("Shards_" .. levelName) or 0, workspace:GetAttribute("ShardTotal_" .. levelName) or 0)
	info.Kills.Text = ("KOs: %d"):format(player:GetAttribute("Kills") or 0)

	local c = player:GetAttribute("Combo") or 0
	local age = workspace:GetServerTimeNow() - (player:GetAttribute("ComboAt") or 0)
	local fade = math.clamp((Config.Combat.ComboTimeout - age) / 0.5, 0, 1)
	combo.Text = (c >= 2 and fade > 0) and (c .. " HIT COMBO!") or ""
	combo.TextTransparency = 1 - fade
	refreshExtras()
end

function Hud.setCourse(text)
	if info then
		info.Course.Text = text or ""
	end
end

function Hud.init(controllers)
	Input, CameraRig, Movement, Minimap = controllers.Input, controllers.CameraRig, controllers.Movement, controllers.Minimap
	build()
	buildExtras()
	Input.on("Skills", function(down)
		if down then
			if skillsMenu.Visible then
				skillsMenu.Visible = false
				Input.setEnabled(true)
				CameraRig.setCursorFree(false)
			else
				openSkills()
			end
		end
	end)
	Input.on("Help", function(down)
		if down then
			help.Visible = not help.Visible
		end
	end)
end

function Hud.start()
	local remotes = ReplicatedStorage:WaitForChild("Remotes")
	remotes.Notify.OnClientEvent:Connect(function(n)
		if type(n) ~= "table" then
			return
		end
		if n.Banner then
			Hud.banner(n.Banner, n.Color)
		end
		if n.Text then
			Hud.message(n.Text, n.Color, n.Time)
		end
	end)
	remotes.OpenTerminal.OnClientEvent:Connect(openMenu)
	remotes.OpenShop.OnClientEvent:Connect(function(info)
		if type(info) ~= "table" then
			return
		end
		if info.Skills then
			openSkills()
		else
			openShop(info.Prices)
		end
	end)
	remotes.Objective.OnClientEvent:Connect(function(o)
		if type(o) ~= "table" or o.Clear then
			Hud.setMission(nil)
		else
			Hud.setMission(o)
		end
	end)
	UserInputService.InputBegan:Connect(function(input)
		if not menu.Visible then
			return
		end
		if input.KeyCode == Enum.KeyCode.Escape then
			closeMenu()
		elseif input.KeyCode == Enum.KeyCode.T and menu:GetAttribute("Travel") then
			remotes.Travel:FireServer(menu:GetAttribute("Travel"))
			closeMenu()
		else
			local numbers = { Enum.KeyCode.One, Enum.KeyCode.Two, Enum.KeyCode.Three, Enum.KeyCode.Four, Enum.KeyCode.Five, Enum.KeyCode.Six, Enum.KeyCode.Seven, Enum.KeyCode.Eight }
			for i, key in ipairs(numbers) do
				if input.KeyCode == key then
					remotes.SelectHero:FireServer(Config.HeroOrder[i])
					closeMenu()
				end
			end
		end
	end)
	RunService.RenderStepped:Connect(refresh)
	Hud.message("Welcome to the Nexus Observatory! Walk up to a terminal and press E to pick a hero.", Color3.fromRGB(255, 230, 120), 8)
end

return Hud
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX18847"><Properties>
<string name="Name">Input</string>
<ProtectedString name="Source"><![CDATA[--!nonstrict
-- Every game action and its bindings (keyboard, mouse, gamepad, and on-screen
-- touch buttons via ContextActionService). Controllers ask Input.held(name)
-- or subscribe with Input.on(name, fn(isDown)).

local ContextActionService = game:GetService("ContextActionService")
local UserInputService = game:GetService("UserInputService")
local Players = game:GetService("Players")

local Input = {}
local held = {}
local listeners = {}
local enabled = true

-- name = { keys..., touch title or nil }
local ACTIONS = {
	Attack = { { Enum.UserInputType.MouseButton1, Enum.KeyCode.ButtonR2 }, "Attack" },
	Sig = { { Enum.KeyCode.Q, Enum.KeyCode.ButtonX }, "Ability" },
	Sig2 = { { Enum.KeyCode.R, Enum.KeyCode.ButtonL1 }, "Ability 2" },
	Ult = { { Enum.KeyCode.F, Enum.KeyCode.ButtonY }, "Ultimate" },
	Fly = { { Enum.KeyCode.Tab, Enum.KeyCode.DPadUp }, "Fly" },
	Dodge = { { Enum.KeyCode.V, Enum.KeyCode.LeftAlt, Enum.KeyCode.ButtonB }, "Dodge" },
	Emote = { { Enum.KeyCode.B, Enum.KeyCode.DPadRight }, nil },
	Down = { { Enum.KeyCode.LeftControl, Enum.KeyCode.C, Enum.KeyCode.ButtonL2 }, "Down" },
	Boost = { { Enum.KeyCode.LeftShift, Enum.KeyCode.ButtonL3 }, nil },
	Omni1 = { { Enum.KeyCode.One }, nil },
	Omni2 = { { Enum.KeyCode.Two }, nil },
	Omni3 = { { Enum.KeyCode.Three }, nil },
	Glitch = { { Enum.KeyCode.G }, nil },
	Recall = { { Enum.KeyCode.P, Enum.KeyCode.DPadDown }, nil },
	Help = { { Enum.KeyCode.F1 }, nil },
	Counter = { { Enum.UserInputType.MouseButton2, Enum.KeyCode.X, Enum.KeyCode.ButtonR1 }, "Counter" },
	Takedown = { { Enum.KeyCode.T, Enum.KeyCode.DPadLeft }, "Takedown" },
	LockOn = { { Enum.KeyCode.Z, Enum.UserInputType.MouseButton3, Enum.KeyCode.ButtonR3 }, nil },
	Skills = { { Enum.KeyCode.K, Enum.KeyCode.ButtonSelect }, nil },
}

local function emit(name, down)
	local list = listeners[name]
	if list then
		for _, fn in ipairs(list) do
			task.spawn(fn, down)
		end
	end
end

local function handler(name, state)
	if state == Enum.UserInputState.Begin then
		if not enabled then
			return Enum.ContextActionResult.Pass
		end
		held[name] = true
		emit(name, true)
	elseif state == Enum.UserInputState.End or state == Enum.UserInputState.Cancel then
		if held[name] then
			held[name] = false
			emit(name, false)
		end
	end
	-- Mouse clicks still reach GUI buttons; keys are ours.
	return Enum.ContextActionResult.Pass
end

function Input.init()
	for name, spec in pairs(ACTIONS) do
		local keys = spec[1]
		ContextActionService:BindAction("MT_" .. name, function(_, state)
			return handler(name, state)
		end, spec[2] ~= nil, table.unpack(keys))
		if spec[2] then
			ContextActionService:SetTitle("MT_" .. name, spec[2])
		end
	end
	-- Lay out the touch buttons in an arc above the jump button.
	if UserInputService.TouchEnabled then
		local spots = {
			Attack = { 0.62, 0.48 }, Sig = { 0.72, 0.36 }, Sig2 = { 0.84, 0.30 }, Ult = { 0.52, 0.62 }, Fly = { 0.52, 0.30 },
			Dodge = { 0.62, 0.20 }, Down = { 0.40, 0.55 }, Counter = { 0.74, 0.62 }, Takedown = { 0.40, 0.25 },
		}
		for name, p in pairs(spots) do
			ContextActionService:SetPosition("MT_" .. name, UDim2.new(p[1], 0, p[2], 0))
		end
	end
end

function Input.on(name, fn)
	listeners[name] = listeners[name] or {}
	table.insert(listeners[name], fn)
end

function Input.held(name)
	return held[name] == true
end

-- Jump is the humanoid's own control (Space / A / touch jump button).
function Input.jumpHeld()
	if UserInputService:IsKeyDown(Enum.KeyCode.Space) or UserInputService:IsGamepadButtonDown(Enum.UserInputType.Gamepad1, Enum.KeyCode.ButtonA) then
		return true
	end
	local character = Players.LocalPlayer.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	return humanoid ~= nil and humanoid.Jump
end

-- Menus switch gameplay actions off so their keys don't also act.
function Input.setEnabled(on)
	enabled = on
	if not on then
		for name in pairs(held) do
			held[name] = false
		end
	end
end

-- Movement stick / WASD in camera space: x = right, y = forward.
local controlModule
function Input.move()
	if not controlModule then
		local ok, module = pcall(function()
			return require(Players.LocalPlayer:WaitForChild("PlayerScripts"):WaitForChild("PlayerModule")):GetControls()
		end)
		if ok then
			controlModule = module
		end
	end
	if controlModule then
		local v = controlModule:GetMoveVector()
		return Vector2.new(v.X, -v.Z)
	end
	return Vector2.zero
end

return Input
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX18848"><Properties>
<string name="Name">Minimap</string>
<ProtectedString name="Source"><![CDATA[--!nonstrict
-- Rotating radar in the corner, open-world style: roads, and blips for
-- mission markers, rifts, terminals, shops, uncollected shards, enemies,
-- other players, cars, the boss, and your current objective waypoint (with an
-- arrow on the rim when it's off the map).

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local MapData = require(Shared:WaitForChild("MapData"))

local Minimap = {}
local player = Players.LocalPlayer
local CameraRig, Effects
local SIZE = 220
local RANGE = 260 -- studs from centre to rim
local canvas, mapLayer, blipLayer, arrow
local roadFrames = {}
local pool = {}
local used = 0
local waypoint = nil

local function frame(parent, props)
	local f = Instance.new("Frame")
	f.BorderSizePixel = 0
	for k, v in pairs(props) do
		f[k] = v
	end
	f.Parent = parent
	return f
end

local function build()
	local gui = Instance.new("ScreenGui")
	gui.Name = "Minimap"
	gui.ResetOnSpawn = false
	gui.IgnoreGuiInset = true
	gui.Parent = player:WaitForChild("PlayerGui")
	canvas = Instance.new("CanvasGroup")
	canvas.Name = "Radar"
	canvas.Size = UDim2.fromOffset(SIZE, SIZE)
	canvas.AnchorPoint = Vector2.new(1, 1)
	canvas.Position = UDim2.new(1, -16, 1, -16)
	canvas.BackgroundColor3 = Color3.fromRGB(30, 60, 40)
	canvas.BackgroundTransparency = 0.15
	canvas.Parent = gui
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0.5, 0)
	corner.Parent = canvas
	mapLayer = frame(canvas, { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1 })
	blipLayer = frame(canvas, { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, ZIndex = 3 })
	for _, road in ipairs(MapData.Roads or {}) do
		local f = frame(mapLayer, { BackgroundColor3 = Color3.fromRGB(70, 70, 82), AnchorPoint = Vector2.new(0.5, 0.5), ZIndex = 2 })
		table.insert(roadFrames, { Frame = f, Road = road })
	end
	-- Player arrow (always centre, pointing up = camera forward).
	local me = frame(canvas, { Size = UDim2.fromOffset(12, 12), AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), BackgroundColor3 = Color3.new(1, 1, 1), ZIndex = 5, Rotation = 45 })
	local s = Instance.new("UIStroke")
	s.Thickness = 2
	s.Parent = me
	local ring = Instance.new("UIStroke")
	ring.Thickness = 3
	ring.Color = Color3.fromRGB(240, 240, 250)
	ring.Parent = canvas
	-- Rim arrow toward an off-map waypoint.
	arrow = Instance.new("TextLabel")
	arrow.BackgroundTransparency = 1
	arrow.Size = UDim2.fromOffset(22, 22)
	arrow.AnchorPoint = Vector2.new(0.5, 0.5)
	arrow.Font = Enum.Font.FredokaOne
	arrow.Text = "▲"
	arrow.TextScaled = true
	arrow.TextColor3 = Color3.fromRGB(255, 220, 60)
	arrow.TextStrokeTransparency = 0
	arrow.ZIndex = 6
	arrow.Parent = canvas
	local north = Instance.new("TextLabel")
	north.Name = "North"
	north.BackgroundTransparency = 1
	north.Size = UDim2.fromOffset(18, 18)
	north.AnchorPoint = Vector2.new(0.5, 0.5)
	north.Font = Enum.Font.FredokaOne
	north.Text = "N"
	north.TextScaled = true
	north.TextColor3 = Color3.new(1, 1, 1)
	north.TextStrokeTransparency = 0
	north.ZIndex = 6
	north.Parent = canvas
end

local function blip(color, size, round)
	used = used + 1
	local f = pool[used]
	if not f then
		f = frame(blipLayer, { AnchorPoint = Vector2.new(0.5, 0.5), ZIndex = 4 })
		local c = Instance.new("UICorner")
		c.CornerRadius = UDim.new(0.5, 0)
		c.Parent = f
		pool[used] = f
	end
	f.Visible = true
	f.BackgroundColor3 = color
	f.Size = UDim2.fromOffset(size, size)
	f.UICorner.CornerRadius = UDim.new(round and 0.5 or 0.15, 0)
	return f
end

-- World position -> radar offset in pixels (camera forward is up).
local function project(origin, yawRad, pos)
	local rel = pos - origin
	local c, s = math.cos(yawRad), math.sin(yawRad)
	-- Rotate into camera space: x right, y forward.
	local x = rel.X * c - rel.Z * s
	local z = rel.X * s + rel.Z * c
	local scale = (SIZE * 0.5) / RANGE
	return x * scale, z * scale
end

local function place(f, x, y, clampToRim)
	local r = SIZE * 0.5 - 8
	local d = math.sqrt(x * x + y * y)
	if d > r then
		if not clampToRim then
			f.Visible = false
			return false
		end
		x, y = x / d * r, y / d * r
	end
	f.Position = UDim2.new(0.5, x, 0.5, y)
	return true
end

function Minimap.setWaypoint(pos)
	waypoint = pos
end

local function update()
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if not root then
		return
	end
	local origin = root.Position
	local yawRad = math.rad(CameraRig.yaw())
	used = 0
	-- Roads (Retroville only).
	local inRetro = (player:GetAttribute("Level") or "") == Config.Levels.Retroville
	local scale = (SIZE * 0.5) / RANGE
	for _, r in ipairs(roadFrames) do
		if inRetro then
			local x, y = project(origin, yawRad, r.Road.C)
			local len, wid = r.Road.L * scale, math.max(3, r.Road.W * scale)
			r.Frame.Visible = true
			r.Frame.Size = r.Road.Axis == "X" and UDim2.fromOffset(len, wid) or UDim2.fromOffset(wid, len)
			r.Frame.Position = UDim2.new(0.5, x, 0.5, y)
			r.Frame.Rotation = math.deg(yawRad)
		else
			r.Frame.Visible = false
		end
	end
	local function add(pos, color, size, round, rim)
		local f = blip(color, size, round)
		local x, y = project(origin, yawRad, pos)
		place(f, x, y, rim)
	end
	local interact = workspace:FindFirstChild("Interactables")
	if interact then
		for _, p in ipairs(interact:GetChildren()) do
			if p:IsA("BasePart") then
				if p:GetAttribute("Mission") then
					add(p.Position, Color3.fromRGB(255, 210, 60), 12, false, true)
				elseif p.Name:find("Terminal") or p.Name:find("Service") then
					add(p.Position, Color3.fromRGB(120, 220, 255), 8, false, false)
				end
			end
		end
	end
	local enemies = workspace:FindFirstChild("Enemies")
	if enemies then
		for _, m in ipairs(enemies:GetChildren()) do
			if m:IsA("Model") and m.PrimaryPart then
				if m:GetAttribute("Enemy") == "Boss" then
					add(m.PrimaryPart.Position, Color3.fromRGB(255, 60, 200), 16, true, true)
				elseif m:GetAttribute("Enemy") then
					add(m.PrimaryPart.Position, Color3.fromRGB(255, 70, 70), 6, true, false)
				elseif m.Name == "Rift" then
					local core = m:FindFirstChild("Core")
					if core then
						add(core.Position, Color3.fromRGB(190, 90, 255), 12, true, true)
					end
				end
			end
		end
	end
	local shards = workspace:FindFirstChild("Shards")
	if shards then
		for _, m in ipairs(shards:GetChildren()) do
			if m:IsA("Model") and m.PrimaryPart then
				add(m.PrimaryPart.Position, Color3.fromRGB(200, 160, 255), 5, true, false)
			end
		end
	end
	local vehicles = workspace:FindFirstChild("Vehicles")
	if vehicles then
		for _, m in ipairs(vehicles:GetChildren()) do
			if m.PrimaryPart then
				add(m.PrimaryPart.Position, Color3.fromRGB(235, 235, 240), 6, false, false)
			end
		end
	end
	for _, other in ipairs(Players:GetPlayers()) do
		local r = other ~= player and other.Character and other.Character:FindFirstChild("HumanoidRootPart")
		if r then
			add(r.Position, Color3.fromRGB(80, 160, 255), 8, true, true)
		end
	end
	-- Objective waypoint: blip, or an arrow on the rim.
	arrow.Visible = false
	if waypoint then
		local x, y = project(origin, yawRad, waypoint)
		local d = math.sqrt(x * x + y * y)
		local r = SIZE * 0.5 - 10
		if d > r then
			arrow.Visible = true
			arrow.Position = UDim2.new(0.5, x / d * r, 0.5, y / d * r)
			arrow.Rotation = math.deg(math.atan2(x, -y))
		else
			add(waypoint, Color3.fromRGB(120, 255, 120), 12, true, true)
		end
	end
	-- North marker on the rim (world -Z is north).
	local nx, ny = project(origin, yawRad, origin + Vector3.new(0, 0, -RANGE * 2))
	local nd = math.sqrt(nx * nx + ny * ny)
	canvas.North.Position = UDim2.new(0.5, nx / nd * (SIZE * 0.5 - 12), 0.5, ny / nd * (SIZE * 0.5 - 12))
	for i = used + 1, #pool do
		pool[i].Visible = false
	end
end

function Minimap.init(controllers)
	CameraRig, Effects = controllers.CameraRig, controllers.Effects
end

function Minimap.start()
	build()
	local accum = 0
	RunService.RenderStepped:Connect(function(dt)
		accum = accum + dt
		if accum < 1 / 30 then
			return
		end
		accum = 0
		update()
	end)
end

return Minimap
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX18849"><Properties>
<string name="Name">Movement</string>
<ProtectedString name="Source"><![CDATA[--!nonstrict
-- The local hero's movement, ported from the prototype (Prototype/src/Game.cpp):
-- momentum flight with per-hero handling, banking, boost and barrel rolls;
-- Aang's glider (dive for speed, climb to slow, stall); dodge roll / air dash;
-- ground pound; double jumps with flips; wall jumps and El Tigre's wall cling;
-- coyote time and short hops; Jimmy's jetpack; El Tigre's grappling chain;
-- Danny's intangibility; Aang's air scooter and earth-pillar launch; emotes.
--
-- The client owns its character's physics on Roblox, so this drives the
-- HumanoidRootPart with a LinearVelocity + AlignOrientation pair when the
-- normal Humanoid walking isn't in charge. The server only hears intent and a
-- compact state report (Remotes "State") used for animation and immunity.

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Rules = require(Shared:WaitForChild("Progression"))

local Movement = {}
local player = Players.LocalPlayer
local Input, CameraRig, Hud, CombatAssist
local remotes

local S = {} -- local movement state (also read by Animator, CameraRig, Hud)
local mover -- { Att, Lin, Align }
local lastSent = {}
local sendClock = 0

local function reset()
	S = {
		Flying = false, Gliding = false, Pounding = false, PoundLand = 0, Dodge = 0, DodgeAir = false, DodgeSide = 1,
		DodgeDir = Vector3.new(0, 0, -1), DodgeCd = 0, AirDashUsed = false, AirJumpsLeft = 0, FlipTime = 0,
		WallSlide = 0, WallTimer = 0, WallNormal = Vector3.zero, EmoteTime = 0, IdleTime = 0, LandTimer = 0,
		Boosting = false, WasBoosting = false, BoostFx = 0, FlyBank = 0, FlyPitch = 0, TakeoffTime = 0, FlyVel = Vector3.zero,
		GlideSpeed = 0, Energy = Config.Player.MaxEnergy, Jetpack = 0, Scooter = 0, Grapple = nil, Intangible = false,
		WalkPhase = 0, Coyote = 0, Jumped = false, JumpCut = false, Grounded = true, WasGrounded = true,
		AttackAnim = 0, AttackDur = 0.25, AttackStep = 0, LastAttack = -10, AttackCd = 0, SigCd = 0, Sig2Cd = 0,
		Breath = false, LastSafe = nil, FaceYaw = nil,
		-- Parkour / combat additions.
		Lunge = nil, Swing = nil, WallRun = nil, Climb = false, ClimbTime = 0, MantleCd = 0, Slide = 0, SlideDir = Vector3.zero,
		SlideSpeed = 0, CounterAnim = 0, BlockAnim = 0, TakedownAnim = 0,
	}
end
reset()

function Movement.state()
	return S
end

local function charParts()
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if humanoid and root and humanoid.Health > 0 then
		return character, humanoid, root
	end
	return nil
end

local function heroId()
	local character = player.Character
	return character and character:GetAttribute("Hero") or "Jimmy"
end

local function hero()
	return Config.Heroes[heroId()] or Config.Heroes.Jimmy
end

local function formId()
	local character = player.Character
	return character and character:GetAttribute("Form")
end

local function formDef()
	local id = formId()
	if not id then
		return nil
	end
	for _, f in ipairs(Config.Forms) do
		if f.Id == id then
			return f
		end
	end
	return nil
end

local function scale()
	local _, humanoid, root = charParts()
	if not humanoid then
		return 1
	end
	return math.max(0.5, (humanoid.HipHeight + root.Size.Y * 0.5) / 3)
end

-- Skill bonuses (ranks replicate as player attributes).
local function skills()
	local ranks = {}
	for _, name in ipairs(Config.SkillOrder) do
		ranks[name] = player:GetAttribute("Skill_" .. name) or 0
	end
	return Rules.effects(ranks)
end

function Movement.maxEnergy()
	return Config.Player.MaxEnergy + skills().Energy
end

local function ensureMover(root)
	if mover and mover.Att.Parent == root then
		return mover
	end
	local att = Instance.new("Attachment")
	att.Name = "MoveAttachment"
	att.Parent = root
	local lin = Instance.new("LinearVelocity")
	lin.Name = "MoveVelocity"
	lin.Attachment0 = att
	lin.RelativeTo = Enum.ActuatorRelativeTo.World
	lin.MaxForce = 0
	lin.Parent = root
	local align = Instance.new("AlignOrientation")
	align.Name = "MoveOrientation"
	align.Mode = Enum.OrientationAlignmentMode.OneAttachment
	align.Attachment0 = att
	align.MaxTorque = 0
	align.Responsiveness = 30
	align.Parent = root
	mover = { Att = att, Lin = lin, Align = align }
	return mover
end

-- mode: nil (humanoid walks), "Vector" (full velocity), "Plane" (horizontal only).
local function drive(root, mode, velocity, faceYaw)
	local m = ensureMover(root)
	if not mode then
		m.Lin.MaxForce = 0
		m.Align.MaxTorque = 0
		return
	end
	local mass = root.AssemblyMass
	if mode == "Plane" then
		m.Lin.VelocityConstraintMode = Enum.VelocityConstraintMode.Plane
		m.Lin.PrimaryTangentAxis = Vector3.new(1, 0, 0)
		m.Lin.SecondaryTangentAxis = Vector3.new(0, 0, 1)
		m.Lin.PlaneVelocity = Vector2.new(velocity.X, velocity.Z)
	else
		m.Lin.VelocityConstraintMode = Enum.VelocityConstraintMode.Vector
		m.Lin.VectorVelocity = velocity
	end
	m.Lin.MaxForce = mass * 4000
	if faceYaw then
		m.Align.CFrame = CFrame.Angles(0, math.rad(faceYaw), 0)
		m.Align.MaxTorque = mass * 5000
	else
		m.Align.MaxTorque = 0
	end
end

local function yawOf(v)
	return math.deg(math.atan2(-v.X, -v.Z))
end

local function angleDelta(from, to)
	return (to - from + 540) % 360 - 180
end

local function approach(cur, target, step)
	local d = target - cur
	if math.abs(d) <= step then
		return target
	end
	return cur + (d > 0 and step or -step)
end

-- Turns unit vector `from` toward unit vector `to` by at most maxRad.
local function rotateToward(from, to, maxRad)
	local c = math.clamp(from:Dot(to), -1, 1)
	local angle = math.acos(c)
	if angle <= maxRad or angle < 1e-4 then
		return to
	end
	local axis = from:Cross(to)
	if axis.Magnitude < 1e-4 then
		axis = from:Cross(Vector3.new(0, 1, 0))
	end
	if axis.Magnitude < 1e-4 then
		axis = Vector3.new(1, 0, 0)
	end
	local perp = axis.Unit:Cross(from).Unit
	return (from * math.cos(maxRad) + perp * math.sin(maxRad)).Unit
end

local function fire(name, ...)
	local r = remotes and remotes:FindFirstChild(name)
	if r then
		r:FireServer(...)
	end
end

local function say(text, color)
	if Hud then
		Hud.message(text, color)
	end
end

local function groundBelow(root, humanoid, extra)
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = { player.Character }
	local reach = humanoid.HipHeight + root.Size.Y * 0.5 + (extra or 0.6)
	return workspace:Raycast(root.Position, Vector3.new(0, -reach, 0), params)
end

-- Abilities --------------------------------------------------------------------------

local function startFlight(root, humanoid)
	S.Flying = true
	S.Gliding = false
	S.Pounding = false
	S.EmoteTime = 0
	S.TakeoffTime = 0.45
	local v = root.AssemblyLinearVelocity
	S.FlyVel = Vector3.new(v.X, math.max(v.Y, S.Grounded and 32 or 10), v.Z)
	humanoid.AutoRotate = false
	humanoid:ChangeState(Enum.HumanoidStateType.Freefall)
end

local function stopFlight(humanoid)
	S.Flying = false
	S.Boosting = false
	humanoid.AutoRotate = true
end

local function toggleIntangible(root)
	local _, humanoid = charParts()
	if not S.Intangible then
		if S.Energy < 15 then
			say("Not enough ecto energy", Color3.fromRGB(120, 255, 150))
			return
		end
		S.Intangible = true
		if not S.Flying then
			startFlight(root, humanoid)
		end
		say("Going ghost... intangible!", Color3.fromRGB(120, 255, 150))
	else
		S.WantSolid = true
	end
end

local function insideGeometry(root)
	local params = OverlapParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = { player.Character, workspace:FindFirstChild("Shards"), workspace:FindFirstChild("Enemies") }
	local parts = workspace:GetPartBoundsInBox(root.CFrame, root.Size * Vector3.new(1, 2.4, 1), params)
	for _, p in ipairs(parts) do
		if p.CanCollide then
			return true
		end
	end
	return false
end

local function aimDir(root)
	local target = CameraRig.aimPoint()
	local chest = root.Position + Vector3.new(0, 0.8 * scale(), 0)
	local d = target - chest
	if d.Magnitude < 0.01 then
		return CameraRig.lookVector()
	end
	return d.Unit
end

local function attackDef()
	local f = formDef()
	if f then
		return f.Attack
	end
	return hero().Attack
end

local function tryAttack()
	local character, humanoid, root = charParts()
	if not character or S.Intangible or humanoid.SeatPart then
		return
	end
	local a = attackDef()
	if not a or S.AttackCd > 0 then
		return
	end
	local now = os.clock()
	local combo = a.Cooldown >= 0.2
	if combo and now - S.LastAttack < a.Cooldown + Config.Moves.ComboWindow then
		S.AttackStep = (S.AttackStep + 1) % 3
	else
		S.AttackStep = 0
	end
	S.LastAttack = now
	local fin = combo and S.AttackStep == 2
	S.AttackDur = fin and 0.38 or 0.25
	S.AttackAnim = S.AttackDur
	S.AttackCd = a.Cooldown + (fin and 0.15 or 0)
	S.EmoteTime = 0
	local dir = aimDir(root)
	-- Aim at the soft/hard target; melee attacks lunge across the gap to it.
	local target = CombatAssist and CombatAssist.target()
	if target and target.PrimaryPart then
		local tp = target.PrimaryPart.Position
		local to = tp - root.Position
		dir = to.Unit
		local gap = to.Magnitude - target.PrimaryPart.Size.Y * 0.5
		if a.Kind == "Melee" and not S.Flying and gap > 4 and gap < Config.Combat.LungeRange then
			S.Lunge = { Model = target, Time = 0.4 }
		end
	end
	S.FaceYaw = yawOf(Vector3.new(dir.X, 0, dir.Z))
	S.FaceTime = S.AttackDur
	if a.Kind == "Melee" and S.Grounded and not S.Flying and not S.Lunge then
		local flat = Vector3.new(dir.X, 0, dir.Z)
		if flat.Magnitude > 0.01 then
			root.AssemblyLinearVelocity = root.AssemblyLinearVelocity + flat.Unit * (fin and 17 or 10)
		end
	end
	fire("Attack", dir)
end

local function onSig(down)
	local character, humanoid, root = charParts()
	if not character then
		return
	end
	local id, f = heroId(), formId()
	if id == "Ben" then
		if down then
			if Hud and Hud.dialOpen() then
				fire("Omnitrix", "cancel")
				Hud.setDial(false)
			else
				fire("Omnitrix", "dial")
				Hud.setDial(true)
			end
		end
		return
	end
	if f then
		return
	end
	if id == "ElTigre" then
		if down then
			local cam = workspace.CurrentCamera.CFrame
			local params = RaycastParams.new()
			params.FilterType = Enum.RaycastFilterType.Exclude
			params.FilterDescendantsInstances = { character, workspace:FindFirstChild("Shards") }
			local hit = workspace:Raycast(cam.Position, cam.LookVector * 230, params)
			if hit and (hit.Position - root.Position).Magnitude > 7 then
				if not S.Grounded and hit.Position.Y > root.Position.Y + 6 then
					Movement.startSwing(root, hit.Position)
				else
					S.Grapple = hit.Position
					local v = root.AssemblyLinearVelocity
					root.AssemblyLinearVelocity = Vector3.new(v.X, math.max(v.Y, 13), v.Z)
				end
			else
				say("Nothing to grapple in range", Color3.fromRGB(255, 200, 120))
			end
		else
			if (S.Grapple or S.Swing) and not S.Grounded then
				S.FlipTime = 0.5
			end
			if S.Swing then
				Movement.endSwing(root, true)
			end
			S.Grapple = nil
		end
		return
	end
	if id == "Jake" then
		S.Breath = down
		fire("Ability", "Breath", aimDir(root), down)
		return
	end
	if not down then
		return
	end
	if id == "Jimmy" then
		if S.SigCd <= 0 and S.Energy >= 25 then
			S.Energy = S.Energy - 25
			S.SigCd = 0.6
			S.Jetpack = 0.8
			local v = root.AssemblyLinearVelocity
			root.AssemblyLinearVelocity = Vector3.new(v.X, 45, v.Z)
		end
	elseif id == "Danny" then
		toggleIntangible(root)
	elseif id == "Aang" then
		if S.SigCd <= 0 then
			S.SigCd = 1
			S.Scooter = 5
			say("Air Scooter!", Color3.fromRGB(200, 230, 255))
		end
	else
		fire("Ability", "Sig", aimDir(root))
	end
end

local function onSig2(down)
	if not down then
		return
	end
	local character, _, root = charParts()
	if not character or formId() then
		return
	end
	local id = heroId()
	if id == "Aang" then
		if S.Sig2Cd <= 0 and S.Grounded then
			S.Sig2Cd = 2
			fire("Ability", "Sig2", aimDir(root))
			task.delay(0.08, function()
				if root.Parent then
					local v = root.AssemblyLinearVelocity
					root.AssemblyLinearVelocity = Vector3.new(v.X, 57, v.Z)
				end
			end)
		end
	elseif id == "Danny" then
		fire("Ability", "Sig2", aimDir(root))
	end
end

local function onUlt(down)
	if not down then
		return
	end
	local character, _, root = charParts()
	if not character then
		return
	end
	if heroId() == "Ben" then
		fire("Omnitrix", "overclock")
	elseif (character:GetAttribute("Meter") or 0) >= 100 then
		fire("Ability", "Ult", aimDir(root))
	else
		say("Ultimate meter not full yet (fight to charge it)", Color3.fromRGB(200, 200, 255))
	end
end

local function onFly(down)
	if not down then
		return
	end
	local character, humanoid, root = charParts()
	if not character or humanoid.SeatPart then
		return
	end
	if not hero().CanFly or formId() then
		return
	end
	if S.Flying then
		if S.Intangible then
			say("Turn solid first (Q) to land", Color3.fromRGB(200, 255, 200))
			return
		end
		stopFlight(humanoid)
	else
		startFlight(root, humanoid)
	end
end

local function onDodge(down)
	if not down then
		return
	end
	local character, humanoid, root = charParts()
	if not character or humanoid.SeatPart or S.DodgeCd > 0 or S.Grapple then
		return
	end
	local f = formId()
	if f == "Cannonbolt" or f == "WayBig" then
		return
	end
	local cam = workspace.CurrentCamera.CFrame
	local fwd = Vector3.new(cam.LookVector.X, 0, cam.LookVector.Z).Unit
	local right = Vector3.new(cam.RightVector.X, 0, cam.RightVector.Z).Unit
	local mv = Input.move()
	if S.Flying then
		-- Barrel roll: a quick sidestep with a full roll.
		S.DodgeSide = mv.X < -0.1 and -1 or 1
		S.FlyVel = S.FlyVel + right * S.DodgeSide * 53
		S.Dodge = Config.Moves.BarrelRollTime
		S.DodgeAir = true
		S.DodgeCd = 0.55
	elseif S.Grounded or not S.AirDashUsed then
		local wish = fwd * mv.Y + right * mv.X
		if wish.Magnitude < 0.1 then
			wish = root.CFrame.LookVector * Vector3.new(1, 0, 1)
		end
		S.DodgeDir = wish.Unit
		S.DodgeAir = not S.Grounded
		if S.DodgeAir then
			S.AirDashUsed = true
			local v = root.AssemblyLinearVelocity
			root.AssemblyLinearVelocity = Vector3.new(v.X, math.max(v.Y, 6), v.Z)
		end
		S.Dodge = S.DodgeAir and Config.Moves.AirDodgeTime or Config.Moves.DodgeTime
		S.DodgeCd = Config.Moves.DodgeCooldown
		S.EmoteTime = 0
		S.Pounding = false
		S.FaceYaw = yawOf(S.DodgeDir)
		S.FaceTime = S.Dodge
	end
end

local function onDown(down)
	if not down then
		return
	end
	local character, humanoid, root = charParts()
	if not character or S.Flying or S.Pounding or S.Intangible or S.Grapple or humanoid.SeatPart then
		return
	end
	if formId() == "Cannonbolt" then
		return
	end
	if S.Grounded then
		-- Sprint + crouch = slide.
		local v = root.AssemblyLinearVelocity
		local flat = Vector3.new(v.X, 0, v.Z)
		if Input.held("Boost") and flat.Magnitude > 20 and S.Slide <= 0 then
			S.Slide = 0.75
			S.SlideDir = flat.Unit
			S.SlideSpeed = flat.Magnitude * 1.35
			S.EmoteTime = 0
		end
		return
	end
	if not groundBelow(root, humanoid, 5) then
		S.Pounding = true
		S.Gliding = false
		S.FlipTime = 0
		S.Dodge = 0
		-- The server only accepts a pound it saw start, so report it right away.
		local report = table.clone(lastSent)
		report.Pounding = true
		lastSent = report
		fire("State", report)
	end
end

local function onEmote(down)
	if not down or not S.Grounded or S.Flying or S.EmoteTime > 0 or formId() == "Cannonbolt" then
		return
	end
	S.EmoteTime = Config.Moves.EmoteTime
	local lines = {
		Jimmy = "Brain blast!", Timmy = "Cosmo! Wanda!", Danny = "Going ghost!", Jake = "Dragon up!",
		XJ9 = "Hi! XJ9, ready to save the day!", ElTigre = "TIGRE!", Ben = "It's hero time!", Aang = "Yip yip!",
	}
	say(formId() or lines[heroId()] or "", hero().Accent)
end

local function onJumpRequest()
	local character, humanoid, root = charParts()
	if not character or humanoid.SeatPart or S.Flying then
		return
	end
	local v = root.AssemblyLinearVelocity
	local jumpV = math.sqrt(2 * workspace.Gravity * humanoid.JumpHeight)
	if S.Grounded then
		S.JumpCut = true
		S.Jumped = true
		S.EmoteTime = 0
		S.JumpReleased = false
		return
	end
	-- JumpRequest repeats while the key is held: air moves need a fresh press.
	if not S.JumpReleased then
		return
	end
	S.JumpReleased = false
	-- Coyote time: just walked off a ledge.
	if not S.Jumped and S.Coyote > 0 then
		root.AssemblyLinearVelocity = Vector3.new(v.X, jumpV, v.Z)
		S.Jumped = true
		S.JumpCut = true
		S.Coyote = 0
		return
	end
	local f = formId()
	if S.WallRun then
		-- Kick off the wall you're running along.
		local out = S.WallRun.Normal * 34
		root.AssemblyLinearVelocity = Vector3.new(out.X + v.X * 0.5, jumpV, out.Z + v.Z * 0.5)
		S.WallRun = nil
		S.AirDashUsed = false
		S.FlipTime = 0.5
		return
	end
	if S.WallTimer > 0 and (not f or f == "XLR8") and not S.JustJumped then
		local out = S.WallNormal * Config.Moves.WallJumpOut
		root.AssemblyLinearVelocity = Vector3.new(out.X, jumpV * 0.95, out.Z)
		S.WallTimer = 0
		S.WallSlide = 0
		S.AirDashUsed = false
		S.JumpCut = true
		S.FaceYaw = yawOf(S.WallNormal)
		S.FaceTime = 0.25
		if heroId() == "ElTigre" or heroId() == "Aang" then
			S.FlipTime = 0.5
		end
		return
	end
	if S.AirJumpsLeft > 0 and not f then
		S.AirJumpsLeft = S.AirJumpsLeft - 1
		root.AssemblyLinearVelocity = Vector3.new(v.X, jumpV * 0.9, v.Z)
		S.FlipTime = 0.5
		S.JumpCut = false
	end
end

-- Per-frame --------------------------------------------------------------------------

local function updateFlight(dt, humanoid, root)
	local id = heroId()
	local h = hero()
	local style = Config.Flight[id] or Config.Flight.Danny
	local cam = workspace.CurrentCamera.CFrame
	local right = Vector3.new(cam.RightVector.X, 0, cam.RightVector.Z).Unit
	local mv = S.EmoteTime > 0 and Vector2.zero or Input.move()
	local wish = cam.LookVector * mv.Y + right * mv.X
	local vertical = (Input.jumpHeld() and 1 or 0) - (Input.held("Down") and 1 or 0)
	wish = wish + Vector3.new(0, vertical * 0.75, 0)
	if wish.Magnitude > 1 then
		wish = wish.Unit
	end
	local wishLen = wish.Magnitude
	local boost = Input.held("Boost") and S.Energy > 1 and wishLen > 0.1
	if boost then
		S.Energy = math.max(0, S.Energy - style.BoostCost * dt)
	end
	S.Boosting = boost

	local old = S.FlyVel
	local spd = old.Magnitude
	local dir = spd > 0.05 and old / spd or Vector3.new(0, 1, 0)
	local v
	if wishLen > 0.05 then
		local wishDir = wish.Unit
		local top = (boost and h.FlyBoost or h.FlySpeed) * skills().Flight * wishLen - dir.Y * style.DiveGain
		local slow = math.clamp(1 - spd / h.FlySpeed, 0, 1)
		local turn = math.rad(style.TurnRate * (1 + 4 * slow) * (boost and 0.8 or 1)) * dt
		local newDir = spd > 5 and rotateToward(dir, wishDir, turn) or wishDir
		local against = math.max(0, -dir:Dot(wishDir))
		spd = approach(spd, top * (1 - 0.5 * against), (spd < top and style.Accel or style.Accel * 0.7) * dt)
		v = newDir * spd
	else
		spd = approach(spd, 0, style.Brake * dt)
		v = dir * spd
	end
	if S.TakeoffTime > 0 then
		v = Vector3.new(v.X, math.max(v.Y, 23 * S.TakeoffTime / 0.45), v.Z)
	end
	S.FlyVel = v

	-- Visual bank from the turn rate and strafing, pitch from the climb angle.
	local flat = Vector3.new(v.X, 0, v.Z)
	local oldFlat = Vector3.new(old.X, 0, old.Z)
	local yawRate = 0
	if flat.Magnitude > 3 and oldFlat.Magnitude > 3 and dt > 0 then
		yawRate = -angleDelta(yawOf(oldFlat), yawOf(flat)) / dt
	end
	local bankTarget = math.clamp(yawRate * 0.22 + mv.X * 20, -style.MaxBank, style.MaxBank) * math.clamp(flat.Magnitude / 17, 0, 1)
	S.FlyBank = S.FlyBank + (bankTarget - S.FlyBank) * math.min(1, dt * 5)
	local pitchTarget = spd > 5 and math.deg(math.atan2(v.Y, flat.Magnitude)) or 0
	S.FlyPitch = S.FlyPitch + (pitchTarget - S.FlyPitch) * math.min(1, dt * 6)

	if boost and not S.WasBoosting and spd > 13 then
		S.BoostFx = 0.4
		CameraRig.shake(0.35)
		if Movement.onBoom then
			Movement.onBoom(root.Position, dir)
		end
	end
	S.WasBoosting = boost
	local face = flat.Magnitude > 2 and yawOf(flat) or (S.FaceYaw or CameraRig.yaw())
	if S.AttackAnim > 0 then
		face = CameraRig.yaw()
	end
	drive(root, "Vector", v, face)

	-- Land by holding descend into the ground.
	if Input.held("Down") and not S.Intangible and groundBelow(root, humanoid, 1.2) then
		stopFlight(humanoid)
		S.LandTimer = 0.18
	end
end

local function updateGlide(dt, root)
	local G = Config.Glide
	local flat = Vector3.new(root.AssemblyLinearVelocity.X, 0, root.AssemblyLinearVelocity.Z)
	if not S.Gliding then
		S.Gliding = true
		S.GlideSpeed = math.max(flat.Magnitude, 32)
	end
	local camPitch = math.deg(math.asin(math.clamp(CameraRig.lookVector().Y, -1, 1)))
	local pitch = math.rad(math.clamp(camPitch + 8, -55, 25))
	local aero = skills().Flight
	S.GlideSpeed = math.clamp(S.GlideSpeed + (-math.sin(pitch) * G.DiveAccel - (S.GlideSpeed - G.Cruise * aero) * 0.35) * dt, G.MinSpeed, G.MaxSpeed * aero)
	local mv = Input.move()
	local travel = flat.Magnitude > 2 and yawOf(flat) or CameraRig.yaw()
	local target = CameraRig.yaw() - mv.X * 40
	local maxTurn = (mv.Y < -0.5 and 160 or 110) * dt
	local step = math.clamp(angleDelta(travel, target), -maxTurn, maxTurn)
	local newYaw = travel + step
	if mv.Y < -0.5 then
		S.GlideSpeed = math.max(G.MinSpeed, S.GlideSpeed - 30 * dt)
	end
	local forward = CFrame.Angles(0, math.rad(newYaw), 0).LookVector
	local horizontal = forward * S.GlideSpeed * math.cos(pitch)
	local vy = math.sin(pitch) * S.GlideSpeed * 0.7 - 5.7
	if S.GlideSpeed < G.StallSpeed then
		vy = vy - (G.StallSpeed - S.GlideSpeed) * 1.6
	end
	local curY = root.AssemblyLinearVelocity.Y
	vy = approach(curY, vy, 100 * dt)
	drive(root, "Vector", Vector3.new(horizontal.X, vy, horizontal.Z), newYaw)
	local yawRate = dt > 0 and -step / dt or 0
	S.FlyBank = S.FlyBank + (math.clamp(yawRate * 0.35, -45, 45) - S.FlyBank) * math.min(1, dt * 5)
	S.FlyPitch = S.FlyPitch + (math.deg(math.atan2(vy, math.max(1, horizontal.Magnitude))) - S.FlyPitch) * math.min(1, dt * 6)
end

local function updateWalls(root, humanoid)
	local mv = Input.move()
	local cam = workspace.CurrentCamera.CFrame
	local wish = Vector3.new(cam.LookVector.X, 0, cam.LookVector.Z).Unit * mv.Y + Vector3.new(cam.RightVector.X, 0, cam.RightVector.Z).Unit * mv.X
	local probe = wish.Magnitude > 0.2 and wish.Unit or root.CFrame.LookVector * Vector3.new(1, 0, 1)
	if probe.Magnitude < 0.1 then
		return
	end
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = { player.Character, workspace:FindFirstChild("Shards"), workspace:FindFirstChild("Enemies") }
	local hit = workspace:Raycast(root.Position, probe.Unit * (root.Size.X * 0.5 + 1.2), params)
	if hit and math.abs(hit.Normal.Y) < 0.5 and hit.Instance.CanCollide then
		S.WallTimer = 0.22
		S.WallNormal = Vector3.new(hit.Normal.X, 0, hit.Normal.Z).Unit
		if wish.Magnitude > 0.3 and wish.Unit:Dot(S.WallNormal) < -0.3 and root.AssemblyLinearVelocity.Y < 0 then
			S.WallSlide = 0.15
		end
	end
end

-- Parkour --------------------------------------------------------------------------

local function wallRay(root, dir, dist)
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = { player.Character, workspace:FindFirstChild("Shards"), workspace:FindFirstChild("Enemies"), workspace:FindFirstChild("LocalFx") }
	local hit = workspace:Raycast(root.Position, dir * dist, params)
	if hit and math.abs(hit.Normal.Y) < 0.4 and hit.Instance.CanCollide then
		return hit, params
	end
	return nil, params
end

local function flatUnit(v)
	local f = Vector3.new(v.X, 0, v.Z)
	return f.Magnitude > 1e-3 and f.Unit or Vector3.zero
end

-- Wall-climb (sprint into a wall), wall-run (sprint alongside one in the air),
-- and mantling onto ledges. Returns true while it's driving the character.
function Movement.updateParkour(dt, humanoid, root, f)
	if (f and f.Id ~= "XLR8") or S.Grapple or S.Pounding or S.Dodge > 0 or S.Intangible then
		S.WallRun = nil
		S.Climb = false
		return false
	end
	local boost = Input.held("Boost")
	local v = root.AssemblyLinearVelocity
	local flat = Vector3.new(v.X, 0, v.Z)
	local mv = Input.move()
	local cam = workspace.CurrentCamera.CFrame
	local wish = flatUnit(cam.LookVector) * mv.Y + flatUnit(cam.RightVector) * mv.X
	local reach = root.Size.X * 0.5

	-- Climb straight up while sprinting into a wall (costs energy).
	if boost and wish.Magnitude > 0.3 and S.Energy > 1 then
		local hit = wallRay(root, wish.Unit, reach + 1.6)
		if hit and wish.Unit:Dot(-hit.Normal) > 0.6 then
			S.Climb = true
			S.WallRun = nil
			S.Energy = math.max(0, S.Energy - 18 * dt)
			local n = flatUnit(hit.Normal)
			drive(root, "Vector", Vector3.new(0, 26, 0) - n * 3, yawOf(-n))
			humanoid.AutoRotate = false
			return true
		end
	end
	if S.Climb then
		-- The wall ran out under us: vault over the top.
		S.Climb = false
		drive(root, nil)
		root.AssemblyLinearVelocity = Vector3.new(0, 30, 0) + flatUnit(root.CFrame.LookVector) * 16
		S.MantleCd = 0.4
		return false
	end
	if S.Grounded then
		S.WallRun = nil
		return false
	end

	if S.WallRun then
		local w = S.WallRun
		w.Time = w.Time - dt
		local hit = wallRay(root, -w.Normal, reach + 2.4)
		if not boost or w.Time <= 0 or not hit then
			S.WallRun = nil
			drive(root, nil)
			return false
		end
		local n = flatUnit(hit.Normal)
		w.Normal = n
		local along = w.Dir - n * w.Dir:Dot(n)
		w.Dir = along.Magnitude > 0.1 and along.Unit or w.Dir
		local k = w.Time / 1.4
		drive(root, "Vector", w.Dir * w.Speed + Vector3.new(0, -6 + 12 * k, 0) - n * 2, yawOf(w.Dir))
		humanoid.AutoRotate = false
		return true
	elseif boost and flat.Magnitude > 14 then
		local right = flatUnit(root.CFrame.RightVector)
		for _, side in ipairs({ 1, -1 }) do
			local hit = wallRay(root, right * side, reach + 2)
			if hit then
				local n = flatUnit(hit.Normal)
				local along = flat - n * flat:Dot(n)
				if along.Magnitude > 8 then
					S.WallRun = { Normal = n, Dir = along.Unit, Time = 1.4, Speed = math.max(flat.Magnitude, 34), Side = side }
					S.WallSlide = 0
					return true
				end
			end
		end
	end

	-- Mantle: moving into a wall whose top is just above head height.
	if S.MantleCd <= 0 and wish.Magnitude > 0.3 then
		local hit, params = wallRay(root, wish.Unit, reach + 1.4)
		if hit then
			local high = root.Position + Vector3.new(0, 3.4 * scale(), 0)
			if not workspace:Raycast(high, wish.Unit * (reach + 2), params) then
				root.AssemblyLinearVelocity = Vector3.new(0, 32, 0) + wish.Unit * 14
				S.MantleCd = 0.6
			end
		end
	end
	return false
end

-- Swinging (El Tigre's chain on anything above him): a real rope, pump along
-- the arc, steer with the stick, let go to fling.
function Movement.startSwing(root, point)
	Movement.endSwing(root, false)
	local anchor = Instance.new("Part")
	anchor.Name = "SwingAnchor"
	anchor.Anchored = true
	anchor.CanCollide = false
	anchor.CanQuery = false
	anchor.Transparency = 1
	anchor.Size = Vector3.new(0.2, 0.2, 0.2)
	anchor.CFrame = CFrame.new(point)
	anchor.Parent = workspace:FindFirstChild("LocalFx") or workspace
	local a1 = Instance.new("Attachment")
	a1.Parent = anchor
	local rope = Instance.new("RopeConstraint")
	rope.Attachment0 = ensureMover(root).Att
	rope.Attachment1 = a1
	rope.Length = (point - root.Position).Magnitude
	rope.Visible = true
	rope.Thickness = 0.18
	rope.Color = BrickColor.new("Light stone grey")
	rope.Parent = anchor
	S.Swing = { Anchor = anchor, Point = point, Rope = rope }
	drive(root, nil)
end

function Movement.updateSwing(dt, root)
	local sw = S.Swing
	local v = root.AssemblyLinearVelocity
	local toPoint = (sw.Point - root.Position).Unit
	local tangent = v - toPoint * v:Dot(toPoint)
	local mv = Input.move()
	local cam = workspace.CurrentCamera.CFrame
	local wish = flatUnit(cam.LookVector) * mv.Y + flatUnit(cam.RightVector) * mv.X
	local accel = Vector3.zero
	if tangent.Magnitude > 2 then
		accel = tangent.Unit * 22
	end
	if wish.Magnitude > 0.2 then
		accel = accel + wish.Unit * 18
	end
	root.AssemblyLinearVelocity = v + accel * dt
	sw.Rope.Length = math.max(12, sw.Rope.Length - 6 * dt)
	local m = ensureMover(root)
	local flat = Vector3.new(v.X, 0, v.Z)
	if flat.Magnitude > 2 then
		m.Align.CFrame = CFrame.Angles(0, math.rad(yawOf(flat)), 0)
		m.Align.MaxTorque = root.AssemblyMass * 5000
	end
end

function Movement.endSwing(root, fling)
	if not S.Swing then
		return
	end
	S.Swing.Anchor:Destroy()
	S.Swing = nil
	if fling and root.Parent then
		local v = root.AssemblyLinearVelocity
		root.AssemblyLinearVelocity = v * 1.15 + Vector3.new(0, 14, 0)
	end
end

local function step(dt)
	local character, humanoid, root = charParts()
	if not character then
		return
	end
	local f = formDef()
	local h = hero()
	local id = heroId()

	-- Timers.
	S.AttackCd = S.AttackCd - dt
	S.SigCd = S.SigCd - dt
	S.Sig2Cd = S.Sig2Cd - dt
	S.AttackAnim = math.max(0, S.AttackAnim - dt)
	S.FlipTime = math.max(0, S.FlipTime - dt)
	S.PoundLand = math.max(0, S.PoundLand - dt)
	S.TakeoffTime = math.max(0, S.TakeoffTime - dt)
	S.LandTimer = math.max(0, S.LandTimer - dt)
	S.Jetpack = math.max(0, S.Jetpack - dt)
	S.Scooter = math.max(0, S.Scooter - dt)
	S.BoostFx = math.max(0, S.BoostFx - dt)
	S.DodgeCd = S.DodgeCd - dt
	S.WallTimer = S.WallTimer - dt
	S.WallSlide = S.WallSlide - dt
	S.FaceTime = (S.FaceTime or 0) - dt
	S.MantleCd = S.MantleCd - dt
	S.CounterAnim = math.max(0, S.CounterAnim - dt)
	S.BlockAnim = math.max(0, S.BlockAnim - dt)
	S.TakedownAnim = math.max(0, S.TakedownAnim - dt)
	if S.Dodge > 0 then
		S.Dodge = math.max(0, S.Dodge - dt)
	end
	if not S.Intangible and not S.Boosting and not S.Breath then
		S.Energy = math.min(Movement.maxEnergy(), S.Energy + Config.Player.EnergyRegen * dt)
	end
	if humanoid.SeatPart then
		if S.Flying then
			stopFlight(humanoid)
		end
		drive(root, nil)
		return
	end
	if (not h.CanFly or f) and S.Flying then
		stopFlight(humanoid)
	end
	if Input.held("Attack") then
		local a = attackDef()
		if a and (a.Cooldown < 0.25 or not S.AttackHeldBefore) then
			tryAttack()
		end
		S.AttackHeldBefore = true
	else
		S.AttackHeldBefore = false
	end

	-- Ground contact.
	S.WasGrounded = S.Grounded
	local floor = humanoid.FloorMaterial ~= Enum.Material.Air
	S.Grounded = floor and not S.Flying
	local vel = root.AssemblyLinearVelocity
	if S.Grounded and not S.WasGrounded then
		if vel.Y < -10 or S.Pounding then
			S.LandTimer = 0.18
		end
		S.AirDashUsed = false
		S.FlipTime = 0
		S.Jumped = false
		if S.Pounding then
			S.Pounding = false
			S.PoundLand = 0.35
			fire("Pound")
			CameraRig.shake(0.8)
			if Movement.onPound then
				Movement.onPound(root.Position - Vector3.new(0, humanoid.HipHeight + root.Size.Y * 0.5, 0))
			end
		end
	end
	if S.Grounded then
		S.AirJumpsLeft = f and 0 or (h.AirJumps or 0)
		S.Coyote = Config.Moves.CoyoteTime
		S.WallSlide = 0
		if not S.Intangible then
			S.LastSafe = root.CFrame
		end
	else
		S.Coyote = S.Coyote - dt
		if humanoid:GetState() == Enum.HumanoidStateType.Jumping then
			S.Jumped = true
		end
	end
	if not Input.jumpHeld() then
		S.JumpReleased = true
	end
	-- Short hop: let go of jump early.
	if S.JumpCut and not Input.jumpHeld() and vel.Y > 0 and not S.Grounded then
		root.AssemblyLinearVelocity = Vector3.new(vel.X, vel.Y * 0.5, vel.Z)
		S.JumpCut = false
	end
	if vel.Y <= 0 and not S.Grounded then
		S.JumpCut = false
	end

	-- Danny: intangible = noclip, energy drain, back to safety if it runs out inside a wall.
	if S.Intangible then
		S.Energy = math.max(0, S.Energy - 12 * dt)
		local inside = insideGeometry(root)
		if not inside then
			S.LastSafe = root.CFrame
		end
		if S.Energy <= 0 then
			if inside and S.LastSafe then
				root.CFrame = S.LastSafe
				S.FlyVel = Vector3.zero
				say("Out of energy - pulled back to safety", Color3.fromRGB(255, 200, 120))
			end
			S.Intangible = false
			S.WantSolid = false
		elseif S.WantSolid and not inside then
			S.Intangible = false
			S.WantSolid = false
		elseif S.WantSolid then
			say("Still inside something - fly clear to turn solid", Color3.fromRGB(200, 255, 200))
			S.WantSolid = false
			S.WantSolidRetry = true
		end
		if S.WantSolidRetry and not inside then
			S.Intangible = false
			S.WantSolidRetry = false
		end
	end

	-- Walk speed: sprint, scooter, emote freeze.
	local base = character:GetAttribute("WalkSpeedBase") or humanoid.WalkSpeed
	if not character:GetAttribute("WalkSpeedBase") then
		character:SetAttribute("WalkSpeedBase", humanoid.WalkSpeed)
		base = humanoid.WalkSpeed
	end
	local walkTarget = (f and f.Walk or h.Walk) * (Input.held("Boost") and not f and 1.45 or 1) * (S.Scooter > 0 and 2.4 or 1) * skills().Walk
	humanoid.WalkSpeed = S.EmoteTime > 0 and 0 or walkTarget

	-- Movement modes.
	local canGlide = f and f.Glide or (not f and h.CanGlide)
	if not S.Grounded and S.Slide > 0 then
		S.Slide = 0
	end
	if S.Swing and (S.Grounded or S.Flying) then
		Movement.endSwing(root, false)
	end
	if S.Flying then
		S.Gliding = false
		updateFlight(dt, humanoid, root)
	elseif S.Lunge then
		local m = S.Lunge.Model
		S.Lunge.Time = S.Lunge.Time - dt
		if not m.Parent or not m.PrimaryPart or S.Lunge.Time <= 0 then
			S.Lunge = nil
			drive(root, nil)
		else
			local to = m.PrimaryPart.Position - root.Position
			local flat = Vector3.new(to.X, 0, to.Z)
			if flat.Magnitude - m.PrimaryPart.Size.Y * 0.5 < 3.5 then
				S.Lunge = nil
				drive(root, nil)
			else
				drive(root, "Plane", flat.Unit * Config.Combat.LungeSpeed, yawOf(flat))
			end
		end
	elseif S.Swing then
		Movement.updateSwing(dt, root)
	elseif S.Slide > 0 then
		S.Slide = math.max(0, S.Slide - dt)
		local k = S.Slide / 0.75
		drive(root, "Plane", S.SlideDir * S.SlideSpeed * (0.6 + 0.4 * k), yawOf(S.SlideDir))
	elseif Movement.updateParkour(dt, humanoid, root, f) then
		-- wall-run / climb / mantle in control
	elseif S.Pounding then
		drive(root, "Vector", Vector3.new(0, -Config.Moves.PoundSpeed, 0), nil)
	elseif S.Dodge > 0 then
		local speed = Config.Moves.DodgeSpeed * (f and f.Id == "XLR8" and 1.9 or 1) * (f and f.Id == "FourArms" and 0.85 or 1)
		drive(root, "Plane", S.DodgeDir * speed, yawOf(S.DodgeDir))
	elseif not S.Grounded and canGlide and Input.jumpHeld() and (vel.Y < 0 or S.Gliding) and not S.Grapple then
		updateGlide(dt, root)
	else
		S.Gliding = false
		if S.Grapple then
			local to = S.Grapple - root.Position
			if to.Magnitude < 5 then
				S.Grapple = nil
				S.FlipTime = 0.5
			else
				local nv = vel + to.Unit * 150 * dt + Vector3.new(0, workspace.Gravity * 0.65 * dt, 0)
				if nv.Magnitude > 107 then
					nv = nv.Unit * 107
				end
				root.AssemblyLinearVelocity = nv
			end
			drive(root, nil)
		elseif S.FaceTime > 0 and S.FaceYaw then
			humanoid.AutoRotate = false
			drive(root, nil)
			local m = ensureMover(root)
			m.Align.CFrame = CFrame.Angles(0, math.rad(S.FaceYaw), 0)
			m.Align.MaxTorque = root.AssemblyMass * 5000
		else
			humanoid.AutoRotate = true
			drive(root, nil)
		end
		if not S.Grounded then
			updateWalls(root, humanoid)
			if S.WallSlide > 0 and vel.Y < 0 then
				local cling = (id == "ElTigre" and not f) and -7 or -22
				if vel.Y < cling then
					root.AssemblyLinearVelocity = Vector3.new(vel.X, cling, vel.Z)
				end
				local m = ensureMover(root)
				m.Align.CFrame = CFrame.Angles(0, math.rad(yawOf(-S.WallNormal)), 0)
				m.Align.MaxTorque = root.AssemblyMass * 5000
				humanoid.AutoRotate = false
			end
		end
	end

	-- Emotes end when you move or leave the ground.
	if S.EmoteTime > 0 then
		local before = S.EmoteTime
		S.EmoteTime = math.max(0, S.EmoteTime - dt)
		if Input.move().Magnitude > 0.1 or not S.Grounded then
			S.EmoteTime = 0
		elseif before > 1.2 and S.EmoteTime <= 1.2 and Movement.onEmotePeak then
			Movement.onEmotePeak(root.Position, formDef() and formDef().Accent or h.Accent)
		end
	end

	-- Walk cycle phase and idle time for the Animator.
	local flatSpeed = Vector3.new(vel.X, 0, vel.Z).Magnitude
	S.WalkPhase = S.WalkPhase + flatSpeed * dt * 0.75 / scale()
	if S.Grounded and flatSpeed < 1 and S.AttackAnim <= 0 and S.Dodge <= 0 then
		S.IdleTime = S.IdleTime + dt
	else
		S.IdleTime = 0
	end

	-- Report state for animation replication and server immunity checks (max 12 Hz, on change).
	sendClock = sendClock - dt
	local report = {
		Flying = S.Flying, Gliding = S.Gliding, Dodge = S.Dodge > 0, DodgeAir = S.DodgeAir, Pounding = S.Pounding,
		Emote = S.EmoteTime > 0, WallSlide = S.WallSlide > 0, Boosting = S.Boosting, Jetpack = S.Jetpack > 0,
		Scooter = S.Scooter > 0, Intangible = S.Intangible, Takeoff = S.TakeoffTime > 0, Grapple = S.Grapple ~= nil,
		Breath = S.Breath, DodgeSide = S.DodgeSide, FlyBank = math.floor(S.FlyBank + 0.5), FlyPitch = math.floor(S.FlyPitch + 0.5),
		Slide = S.Slide > 0, WallRun = S.WallRun ~= nil, Climb = S.Climb, Swing = S.Swing ~= nil,
		WallSide = S.WallRun and S.WallRun.Side or 0, Lunge = S.Lunge ~= nil,
	}
	local changed = false
	for k, v in pairs(report) do
		if lastSent[k] ~= v then
			changed = true
			break
		end
	end
	if changed and sendClock <= 0 then
		sendClock = 1 / 12
		lastSent = report
		fire("State", report)
	end
end

function Movement.init(controllers)
	Input, CameraRig, Hud, CombatAssist = controllers.Input, controllers.CameraRig, controllers.Hud, controllers.CombatAssist
	Input.on("Sig", onSig)
	Input.on("Sig2", onSig2)
	Input.on("Ult", onUlt)
	Input.on("Fly", onFly)
	Input.on("Dodge", onDodge)
	Input.on("Down", onDown)
	Input.on("Emote", onEmote)
	Input.on("Attack", function(down)
		if down then
			tryAttack()
			S.AttackHeldBefore = true
		end
	end)
	for i = 1, 3 do
		Input.on("Omni" .. i, function(down)
			if down and heroId() == "Ben" then
				fire("Omnitrix", "slot", i - 1)
				if Hud then
					Hud.setDial(false)
				end
			end
		end)
	end
	Input.on("Glitch", function(down)
		if down and heroId() == "Ben" then
			fire("Omnitrix", "glitch")
		end
	end)
	Input.on("Recall", function(down)
		if down then
			fire("Travel", Config.Levels.Nexus)
		end
	end)
end

function Movement.start()
	remotes = ReplicatedStorage:WaitForChild("Remotes")
	game:GetService("UserInputService").JumpRequest:Connect(onJumpRequest)
	player.CharacterAdded:Connect(function()
		reset()
		mover = nil
		lastSent = {}
	end)
	RunService.Heartbeat:Connect(step)
	-- Intangibility: switch collisions off every physics step (the Humanoid re-enables some).
	local ghosted = {}
	RunService.Stepped:Connect(function()
		if S.Intangible and player.Character then
			for _, p in ipairs(player.Character:GetDescendants()) do
				if p:IsA("BasePart") and p.CanCollide then
					p.CanCollide = false
					ghosted[p] = true
				end
			end
		elseif next(ghosted) then
			-- Solid again: restore exactly the collisions we switched off.
			for p in pairs(ghosted) do
				if p.Parent then
					p.CanCollide = true
				end
			end
			ghosted = {}
		end
	end)
end

return Movement
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX18850"><Properties>
<string name="Name">Vehicle</string>
<ProtectedString name="Source"><![CDATA[--!nonstrict
-- Jimmy's hover car (anyone can drive it): sit in the seat (E), then
-- W/S throttle, A/D steer, Space/Ctrl altitude, Shift boost, E to hop out.
-- Same feel as the prototype's hover car: hovers at a cruise height over the
-- ground, banks into turns, noses down when accelerating.

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local ContextActionService = game:GetService("ContextActionService")

local Vehicle = {}
local player = Players.LocalPlayer
local Input
local car -- { Model, Body, Velocity, Orientation, Yaw, Speed, YawRate, Altitude }

local function sitting()
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local seat = humanoid and humanoid.SeatPart
	if seat and seat.Name == "DriverSeat" and seat.Parent and seat.Parent.Name == "HoverCar" then
		return seat.Parent, humanoid
	end
	return nil
end

local function bindDriving(on)
	if on then
		-- Space and E belong to the car while driving (not jump / prompts).
		ContextActionService:BindActionAtPriority("MT_DriveSink", function(_, state, input)
			if input.KeyCode == Enum.KeyCode.E and state == Enum.UserInputState.Begin then
				local _, humanoid = sitting()
				if humanoid then
					humanoid.Sit = false
					humanoid.Jump = true
				end
			end
			return Enum.ContextActionResult.Sink
		end, false, 3000, Enum.KeyCode.Space, Enum.KeyCode.E)
	else
		ContextActionService:UnbindAction("MT_DriveSink")
	end
end

function Vehicle.init(controllers)
	Input = controllers.Input
end

function Vehicle.start()
	RunService.Heartbeat:Connect(function(dt)
		local model, humanoid = sitting()
		if not model then
			if car then
				bindDriving(false)
				car = nil
			end
			return
		end
		local body = model.PrimaryPart
		if not car or car.Model ~= model then
			local _, yaw = body.CFrame:ToEulerAnglesYXZ()
			car = {
				Model = model, Body = body, Velocity = body:FindFirstChild("DriveVelocity"), Orientation = body:FindFirstChild("DriveOrientation"),
				Yaw = math.deg(yaw), Speed = 0, YawRate = 0, Altitude = 8,
			}
			bindDriving(true)
		end
		local throttle = (UserInputService:IsKeyDown(Enum.KeyCode.W) and 1 or 0) - (UserInputService:IsKeyDown(Enum.KeyCode.S) and 1 or 0)
		local steer = (UserInputService:IsKeyDown(Enum.KeyCode.D) and 1 or 0) - (UserInputService:IsKeyDown(Enum.KeyCode.A) and 1 or 0)
		local mv = Input.move()
		if throttle == 0 then
			throttle = mv.Y
		end
		if steer == 0 then
			steer = mv.X
		end
		local boost = Input.held("Boost")
		local up = (UserInputService:IsKeyDown(Enum.KeyCode.Space) and 1 or 0) - ((Input.held("Down")) and 1 or 0)
		car.Altitude = math.clamp(car.Altitude + up * 14 * dt, 4, 60)
		local top = boost and 140 or 85
		local target = throttle * top
		local accel = throttle ~= 0 and 45 or 25
		car.Speed = car.Speed + math.clamp(target - car.Speed, -accel * dt, accel * dt)
		local turnRate = 110 * math.clamp(1 - math.abs(car.Speed) / 220, 0.35, 1)
		car.YawRate = car.YawRate + (-steer * turnRate - car.YawRate) * math.min(1, dt * 6)
		car.Yaw = car.Yaw + car.YawRate * dt
		-- Hover: hold the cruise height above whatever is below.
		local params = RaycastParams.new()
		params.FilterType = Enum.RaycastFilterType.Exclude
		params.FilterDescendantsInstances = { model, player.Character }
		local hit = workspace:Raycast(body.Position, Vector3.new(0, -200, 0), params)
		local groundY = hit and hit.Position.Y or body.Position.Y - car.Altitude
		local vy = math.clamp((groundY + car.Altitude - body.Position.Y) * 3, -40, 40)
		local forward = CFrame.Angles(0, math.rad(car.Yaw), 0).LookVector
		if car.Velocity then
			car.Velocity.VectorVelocity = forward * car.Speed + Vector3.new(0, vy, 0)
		end
		if car.Orientation then
			local bank = math.clamp(car.YawRate * 0.25, -30, 30)
			local pitch = math.clamp(-(target - car.Speed) * 0.08, -10, 10)
			car.Orientation.CFrame = CFrame.Angles(0, math.rad(car.Yaw), 0) * CFrame.Angles(math.rad(pitch), 0, math.rad(bank))
		end
	end)
end

return Vehicle
]]></ProtectedString>
</Properties>
</Item>
</Item>
