<Item class="ModuleScript" referent="RBX18814"><Properties>
<string name="Name">Omnitrix</string>
<ProtectedString name="Source"><![CDATA[--!nonstrict
-- Ben's Omnitrix as a pure state machine: a line-for-line port of
-- Source/MultiverseToons/Public/Omnitrix/OmnitrixStateMachine.h so the Unreal
-- project, the prototype and the Roblox game share the same rules. The server
-- owns the authoritative instance; Roblox/tools/test_logic.py tests it.
--
-- Slots are 0-based like the C++ (0..NumSlots-1). Forms: >= 0 playlist slot,
-- NoForm, GlitchForm, OverclockForm. Assets are always resident on Roblox, so
-- transforms complete as soon as their timer runs out.

local Omnitrix = {}
Omnitrix.__index = Omnitrix

Omnitrix.NoForm = -1
Omnitrix.GlitchForm = -2
Omnitrix.OverclockForm = -3

Omnitrix.State = {
	Human = "Human",
	Selecting = "Selecting",
	Transforming = "Transforming",
	Alien = "Alien",
	Reverting = "Reverting",
	Recharging = "Recharging",
	Glitched = "Glitched",
	Overclocked = "Overclocked",
}
local S = Omnitrix.State

local DEFAULTS = {
	NumSlots = 3, TransformTime = 0.45, RevertTime = 0.6, AlienDuration = 60, RechargeTime = 8,
	SwapTimePenalty = 4, GlitchDuration = 4, GlitchCooldown = 30, OverclockDuration = 20,
}

local function max0(v)
	if v > 0 then
		return v
	end
	return 0
end

function Omnitrix.new(config)
	local c = {}
	for k, v in pairs(DEFAULTS) do
		c[k] = v
	end
	if config then
		for k, v in pairs(config) do
			c[k] = v
		end
	end
	local self = setmetatable({}, Omnitrix)
	self.Config = c
	self.State = S.Human
	self.ActiveForm = Omnitrix.NoForm
	self.PendingForm = Omnitrix.NoForm
	self.StateTimer = 0
	self.AlienTimeRemaining = 0
	self.GlitchCooldownRemaining = 0
	self.DialFromAlien = false
	return self
end

function Omnitrix:IsInvulnerable()
	return self.State == S.Transforming or self.State == S.Glitched
end

function Omnitrix:IsInputLocked()
	return self.State == S.Transforming or self.State == S.Reverting
end

function Omnitrix:IsTransformed()
	return self.State == S.Alien or self.State == S.Glitched or self.State == S.Overclocked
end

function Omnitrix:_validSlot(slot)
	return type(slot) == "number" and slot >= 0 and slot < self.Config.NumSlots and slot == math.floor(slot)
end

function Omnitrix:_beginTransform(form)
	self.DialFromAlien = false
	self.PendingForm = form
	self.State = S.Transforming
	self.StateTimer = self.Config.TransformTime
end

function Omnitrix:_beginRevert()
	self.DialFromAlien = false
	self.PendingForm = Omnitrix.NoForm
	self.AlienTimeRemaining = 0
	self.State = S.Reverting
	self.StateTimer = self.Config.RevertTime
end

function Omnitrix:OpenDial()
	if self.State ~= S.Human and self.State ~= S.Alien then
		return false
	end
	self.DialFromAlien = self.State == S.Alien
	self.State = S.Selecting
	return true
end

function Omnitrix:CancelDial()
	if self.State ~= S.Selecting then
		return false
	end
	if self.DialFromAlien then
		self.State = S.Alien
	else
		self.State = S.Human
	end
	return true
end

function Omnitrix:Confirm(slot)
	if self.State ~= S.Selecting or not self:_validSlot(slot) then
		return false
	end
	if self.DialFromAlien then
		self.State = S.Alien
		return self:QuickSwap(slot)
	end
	self.AlienTimeRemaining = self.Config.AlienDuration
	self:_beginTransform(slot)
	return true
end

function Omnitrix:QuickSwap(slot)
	if not self:_validSlot(slot) then
		return false
	end
	if self.State == S.Human then
		self.AlienTimeRemaining = self.Config.AlienDuration
		self:_beginTransform(slot)
		return true
	end
	if self.State ~= S.Alien or slot == self.ActiveForm or self.AlienTimeRemaining <= self.Config.SwapTimePenalty then
		return false
	end
	self.AlienTimeRemaining = self.AlienTimeRemaining - self.Config.SwapTimePenalty
	self:_beginTransform(slot)
	return true
end

function Omnitrix:TriggerGlitch()
	if self.GlitchCooldownRemaining > 0 then
		return false
	end
	if self.State == S.Glitched or self.State == S.Overclocked or self.State == S.Reverting then
		return false
	end
	self.DialFromAlien = false
	self.PendingForm = Omnitrix.NoForm
	self.ActiveForm = Omnitrix.GlitchForm
	self.State = S.Glitched
	self.StateTimer = self.Config.GlitchDuration
	self.GlitchCooldownRemaining = self.Config.GlitchCooldown
	return true
end

function Omnitrix:TriggerOverclock()
	if self.State ~= S.Human and self.State ~= S.Alien and self.State ~= S.Recharging then
		return false
	end
	self:_beginTransform(Omnitrix.OverclockForm)
	return true
end

function Omnitrix:ForceRevert()
	if self.State == S.Human or self.State == S.Reverting or self.State == S.Recharging then
		return false
	end
	if self.State == S.Selecting and not self.DialFromAlien then
		self.State = S.Human
		return true
	end
	self:_beginRevert()
	return true
end

function Omnitrix:Tick(dt)
	if dt <= 0 then
		return
	end
	if self.GlitchCooldownRemaining > 0 then
		self.GlitchCooldownRemaining = max0(self.GlitchCooldownRemaining - dt)
	end
	local alienClock = self.State == S.Alien
		or (self.State == S.Selecting and self.DialFromAlien)
		or (self.State == S.Transforming and self.PendingForm >= 0 and self.ActiveForm >= 0)
	if alienClock then
		self.AlienTimeRemaining = max0(self.AlienTimeRemaining - dt)
		if self.AlienTimeRemaining <= 0 and self.State ~= S.Transforming then
			self:_beginRevert()
			return
		end
	end
	local st = self.State
	if st == S.Transforming then
		self.StateTimer = max0(self.StateTimer - dt)
		if self.StateTimer <= 0 then
			self.ActiveForm = self.PendingForm
			self.PendingForm = Omnitrix.NoForm
			if self.ActiveForm == Omnitrix.OverclockForm then
				self.State = S.Overclocked
				self.StateTimer = self.Config.OverclockDuration
			elseif self.AlienTimeRemaining <= 0 then
				self:_beginRevert()
			else
				self.State = S.Alien
			end
		end
	elseif st == S.Glitched or st == S.Overclocked then
		self.StateTimer = max0(self.StateTimer - dt)
		if self.StateTimer <= 0 then
			self:_beginRevert()
		end
	elseif st == S.Reverting then
		self.StateTimer = max0(self.StateTimer - dt)
		if self.StateTimer <= 0 then
			self.ActiveForm = Omnitrix.NoForm
			self.State = S.Recharging
			self.StateTimer = self.Config.RechargeTime
		end
	elseif st == S.Recharging then
		self.StateTimer = max0(self.StateTimer - dt)
		if self.StateTimer <= 0 then
			self.State = S.Human
		end
	end
end

-- Index into Config.Forms for the active form (nil when human).
function Omnitrix.FormIndex(form, config)
	if form >= 0 then
		return form + 1
	elseif form == Omnitrix.GlitchForm then
		return config.GlitchForm
	elseif form == Omnitrix.OverclockForm then
		return config.OverclockForm
	end
	return nil
end

return Omnitrix
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX18815"><Properties>
<string name="Name">Pose</string>
<ProtectedString name="Source"><![CDATA[--!nonstrict
-- Procedural character animation, ported from the prototype
-- (Prototype/src/GameCharacters.cpp). Pure: takes a character's movement
-- state, returns joint angles in degrees. Client/Controllers/Animator applies
-- them to the R15 Motor6Ds of every character, so everyone sees everyone's
-- moves without uploaded animation assets.
--
-- Angle conventions (prototype model space, converted in the Animator):
--   ShFwd/Thigh/Elbow positive = forward / bend, Knee positive = bend,
--   ShAbd positive = away from the body, Lean/BodyPitch/HeadPitch positive =
--   forward/down, Twist/Spin/HeadYaw positive = turn left, Roll positive = tilt right.
--
-- State fields (all optional): Hero, Form, Speed (horizontal studs/s), Speed3,
-- VelY, Grounded, Flying, Gliding, Pounding, PoundLand, Dodge, DodgeAir,
-- DodgeSide, AttackAnim, AttackDur, AttackStep, Hurt, LandTimer, IdleTime,
-- EmoteTime, FlipTime, WallSlide, FlyBank, FlyPitch, Boosting, TakeoffTime,
-- Breath, Jetpack, WalkPhase, Time.

local Pose = {}

local PI = math.pi
local sin, cos, abs, min, max, floor = math.sin, math.cos, math.abs, math.min, math.max, math.floor

local function clamp(v, a, b)
	if v < a then
		return a
	end
	if v > b then
		return b
	end
	return v
end

local function round(v)
	return floor(v + 0.5)
end

local function fmod(a, b)
	return a - floor(a / b) * b
end

Pose.EmoteTime = 2.4

-- Gait per hero: stride, cadence, arm swing, knee lift, bounce, hip twist, run lean.
local GAITS = {
	FourArms = { 0.85, 0.8, 0.7, 0.8, 1.8, 0.6, 0.6 },
	XLR8 = { 1.3, 1.3, 0.5, 1.4, 0.5, 0.6, 3.0 },
	WayBig = { 0.8, 0.75, 0.6, 0.8, 1.2, 0.5, 0.5 },
	Jimmy = { 0.85, 1.15, 0.8, 0.9, 0.9, 0.8, 1.4 },
	Timmy = { 1.0, 1.05, 1.5, 1.15, 1.5, 1.2, 0.8 },
	Danny = { 1.05, 0.95, 0.7, 1.0, 0.8, 1.0, 1.0 },
	Jake = { 1.1, 0.95, 1.1, 1.0, 1.4, 1.8, 0.9 },
	XJ9 = { 0.9, 1.0, 0.6, 0.35, 0.4, 0.0, 0.6 },
	ElTigre = { 1.1, 1.05, 0.8, 1.3, 0.9, 1.0, 1.6 },
	Aang = { 1.2, 0.95, 0.9, 1.25, 1.6, 1.0, 1.1 },
}

function Pose.Compute(st)
	local t = st.Time or 0
	local form = st.Form
	local human = form == nil
	local id = st.Hero or "Ben"
	local function is(h)
		return human and id == h
	end
	local speed = st.Speed or 0
	local speed3 = st.Speed3 or speed
	local grounded = st.Grounded ~= false
	local flying = st.Flying == true
	local gliding = st.Gliding == true
	local pounding = st.Pounding == true
	local dodgeT = st.Dodge or 0
	local dodge = dodgeT > 0 and not flying
	local wall = (st.WallSlide or 0) > 0 and not grounded

	local g = GAITS[form or id] or { 1, 1, 1, 1, 1, 1, 1 }
	local gStride, gCad, gArms, gKnees, gBounce, gTwist, gLean = g[1], g[2], g[3], g[4], g[5], g[6], g[7]

	local walk, run = 0, 0
	if grounded and not dodge then
		walk = min(1, speed / 20)
		run = clamp((speed - 24) / 14, 0, 1)
	end
	local ph = (st.WalkPhase or 0) * gCad
	local sw, cw = sin(ph), cos(ph)
	local idle = (1 - walk) * (grounded and 1 or 0)
	local atkDur = st.AttackDur or 0.25
	local atkAnim = st.AttackAnim or 0
	local atkA, atk = 0, 0
	if atkAnim > 0 then
		atkA = clamp(1 - atkAnim / atkDur, 0, 1)
		atk = sin(PI * atkA)
	end
	local step = st.AttackStep or 0
	local hurt = min(1, (st.Hurt or 0) / 0.25)
	local land = (st.LandTimer or 0) / 0.18
	local air = not grounded and not flying and not gliding and not pounding and not dodge and not wall
	local A = (1 + run * 0.7) * gStride

	local fid, fidT = 0, 0
	local idleTime = st.IdleTime or 0
	if idleTime > 2 then
		local f = fmod(idleTime - 2, 7)
		if f > 3 and f < 5.5 then
			fidT = (f - 3) / 2.5
			fid = min(1, sin(PI * fidT) * 1.6)
		end
	end
	if atkAnim > 0 then
		fid = 0
	end
	fid = fid * idle
	local em, emW = 0, 0
	local emoteTime = st.EmoteTime or 0
	if emoteTime > 0 then
		em = 1 - emoteTime / Pose.EmoteTime
		emW = clamp(min(em, 1 - em) * 6, 0, 1)
	end

	local O = {
		Lean = 0, HipTwist = 0, ChestTwist = 0, Bob = 0, ShiftX = 0, HipRoll = 0,
		HeadYaw = 0, HeadPitch = 0, HeadRoll = 0,
		ShFwd = { 0, 0 }, ShAbd = { 0, 0 }, Elbow = { 0, 0 },
		Thigh = { 0, 0 }, ThighAbd = { 0, 0 }, Knee = { 0, 0 }, Ankle = { 0, 0 },
		Breath = 1, BodyPitch = 0, BodyRoll = 0, Spin = 0, StaffSpin = 0,
		Tail = flying and is("Danny"),
	}
	-- Index 1 = left, 2 = right.
	local function blend(tbl, key, target, w)
		tbl[key] = tbl[key] + (target - tbl[key]) * w
	end
	local function arm(s, fwd, abd, elb, w)
		blend(O.ShFwd, s, fwd, w)
		blend(O.ShAbd, s, abd, w)
		blend(O.Elbow, s, elb, w)
	end
	local function leg(s, th, kn, w)
		blend(O.Thigh, s, th, w)
		blend(O.Knee, s, kn, w)
	end

	-- Base idle: breathing, weight shift, looking around.
	O.Breath = 1 + 0.025 * sin(t * 2.2) * idle
	O.ShiftX = sin(t * 0.8) * 1.5 * idle
	O.HipRoll = sin(t * 0.8) * 2 * idle
	O.HeadYaw = sin(t * 0.45) * 14 * idle
	O.HeadPitch = sin(t * 0.7) * 3 * idle
	for s = 1, 2 do
		O.ShAbd[s] = 9 + sin(t * 2.2) * 2 * idle
		O.Elbow[s] = 12 + 6 * idle
		O.Knee[s] = 4
	end
	-- Walk / run cycle shaped by the gait.
	O.Thigh[1] = 30 * walk * A * sw
	O.Thigh[2] = -30 * walk * A * sw
	O.Knee[1] = O.Knee[1] + (10 + 50 * A * max(0, cw)) * walk * gKnees
	O.Knee[2] = O.Knee[2] + (10 + 50 * A * max(0, -cw)) * walk * gKnees
	O.Ankle[1] = (O.Knee[1] - O.Thigh[1]) * 0.35 * walk
	O.Ankle[2] = (O.Knee[2] - O.Thigh[2]) * 0.35 * walk
	O.ShFwd[1] = -32 * walk * A * sw * gArms
	O.ShFwd[2] = 32 * walk * A * sw * gArms
	O.Elbow[1] = O.Elbow[1] + (18 + 55 * run) * walk
	O.Elbow[2] = O.Elbow[2] + (18 + 55 * run) * walk
	O.Bob = (-3 * A * abs(sw) + 1.5) * walk * gBounce
	O.HipTwist = 8 * walk * sw * gTwist
	O.ChestTwist = -10 * walk * sw * gTwist
	O.Lean = (4 * walk + 12 * run) * gLean
	O.HeadYaw = O.HeadYaw - O.ChestTwist * 0.6

	-- Personality: idle stance, walk style, fidget.
	if form == "Heatblast" then
		arm(1, 10, 28, 35, idle)
		arm(2, 10, 28, 35, idle)
		arm(1, 100, 15, 95, fid)
		arm(2, 100, 15, 95, fid)
	elseif form == "FourArms" then
		O.Breath = 1 + 0.06 * sin(t * 1.6) * idle
		blend(O.ThighAbd, 1, 10, idle)
		blend(O.ThighAbd, 2, 10, idle)
		arm(1, 5, 26, 45, idle)
		arm(2, 5, 26, 45, idle)
		O.HipRoll = O.HipRoll + sin(ph) * 6 * walk
		arm(1, 0, 95, 125, fid)
		arm(2, 0, 95, 125, fid)
	elseif form == "XLR8" then
		O.Lean = O.Lean + 15 * idle
		leg(1, 12, 20 + max(0, sin(t * 14)) * 22, idle)
		arm(1, -50, 18, 20, run)
		arm(2, -50, 18, 20, run)
	elseif form == "WayBig" then
		O.Breath = 1 + 0.04 * sin(t) * idle
		arm(1, 80, -20, 90, fid)
		arm(2, 80, -20, 90, fid)
	elseif human then
		if id == "Jimmy" then
			arm(1, 0, 32, 95, idle * 0.7)
			O.HeadPitch = O.HeadPitch + 6 * run
			if fidT < 0.6 then
				arm(2, 95, -18, 135, fid)
				O.HeadPitch = O.HeadPitch + (-10 - O.HeadPitch) * fid
				O.HeadYaw = O.HeadYaw + (12 - O.HeadYaw) * fid
			else
				arm(2, 165, 8, 10, fid)
				O.HeadPitch = O.HeadPitch + (-14 - O.HeadPitch) * fid
				O.Bob = O.Bob + 2 * fid
			end
		elseif id == "Timmy" then
			O.Bob = O.Bob + abs(sin(t * 4.5)) * 2.5 * idle
			O.HeadYaw = sin(t * 0.9) * 26 * idle + O.HeadYaw * walk
			O.ShFwd[1] = O.ShFwd[1] + sin(t * 2.2) * 10 * idle
			O.ShFwd[2] = O.ShFwd[2] + sin(t * 2.2 + PI) * 10 * idle
			O.HeadRoll = sin(ph) * 6 * walk
			arm(2, 160, 20 + sin(t * 10) * 25, 25, fid)
			O.HeadPitch = O.HeadPitch + (-10 - O.HeadPitch) * fid
		elseif id == "Danny" then
			O.ShiftX = O.ShiftX + 3 * idle
			O.HipRoll = O.HipRoll + 5 * idle
			blend(O.ThighAbd, 1, 6, idle)
			blend(O.Knee, 2, 14, idle)
			O.HeadPitch = O.HeadPitch + 4
			arm(1, 65, -38, 115, fid)
			arm(2, 65, -38, 115, fid)
			O.HeadYaw = O.HeadYaw + (-15 - O.HeadYaw) * fid
		elseif id == "Jake" then
			local beat = t * 4
			O.Bob = O.Bob - abs(sin(beat)) * 3 * idle
			O.HeadPitch = O.HeadPitch + sin(beat * 2) * 5 * idle
			O.ChestTwist = O.ChestTwist + sin(t * 2) * 8 * idle
			O.Knee[1] = O.Knee[1] + (8 + abs(sin(beat)) * 10) * idle
			O.Knee[2] = O.Knee[2] + (8 + abs(sin(beat)) * 10) * idle
			O.ShAbd[1] = O.ShAbd[1] + 10 * walk
			O.ShAbd[2] = O.ShAbd[2] + 10 * walk
			O.HeadRoll = sin(ph) * 5 * walk
			arm(2, 175, 10, 40 + sin(t * 14) * 15, fid)
			arm(1, 60, -10, 110, fid)
		elseif id == "XJ9" then
			O.Breath = 1
			O.ShiftX = O.ShiftX * (1 - idle)
			O.HipRoll = O.HipRoll * (1 - idle)
			O.HeadYaw = round(sin(t * 0.45) * 2) * 15 * idle
			arm(1, -20, 42, 95, idle)
			arm(2, -20, 42, 95, idle)
			O.Elbow[1] = O.Elbow[1] * (1 - walk) + 5 * walk
			O.Elbow[2] = O.Elbow[2] * (1 - walk) + 5 * walk
			O.Bob = O.Bob + sin(ph * 2) * walk
			arm(2, 10, 150, 30 + sin(t * 12) * 28, fid)
			O.HeadRoll = O.HeadRoll + (15 - O.HeadRoll) * fid
		elseif id == "ElTigre" then
			leg(1, 22, 38, idle)
			leg(2, 22, 38, idle)
			blend(O.ThighAbd, 1, 8, idle)
			blend(O.ThighAbd, 2, 8, idle)
			O.Ankle[1] = O.Ankle[1] + 14 * idle
			O.Ankle[2] = O.Ankle[2] + 14 * idle
			O.Bob = O.Bob - 6 * idle
			O.Lean = O.Lean + 10 * idle
			arm(1, 55, 22, 95, idle)
			arm(2, 55, 22, 95, idle)
			O.ShiftX = O.ShiftX + sin(t * 2.5) * 3 * idle
			O.Knee[1] = O.Knee[1] + 15 * walk
			O.Knee[2] = O.Knee[2] + 15 * walk
			arm(1, -55, 15, 20, run)
			arm(2, -55, 15, 20, run)
			O.Lean = O.Lean + 22 * run
			arm(1, 30, 85, 70 + sin(t * 20) * 8, fid)
			arm(2, 30, 85, 70 + sin(t * 20) * 8, fid)
			O.HeadPitch = O.HeadPitch + (-12 - O.HeadPitch) * fid
		elseif id == "Ben" then
			arm(1, 0, 6, 20, idle * 0.5)
			arm(2, 0, 6, 20, idle * 0.5)
			arm(1, 75, -25, 105, fid)
			O.HeadPitch = O.HeadPitch + (18 - O.HeadPitch) * fid
			O.HeadYaw = O.HeadYaw + (20 - O.HeadYaw) * fid
			if fidT > 0.45 then
				arm(2, 60 + sin(t * 12) * 6, -30, 95, fid)
			end
		elseif id == "Aang" then
			O.Bob = O.Bob + (2 + sin(t * 2) * 2) * idle
			arm(2, 12, 22, 40, idle)
			arm(1, -40 * run, 15, 10, run)
			arm(2, -55 * run, 15, 10, run)
			O.Lean = O.Lean + 14 * run
			arm(2, 80, 10, 30, fid)
			if fid > 0.05 then
				O.StaffSpin = t * 720
			end
		end
	end

	-- Airborne.
	if air then
		local up = (st.VelY or 0) > 0 and 1 or 0.7
		O.Thigh[1], O.Thigh[2] = 50, 18
		O.Knee[1], O.Knee[2] = 80, 35
		for s = 1, 2 do
			O.ShAbd[s] = 55 * up
			O.ShFwd[s] = -15
			O.Elbow[s] = 35
		end
		O.Lean = 6
		if is("Timmy") and (st.VelY or 0) < 0 then
			O.ShAbd[1] = 120 + sin(t * 16) * 30
			O.ShAbd[2] = 120 + cos(t * 16) * 30
			O.Thigh[1] = 30 + sin(t * 14) * 25
			O.Thigh[2] = 30 - sin(t * 14) * 25
		elseif is("XJ9") then
			O.Thigh[1], O.Thigh[2], O.Knee[1], O.Knee[2] = 5, 5, 5, 5
		elseif is("Danny") or is("Aang") then
			O.Thigh[2] = 0
			O.Knee[2] = 15
			O.ShAbd[1], O.ShAbd[2] = 25, 25
		elseif is("Jimmy") and st.Jetpack then
			O.Thigh[1], O.Thigh[2], O.Knee[1], O.Knee[2] = 6, -4, 12, 12
			arm(1, 10, 38, 20, 1)
			arm(2, 10, 38, 20, 1)
			O.HeadPitch = -10
		end
		local flip = st.FlipTime or 0
		if flip > 0 then
			local f = 1 - flip / 0.5
			O.BodyPitch = 360 * (f * f * (3 - 2 * f))
			O.Thigh[1], O.Thigh[2], O.Knee[1], O.Knee[2] = 95, 95, 115, 115
			arm(1, 60, 20, 90, 1)
			arm(2, 60, 20, 90, 1)
			O.Bob = O.Bob + sin(PI * f) * 10
		end
	end
	if (st.LandTimer or 0) > 0 then
		O.Knee[1] = O.Knee[1] + 50 * land
		O.Knee[2] = O.Knee[2] + 50 * land
		O.Thigh[1] = O.Thigh[1] + 30 * land
		O.Thigh[2] = O.Thigh[2] + 30 * land
		O.Bob = O.Bob - 10 * land
		O.Lean = O.Lean + 12 * land
	end

	-- Wall slide: facing the wall, hands (or claws) on it.
	if wall then
		arm(1, 150, 25, 40, 1)
		arm(2, 150, 25, 40, 1)
		leg(1, 40, 50, 1)
		leg(2, 20, 30, 1)
		O.Lean = -5
		O.HeadPitch = -15
	end

	-- Ground pound.
	if pounding then
		leg(1, 75, 105, 1)
		leg(2, 75, 105, 1)
		arm(1, 170, 10, 30, 1)
		arm(2, 170, 10, 30, 1)
		O.Lean = 8
	end
	local pl = (st.PoundLand or 0) / 0.35
	if pl > 0 then
		leg(1, 70, 100, pl)
		leg(2, 40, 90, pl)
		arm(1, 55, 10, 10, pl)
		arm(2, 70, 5, 5, pl)
		O.Bob = O.Bob - 20 * pl
		O.Lean = O.Lean + 30 * pl
	end

	-- Dodge.
	if dodge then
		local dur = st.DodgeAir and 0.32 or 0.4
		local d = clamp(1 - dodgeT / dur, 0, 1)
		local s = sin(PI * d)
		local tuck = min(1, s * 1.8)
		if is("Danny") then
			O.Lean = 35
			arm(1, -40, 15, 10, 1)
			arm(2, -40, 15, 10, 1)
			leg(1, -20, 40, 1)
			leg(2, -10, 30, 1)
		elseif is("XJ9") then
			O.Lean = 15
			arm(1, 0, 40, 0, 1)
			arm(2, 0, 40, 0, 1)
			leg(1, 0, 0, 1)
			leg(2, 0, 0, 1)
		elseif is("Aang") then
			O.Spin = 360 * d
			arm(1, 10, 80, 10, 1)
			arm(2, 10, 80, 10, 1)
			leg(1, 50, 80, 1)
			leg(2, 0, 10, 1)
			O.Bob = O.Bob + 12 * s
		elseif is("ElTigre") then
			O.Lean = 50 * s
			arm(1, 150, 15, 20, 1)
			arm(2, 150, 15, 20, 1)
			leg(1, -30, 50, 1)
			leg(2, -15, 40, 1)
			O.Bob = O.Bob + 10 * s
		elseif form == "FourArms" then
			O.Lean = 30
			O.ChestTwist = 30
			arm(1, 60, 10, 110, 1)
			arm(2, 60, 10, 110, 1)
		elseif form == "XLR8" then
			O.Lean = 55
			arm(1, -60, 15, 15, 1)
			arm(2, -60, 15, 15, 1)
			O.Thigh[1] = 50 * sin(t * 40)
			O.Thigh[2] = -O.Thigh[1]
		else
			-- Forward roll / air somersault: tuck tight, rotate about the hips.
			O.BodyPitch = 360 * d
			leg(1, 100, 115, tuck)
			leg(2, 100, 115, tuck)
			arm(1, 70, 15, 100, tuck)
			arm(2, 70, 15, 100, tuck)
			if not st.DodgeAir then
				O.Bob = O.Bob - 27 * s
			end
		end
	end

	-- Parkour and combat moves (newer open-world action-game staples).
	local tm = t
	if st.Slide then
		-- Feet-first slide.
		O.Lean = -28
		leg(1, 85, 10, 1)
		leg(2, 35, 95, 1)
		arm(1, -35, 35, 20, 1)
		arm(2, 20, 30, 40, 1)
		O.Bob = O.Bob - 22
		O.HeadPitch = 10
	end
	if st.WallRun then
		-- Running along a wall: fast cycle, body tilted away from it.
		local p2 = tm * 14
		O.Thigh[1] = 45 * sin(p2)
		O.Thigh[2] = -45 * sin(p2)
		O.Knee[1] = 20 + 60 * max(0, cos(p2))
		O.Knee[2] = 20 + 60 * max(0, -cos(p2))
		O.ShFwd[1] = -40 * sin(p2)
		O.ShFwd[2] = 40 * sin(p2)
		O.Lean = 12
		O.BodyRoll = -(st.WallSide or 1) * 28
	end
	if st.Climb then
		-- Scrambling straight up a wall, hand over hand.
		local p3 = tm * 10
		arm(1, 150 + sin(p3) * 25, 20, 40 + sin(p3) * 30, 1)
		arm(2, 150 - sin(p3) * 25, 20, 40 - sin(p3) * 30, 1)
		leg(1, 55 + sin(p3) * 25, 70, 1)
		leg(2, 55 - sin(p3) * 25, 70, 1)
		O.Lean = -8
		O.HeadPitch = -20
	end
	if st.Swing then
		-- Swinging on a line: lead arm up holding it, legs swing with the arc.
		arm(2, 175, 5, 10, 1)
		arm(1, 30, 40, 40, 1)
		local swingK = clamp((st.VelY or 0) / 40, -1, 1)
		leg(1, 30 - swingK * 30, 40, 1)
		leg(2, 10 - swingK * 30, 25, 1)
		O.Lean = -swingK * 15
	end
	if (st.Counter or 0) > 0 then
		-- Counter strike: quick backhand and lean in.
		local c = st.Counter / 0.3
		arm(2, 100, -40 + 80 * (1 - c), 10, 1)
		O.ChestTwist = O.ChestTwist + 35 * c
		O.Lean = O.Lean + 12
	elseif (st.Block or 0) > 0 then
		arm(1, 95, -35, 110, 1)
		arm(2, 95, -35, 110, 1)
		O.Lean = O.Lean - 5
	end
	if (st.Takedown or 0) > 0 then
		-- Special takedown: leap and a two-handed hammer blow.
		local k = 1 - st.Takedown / 0.6
		arm(1, 170 - 140 * k, 10, 20, 1)
		arm(2, 170 - 140 * k, 10, 20, 1)
		O.BodyPitch = O.BodyPitch + 30 * sin(PI * k)
		O.Bob = O.Bob + 15 * sin(PI * k)
	end

	-- Flight.
	if flying then
		local fwd = clamp(speed3 / 50, 0, 1)
		local hover = sin(t * 3)
		local travel = clamp(80 - (st.FlyPitch or 0) * 0.9, 0, 170)
		local roll = st.FlyBank or 0
		if dodgeT > 0 and st.DodgeAir then
			roll = roll + 360 * (1 - dodgeT / 0.45) * (st.DodgeSide or 1)
		end
		local lift = (st.TakeoffTime or 0) / 0.45
		O.Lean = 0
		O.BodyRoll = roll
		if is("Timmy") then
			-- Surfing the cloud-board.
			O.Spin = -65
			O.HeadYaw = 55
			O.BodyPitch = 14 * fwd
			O.BodyRoll = (st.FlyBank or 0) * 0.8
			leg(1, 25, 40, 1)
			leg(2, 25, 40, 1)
			O.ThighAbd[1], O.ThighAbd[2] = 16, 16
			arm(1, 10, 75 + sin(t * 1.5) * 10 - (st.FlyBank or 0) * 0.6, 20, 1)
			arm(2, 10, 75 - sin(t * 1.5) * 10 + (st.FlyBank or 0) * 0.6, 20, 1)
			O.Bob = O.Bob + hover * 2
		elseif is("XJ9") then
			-- Rocket pose.
			O.BodyPitch = travel * fwd
			O.HeadPitch = -O.BodyPitch * 0.55
			arm(1, -20 * fwd + 10 * (1 - fwd), 14 + 22 * (1 - fwd), 5, 1)
			arm(2, -20 * fwd + 10 * (1 - fwd), 14 + 22 * (1 - fwd), 5, 1)
			leg(1, 0, 2, 1)
			leg(2, 0, 2, 1)
			O.ThighAbd[1], O.ThighAbd[2] = -2, -2
			O.Bob = O.Bob + hover * 3 * (1 - fwd)
			if lift > 0 then
				arm(2, 175, 5, 5, lift)
			end
		else
			-- Superhero flight (Danny; Jake's dragon is a separate model).
			O.BodyPitch = travel * fwd
			O.HeadPitch = -O.BodyPitch * 0.6
			leg(1, -8 + hover * 6, 25, 1)
			leg(2, -2 - hover * 6, 15, 1)
			arm(2, 40 + 130 * fwd, 8, 5, 1)
			arm(1, -25, 14, 20, 1)
			if st.Boosting then
				arm(1, 40 + 130 * fwd, 8, 5, 1)
			end
			arm(1, 10, 30, 30, 1 - fwd)
			arm(2, 10, 30, 30, 1 - fwd)
			O.Bob = O.Bob + hover * 4 * (1 - fwd)
			if lift > 0 then
				arm(2, 178, 5, 5, lift)
			end
		end
	end
	if gliding then
		local fwd = clamp(speed3 / 40, 0, 1)
		if form == "Heatblast" then
			arm(1, -10, 22, 0, 1)
			arm(2, -10, 22, 0, 1)
			leg(1, 10, 20, 1)
			leg(2, -5, 10, 1)
			O.BodyRoll = (st.FlyBank or 0) * 0.5
		else
			-- Aang lies prone under the glider.
			O.BodyPitch = (70 - (st.FlyPitch or 0) * 0.5) * fwd
			O.BodyRoll = st.FlyBank or 0
			O.HeadPitch = -O.BodyPitch * 0.6
			arm(1, 170, 18, 15, 1)
			arm(2, 170, 18, 15, 1)
			leg(1, -6, 10, 1)
			leg(2, 4, 15, 1)
		end
	end

	-- Attacks: each hero, each combo hit.
	if atk > 0 then
		local S = (step % 2 == 0) and 2 or 1
		local sd = (S == 2) and 1 or -1
		local fin = step == 2
		local sweep = 1 - 2 * atkA
		if form == "FourArms" then
			if fin then
				local v = 170 - 120 * atkA
				arm(1, v, 10, 20, atk)
				arm(2, v, 10, 20, atk)
				O.Lean = O.Lean + 20 * atk
			else
				arm(S, 95, 0, 8, atk)
				O.ChestTwist = O.ChestTwist + sd * 28 * atk
				O.Lean = O.Lean + 8 * atk
			end
		elseif form == "Heatblast" then
			local throw
			if atkA < 0.3 then
				throw = -40 * (atkA / 0.3)
			else
				throw = 140 * sin(PI * (atkA - 0.3) / 0.7)
			end
			arm(S, throw, 10, 30, 1)
			if fin then
				arm(3 - S, throw, 10, 30, 1)
			end
			O.ChestTwist = O.ChestTwist + sd * 20 * atk
		elseif form == "XLR8" then
			local q = (floor(atkA * 4) % 2) + 1
			arm(q, 90 * sin(PI * fmod(atkA * 4, 1)), 0, 5, 1)
			O.Lean = O.Lean + 15 * atk
		elseif form == "WayBig" then
			leg(2, 70 * atk, 60 * atk, 1)
			arm(1, 30, 40, 20, atk)
			arm(2, 30, 40, 20, atk)
		elseif human then
			if id == "Jimmy" then
				local aim = min(1, atk * 2)
				local recoil = 0
				if atkA < 0.3 then
					recoil = sin(PI * atkA / 0.3)
				end
				arm(2, 88 + 15 * recoil, 2, 4 + 20 * recoil, aim)
				O.ChestTwist = O.ChestTwist + 18 * aim
				if fin then
					arm(1, 80, -30, 45, aim)
					O.Lean = O.Lean - 10 * recoil
				end
			elseif id == "Timmy" then
				if fin then
					arm(2, 170, sin(atkA * 2 * PI) * 40, 20, atk)
					O.Bob = O.Bob + 6 * atk
				elseif step == 0 then
					arm(2, 120, 70 - 100 * atkA, 25, atk)
				else
					arm(2, 120, -30 + 100 * atkA, 25, atk)
				end
			elseif id == "Danny" then
				if fin then
					arm(1, 92, 0, 5, atk)
					arm(2, 92, 0, 5, atk)
					O.Lean = O.Lean + 10 * atk
				else
					arm(S, 92, 0, 5, atk)
					O.ChestTwist = O.ChestTwist + sd * 22 * atk
				end
			elseif id == "Jake" then
				if fin then
					local v = 170 - 130 * atkA
					arm(1, v, 15, 15, min(1, atk * 2))
					arm(2, v, 15, 15, min(1, atk * 2))
					O.Lean = O.Lean + 18 * atk
				else
					arm(S, 80, 70 * sweep, 15, atk)
					O.ChestTwist = O.ChestTwist + sd * 30 * sweep * atk
					O.Lean = O.Lean + 8 * atk
				end
			elseif id == "ElTigre" then
				if fin then
					O.Spin = 360 * atkA
					arm(1, 20, 90, 10, atk)
					arm(2, 20, 90, 10, atk)
				else
					arm(S, 70, 60 * sweep, 20, atk)
					O.ChestTwist = O.ChestTwist + sd * 30 * sweep * atk
					O.Lean = O.Lean + 12 * atk
				end
			elseif id == "XJ9" then
				arm(2, 90, 2 + sin(t * 70) * 2, 0, min(1, atk * 3))
				O.ChestTwist = O.ChestTwist + 20 * atk
			elseif id == "Ben" then
				if fin then
					leg(2, 95, 15, atk)
					O.Lean = O.Lean - 12 * atk
					arm(1, 10, 40, 30, atk)
					arm(2, 10, 40, 30, atk)
				else
					arm(S, 95, 0, 5, atk)
					O.ChestTwist = O.ChestTwist + sd * 25 * atk
					O.Lean = O.Lean + 8 * atk
				end
			elseif id == "Aang" then
				if fin then
					O.Spin = 360 * atkA
					arm(1, 30, 70, 10, atk)
					arm(2, 30, 70, 10, atk)
					O.StaffSpin = 720 * atkA
				else
					arm(S, 90, -5, 5, atk)
					O.ChestTwist = O.ChestTwist + sd * 20 * atk
					O.Lean = O.Lean + 6 * atk
				end
			end
		end
	end
	if st.Breath then
		O.HeadPitch = O.HeadPitch - 12
	end

	-- Emote: the hero's signature pose.
	if emW > 0 then
		local w = emW
		local function head(key, v)
			O[key] = O[key] + (v - O[key]) * w
		end
		if form == "FourArms" then
			arm(1, 0, 95, 130, w)
			arm(2, 0, 95, 130, w)
			head("HeadPitch", -10)
		elseif form == "Heatblast" then
			arm(1, 10, 140, 30, w)
			arm(2, 10, 140, 30, w)
		elseif form == "XLR8" then
			arm(2, 70, 10, 10, w)
			head("Lean", 20)
		elseif form == "WayBig" then
			arm(1, 80, -20, 90, w)
			arm(2, 80, -20, 90, w)
		elseif human then
			if id == "Jimmy" then
				arm(2, 170, -5, 10, w)
				arm(1, 0, 35, 100, w)
				head("HeadPitch", -15)
				head("HeadRoll", 8)
				O.Bob = O.Bob + 2 * w
			elseif id == "Timmy" then
				arm(1, 10, 150 + sin(t * 14) * 12, 20, w)
				arm(2, 10, 150 + cos(t * 14) * 12, 20, w)
				O.Bob = O.Bob + abs(sin(t * 7)) * 9 * w
			elseif id == "Danny" then
				if em < 0.45 then
					arm(1, 70, -40, 60, w)
					arm(2, 70, -40, 60, w)
					head("HeadPitch", 10)
				else
					arm(1, 10, 110, 5, w)
					arm(2, 10, 110, 5, w)
					head("HeadPitch", -10)
					O.Bob = O.Bob + 3 * w
				end
			elseif id == "Jake" then
				arm(2, 175, 10, 25 + sin(t * 12) * 15, w)
				arm(1, 0, 35, 100, w)
				leg(1, 15, 20, w)
				leg(2, 15, 20, w)
				head("HeadPitch", -10)
			elseif id == "XJ9" then
				arm(2, 10, 150, 35 + sin(t * 12) * 28, w)
				arm(1, -20, 42, 95, w)
				head("HeadRoll", 15)
			elseif id == "ElTigre" then
				arm(1, 30, 120, 70, w)
				arm(2, 30, 120, 70, w)
				leg(1, 30, 40, w)
				leg(2, 30, 40, w)
				blend(O.ThighAbd, 1, 15, w)
				blend(O.ThighAbd, 2, 15, w)
				head("HeadPitch", -18)
			elseif id == "Ben" then
				arm(1, 80, -30, 100, w)
				if em < 0.5 then
					arm(2, 110, -10, 100, w)
				else
					arm(2, 70, -35, 95, w)
				end
				head("HeadPitch", 15)
			elseif id == "Aang" then
				local bow = sin(PI * clamp((em - 0.1) / 0.6, 0, 1))
				head("Lean", 45 * bow)
				arm(1, 75, -32, 110, w)
				arm(2, 75, -32, 110, w)
				head("HeadPitch", 15)
				if em > 0.7 then
					O.StaffSpin = t * 900
				end
			end
		end
	end
	if hurt > 0 then
		O.Lean = O.Lean - 15 * hurt
		O.HeadPitch = O.HeadPitch - 14 * hurt
		O.ShAbd[1] = O.ShAbd[1] + 30 * hurt
		O.ShAbd[2] = O.ShAbd[2] + 30 * hurt
	end
	return O
end

return Pose
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX18816"><Properties>
<string name="Name">Progression</string>
<ProtectedString name="Source"><![CDATA[--!nonstrict
-- Pure progression rules shared by server (authoritative) and client (UI):
-- XP curve and level-ups, skill effects, shop prices. Tested by
-- Roblox/tools/test_logic.py.

local Progression = {}

function Progression.xpToNext(level, config)
	local p = config.Progression
	return math.floor(p.XpBase * p.XpGrowth ^ (level - 1))
end

-- Adds XP to a profile table ({ Level, Xp, SkillPoints }); returns levels gained.
function Progression.addXp(profile, amount, config)
	local gained = 0
	profile.Xp = profile.Xp + math.max(0, math.floor(amount))
	while profile.Level < config.Progression.MaxLevel and profile.Xp >= Progression.xpToNext(profile.Level, config) do
		profile.Xp = profile.Xp - Progression.xpToNext(profile.Level, config)
		profile.Level = profile.Level + 1
		profile.SkillPoints = profile.SkillPoints + 1
		gained = gained + 1
	end
	if profile.Level >= config.Progression.MaxLevel then
		profile.Xp = 0
	end
	return gained
end

-- Spends a point on a skill. Returns true on success.
function Progression.buySkill(profile, skill, config)
	local def = config.Skills[skill]
	if not def or profile.SkillPoints < 1 then
		return false
	end
	local rank = profile.Skills[skill] or 0
	if rank >= def.Max then
		return false
	end
	profile.Skills[skill] = rank + 1
	profile.SkillPoints = profile.SkillPoints - 1
	return true
end

-- Multipliers and bonuses from skill ranks.
function Progression.effects(skills)
	local function r(name)
		return (skills and skills[name]) or 0
	end
	return {
		MaxHealth = 12 * r("Vitality"),
		Damage = 1 + 0.08 * r("Power"),
		Energy = 15 * r("Reserves"),
		Flight = 1 + 0.08 * r("Aero"),
		Walk = 1 + 0.06 * r("Agility"),
		Meter = 1 + 0.12 * r("Focus"),
	}
end

function Progression.skillPointPrice(bought, config)
	return math.floor(config.Progression.SkillPrice * config.Progression.SkillPriceGrowth ^ bought)
end

return Progression
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX18817"><Properties>
<string name="Name">Remotes</string>
<ProtectedString name="Source"><![CDATA[--!nonstrict
-- Every remote in the game, created by the server (Systems/Net) at startup.
-- Client -> server requests are validated and rate limited there.
return {
	Events = {
		"State",        -- client: own movement state (flying, dodge, emote...) for animation replication
		"Attack",       -- client: aim direction
		"Ability",      -- client: ability name, aim direction, held flag
		"Omnitrix",     -- client: "dial" | "cancel" | "slot" n | "glitch" | "overclock"
		"SelectHero",   -- client: hero id (at a dimensional terminal)
		"Travel",       -- client: level name (at a terminal) or "Nexus" (recall anywhere)
		"Pound",        -- client: ground pound landed
		"Fx",           -- server -> clients: visual effects
		"Notify",       -- server -> client: messages, banners
		"OpenTerminal", -- server -> client: show the hero/travel menu
		"Counter",      -- client: counter / parry (or block)
		"Takedown",     -- client: special takedown (needs a high combo)
		"Skill",        -- client: spend a skill point
		"Shop",         -- client: buy an item at the Gear Locker
		"OpenShop",     -- server -> client: show the shop
		"Objective",    -- server -> client: mission objective / waypoint
	},
	Functions = {},
}
]]></ProtectedString>
</Properties>
</Item>
</Item>
</Item>
<Item class="ServerScriptService" referent="RBX18818"><Properties>
<string name="Name">ServerScriptService</string>
</Properties>
<Item class="Script" referent="RBX18819"><Properties>
<string name="Name">Server</string>
<ProtectedString name="Source"><![CDATA[--!nonstrict
-- Server entry point: requires every system, then runs init (wiring, remotes)
-- for all of them before any start (loops, connections that need others).

local systems = {}
local order = {
	"Net", "Players", "Profiles", "Heroes", "World", "Progression", "Heat", "Enemies", "Combat", "Boss",
	"Collectibles", "Courses", "Missions", "Traffic",
}
for _, name in ipairs(order) do
	local module = script:WaitForChild("Systems"):FindFirstChild(name)
	if module then
		systems[name] = require(module)
	else
		warn("[MultiverseToons] missing system " .. name)
	end
end
for _, name in ipairs(order) do
	local system = systems[name]
	if system and type(system.init) == "function" then
		system.init(systems)
	end
end
for _, name in ipairs(order) do
	local system = systems[name]
	if system and type(system.start) == "function" then
		task.spawn(system.start)
	end
end
print("[MultiverseToons] server ready")
]]></ProtectedString>
<token name="RunContext">0</token>
</Properties>
<Item class="Folder" referent="RBX18820"><Properties>
<string name="Name">Lib</string>
</Properties>
<Item class="ModuleScript" referent="RBX18821"><Properties>
<string name="Name">Looks</string>
<ProtectedString name="Source"><![CDATA[--!nonstrict
-- Dresses a player's R15 character as a hero (or one of Ben's aliens), built
-- from parts so no uploaded assets are needed: body colours, cartoon
-- proportions (big round toon head), a face drawn with GUI frames, and each
-- hero's gear (hair, hats, props, Jake's dragon, Danny's ghost tail, Aang's
-- glider...). Gear that only shows in some states carries a "ShowWhen"
-- attribute that Client/Controllers/Animator toggles.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))

local Looks = {}

local GEAR = "HeroGear"
local WHITE = Color3.fromRGB(245, 245, 250)
local BLACK = Color3.fromRGB(30, 30, 36)

local R15_PARTS = {
	"Head", "UpperTorso", "LowerTorso", "LeftUpperArm", "LeftLowerArm", "LeftHand", "RightUpperArm",
	"RightLowerArm", "RightHand", "LeftUpperLeg", "LeftLowerLeg", "LeftFoot", "RightUpperLeg", "RightLowerLeg", "RightFoot",
}

-- Part factory ---------------------------------------------------------------

local function newPart(folder, name, size, color, material)
	local p = Instance.new("Part")
	p.Name = name
	p.Size = size
	p.Color = color
	p.Material = material or Enum.Material.SmoothPlastic
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.Massless = true
	p.CastShadow = true
	p.Parent = folder
	return p
end

local function weld(p, to, c0)
	local w = Instance.new("Weld")
	w.Name = "GearWeld"
	w.Part0 = to
	w.Part1 = p
	w.C0 = c0
	w.Parent = p
	return w
end

-- A joint the client animates (wings, extra arms, staff).
local function motor(p, to, c0, name)
	local m = Instance.new("Motor6D")
	m.Name = name
	m.Part0 = to
	m.Part1 = p
	m.C0 = c0
	m.Parent = to
	return m
end

local function ball(folder, to, c0, size, color, neon)
	local p = newPart(folder, "Ball", size, color, neon and Enum.Material.Neon or nil)
	local mesh = Instance.new("SpecialMesh")
	mesh.MeshType = Enum.MeshType.Sphere
	mesh.Parent = p
	weld(p, to, c0)
	return p
end

local function box(folder, to, c0, size, color, neon)
	local p = newPart(folder, "Box", size, color, neon and Enum.Material.Neon or nil)
	weld(p, to, c0)
	return p
end

-- Vertical cylinder centred on c0 (Roblox cylinders run along X).
local function cyl(folder, to, c0, height, diameter, color, neon)
	local p = newPart(folder, "Cyl", Vector3.new(height, diameter, diameter), color, neon and Enum.Material.Neon or nil)
	p.Shape = Enum.PartType.Cylinder
	weld(p, to, c0 * CFrame.Angles(0, 0, math.pi / 2))
	return p
end

-- Cone pointing along c0's +Y from its base: stacked, tapering cylinders.
local function cone(folder, to, c0, height, radius, color, neon)
	local tiers = 3
	for i = 0, tiers - 1 do
		local r = radius * (1 - i / tiers)
		local h = height / tiers
		cyl(folder, to, c0 * CFrame.new(0, h * (i + 0.5), 0), h, r * 2, color, neon)
	end
	ball(folder, to, c0 * CFrame.new(0, height, 0), Vector3.new(radius * 0.5, radius * 0.5, radius * 0.5), color, neon)
end

local function showWhen(folder, condition)
	for _, d in ipairs(folder:GetChildren()) do
		if d:IsA("BasePart") and d:GetAttribute("ShowWhen") == nil then
			d:SetAttribute("ShowWhen", condition)
		end
	end
end

-- Face -----------------------------------------------------------------------

local function frame(parent, name, pos, size, color, round, z)
	local f = Instance.new("Frame")
	f.Name = name
	f.AnchorPoint = Vector2.new(0.5, 0.5)
	f.Position = UDim2.fromScale(pos.X, pos.Y)
	f.Size = UDim2.fromScale(size.X, size.Y)
	f.BackgroundColor3 = color
	f.BorderSizePixel = 0
	f.ZIndex = z or 2
	if round then
		local c = Instance.new("UICorner")
		c.CornerRadius = UDim.new(round, 0)
		c.Parent = f
	end
	f.Parent = parent
	return f
end

local function buildFace(head, look, faceStyle)
	local gui = Instance.new("SurfaceGui")
	gui.Name = "Face"
	gui.Face = Enum.NormalId.Front
	gui.SizingMode = Enum.SurfaceGuiSizingMode.FixedSize
	gui.CanvasSize = Vector2.new(200, 200)
	gui.LightInfluence = 0.6
	gui.Parent = head
	if look.FaceImage then
		local img = Instance.new("ImageLabel")
		img.BackgroundTransparency = 1
		img.Size = UDim2.fromScale(1, 1)
		img.Image = look.FaceImage
		img.Parent = gui
		return
	end
	local eyeY = 0.44
	local eyeW, eyeH = 0.22, 0.28
	if look.Robot then
		eyeW, eyeH = 0.27, 0.32
	end
	if look.Mask then
		frame(gui, "Mask", Vector2.new(0.5, eyeY), Vector2.new(0.95, 0.36), look.Mask, 0.4, 1)
	end
	local count = faceStyle == "FourEyes" and 2 or 1
	for row = 1, count do
		local y = eyeY + (row - 1) * 0.16 - (count - 1) * 0.08
		for side = 1, 2 do
			local x = side == 1 and 0.32 or 0.68
			local name = (side == 1 and "EyeL" or "EyeR") .. (row > 1 and tostring(row) or "")
			if look.GlowEyes or faceStyle == "Glow" then
				frame(gui, name, Vector2.new(x, y), Vector2.new(eyeW, eyeH * 0.8), look.Eyes, 0.5, 3)
			else
				local eye = frame(gui, name, Vector2.new(x, y), Vector2.new(eyeW, eyeH * (count > 1 and 0.6 or 1)), WHITE, 0.5, 3)
				local iris = frame(eye, "Iris", Vector2.new(0.5 + (side == 1 and 0.08 or -0.08), 0.55), Vector2.new(0.62, 0.62), look.Eyes, 0.5, 4)
				iris.SizeConstraint = Enum.SizeConstraint.RelativeXX
				local pupil = frame(iris, "Pupil", Vector2.new(0.5, 0.5), Vector2.new(0.5, 0.5), BLACK, 0.5, 5)
				frame(pupil, "Shine", Vector2.new(0.3, 0.3), Vector2.new(0.4, 0.4), WHITE, 0.5, 6)
			end
		end
	end
	if not look.Robot then
		for side = 1, 2 do
			local x = side == 1 and 0.32 or 0.68
			local brow = frame(gui, side == 1 and "BrowL" or "BrowR", Vector2.new(x, eyeY - 0.2), Vector2.new(0.2, 0.045), look.Brows, 0.5, 3)
			brow.Rotation = side == 1 and -8 or 8
		end
	end
	local mouth = frame(gui, "Mouth", Vector2.new(0.5, 0.74), Vector2.new(0.3, 0.1), Color3.fromRGB(150, 40, 50), 0.5, 3)
	if look.BigTeeth then
		frame(mouth, "ToothL", Vector2.new(0.42, 0.3), Vector2.new(0.14, 0.7), WHITE, 0.2, 4)
		frame(mouth, "ToothR", Vector2.new(0.58, 0.3), Vector2.new(0.14, 0.7), WHITE, 0.2, 4)
	else
		frame(mouth, "Teeth", Vector2.new(0.5, 0.25), Vector2.new(0.8, 0.35), WHITE, 0.3, 4)
	end
end

-- Body -----------------------------------------------------------------------

local function colorBody(character, look)
	local map = {
		Head = look.Skin, UpperTorso = look.Shirt, LowerTorso = look.Pants,
		LeftUpperArm = look.Sleeve, RightUpperArm = look.Sleeve, LeftLowerArm = look.Forearm, RightLowerArm = look.Forearm,
		LeftHand = look.Hand, RightHand = look.Hand, LeftUpperLeg = look.Pants, RightUpperLeg = look.Pants,
		LeftLowerLeg = look.Shin, RightLowerLeg = look.Shin, LeftFoot = look.Shoe, RightFoot = look.Shoe,
		-- R6 fallback
		Torso = look.Shirt, ["Left Arm"] = look.Sleeve, ["Right Arm"] = look.Sleeve, ["Left Leg"] = look.Pants, ["Right Leg"] = look.Pants,
	}
	local bodyColors = character:FindFirstChildOfClass("BodyColors")
	if bodyColors then
		bodyColors:Destroy()
	end
	for name, color in pairs(map) do
		local p = character:FindFirstChild(name)
		if p and p:IsA("BasePart") then
			p.Color = color
			p.Material = Enum.Material.SmoothPlastic
		end
	end
end

local function setScale(humanoid, height, width, head)
	local function set(name, value)
		local v = humanoid:FindFirstChild(name)
		if not v then
			v = Instance.new("NumberValue")
			v.Name = name
			v.Parent = humanoid
		end
		v.Value = value
	end
	set("BodyHeightScale", height)
	set("BodyWidthScale", width)
	set("BodyDepthScale", width)
	set("HeadScale", head)
end

-- Look for the active form (Ben's aliens recolour the whole body).
local function formLook(form)
	local b, a = form.Body, form.Accent
	local look = {
		Skin = b, Shirt = b, Sleeve = b, Forearm = b, Hand = b, Pants = b, Shin = b, Shoe = b,
		HeadScale = 1.1, Height = form.Scale, Width = form.Scale, Eyes = Color3.fromRGB(90, 255, 90), Brows = a,
	}
	if form.Id == "Heatblast" then
		look.Hand = Color3.fromRGB(255, 190, 60)
		look.Shoe = Color3.fromRGB(120, 35, 20)
		look.Eyes = Color3.fromRGB(255, 240, 120)
		look.GlowEyes = true
	elseif form.Id == "FourArms" then
		look.Shirt = WHITE
		look.Pants, look.Shin, look.Shoe = a, a, a
		look.Eyes = Color3.fromRGB(255, 220, 80)
		look.Width = form.Scale * 1.15
	elseif form.Id == "XLR8" then
		look.Pants, look.Shin, look.Shoe = a, a, a
		look.Robot = true
	elseif form.Id == "WayBig" then
		look.Pants, look.Shin = a, a
		look.Eyes = Color3.fromRGB(255, 240, 120)
		look.GlowEyes = true
	end
	return look
end

-- Gear -----------------------------------------------------------------------

local function heroGear(folder, parts, heroId, look, d)
	local head, torso, lower = parts.ToonHead, parts.UpperTorso, parts.LowerTorso
	local rh, lh = parts.RightHand, parts.LeftHand
	local r = d * 0.5
	local tz = torso and torso.Size.Z * 0.5 or 0.5
	if heroId == "Jimmy" then
		local hair = Color3.fromRGB(125, 72, 35)
		ball(folder, head, CFrame.new(0, r * 0.45, r * 0.08), Vector3.new(d * 1.05, d * 0.7, d * 1.0), hair)
		cone(folder, head, CFrame.new(0, r * 0.7, 0) * CFrame.Angles(math.rad(-12), 0, 0), r * 1.2, r * 0.75, hair)
		cone(folder, head, CFrame.new(0, r * 1.7, -r * 0.25) * CFrame.Angles(math.rad(-60), 0, 0), r * 0.6, r * 0.35, hair)
		box(folder, torso, CFrame.new(0, 0.15, -tz - 0.02), Vector3.new(0.35, 0.35, 0.05), Color3.fromRGB(255, 220, 60), true)
		-- Shrink ray.
		box(folder, rh, CFrame.new(0, -0.35, -0.15), Vector3.new(0.3, 0.45, 0.55), Color3.fromRGB(120, 175, 140))
		ball(folder, rh, CFrame.new(0, -0.35, -0.55), Vector3.new(0.3, 0.3, 0.3), Color3.fromRGB(255, 70, 70), true)
		-- Jetpack flames (Q).
		for _, side in ipairs({ -0.3, 0.3 }) do
			cyl(folder, torso, CFrame.new(side, 0, tz + 0.25), 1.0, 0.4, Color3.fromRGB(210, 215, 225))
			local flame = newPart(folder, "JetFlame", Vector3.new(0.3, 0.9, 0.3), Color3.fromRGB(255, 170, 40), Enum.Material.Neon)
			weld(flame, torso, CFrame.new(side, -0.9, tz + 0.25))
			flame:SetAttribute("ShowWhen", "Jetpack")
		end
	elseif heroId == "Timmy" then
		local pink = Color3.fromRGB(240, 110, 160)
		cyl(folder, head, CFrame.new(0, r * 0.62, 0), r * 0.35, d * 1.06, pink)
		ball(folder, head, CFrame.new(0, r * 0.85, r * 0.05), Vector3.new(d * 0.98, d * 0.5, d * 0.98), pink)
		box(folder, head, CFrame.new(0, r * 0.55, -r * 0.95) * CFrame.Angles(math.rad(10), 0, 0), Vector3.new(d * 0.8, 0.08, d * 0.45), pink)
		for _, side in ipairs({ -1, 1 }) do
			ball(folder, head, CFrame.new(side * r * 0.95, r * 0.2, r * 0.1), Vector3.new(r * 0.45, r * 0.45, r * 0.5), Color3.fromRGB(120, 70, 35))
		end
		-- Wand.
		cyl(folder, rh, CFrame.new(0, -0.6, 0), 1.1, 0.1, BLACK)
		local star = ball(folder, rh, CFrame.new(0, -1.2, 0), Vector3.new(0.4, 0.4, 0.4), Color3.fromRGB(255, 230, 70), true)
		local light = Instance.new("PointLight")
		light.Color = star.Color
		light.Range = 6
		light.Parent = star
		-- Cloud-board while flying.
		local cloud = newPart(folder, "Cloud", Vector3.new(4.5, 1.2, 3), WHITE, Enum.Material.SmoothPlastic)
		local mesh = Instance.new("SpecialMesh")
		mesh.MeshType = Enum.MeshType.Sphere
		mesh.Parent = cloud
		weld(cloud, lower, CFrame.new(0, -lower.Size.Y * 0.5 - parts.LegLength - 0.3, 0))
		cloud:SetAttribute("ShowWhen", "Flying")
	elseif heroId == "Danny" then
		ball(folder, head, CFrame.new(0, r * 0.45, r * 0.06), Vector3.new(d * 1.07, d * 0.65, d * 1.05), WHITE)
		for i = -1, 1 do
			cone(folder, head, CFrame.new(i * r * 0.35, r * 0.4, r * 0.85) * CFrame.Angles(math.rad(110), 0, math.rad(i * 20)), r * 0.7, r * 0.25, WHITE)
		end
		box(folder, torso, CFrame.new(0, 0.1, -tz - 0.02), Vector3.new(0.55, 0.5, 0.05), WHITE)
		box(folder, torso, CFrame.new(0.06, 0.1, -tz - 0.04), Vector3.new(0.18, 0.32, 0.05), BLACK)
		for _, hand in ipairs({ lh, rh }) do
			local glow = ball(folder, hand, CFrame.new(0, -0.1, 0), Vector3.new(0.75, 0.75, 0.75), Color3.fromRGB(110, 255, 140), true)
			glow.Transparency = 0.35
			local light = Instance.new("PointLight")
			light.Color = glow.Color
			light.Range = 7
			light.Parent = glow
		end
		-- Ghost tail replaces the legs in flight.
		local tail = Instance.new("Folder")
		tail.Name = "GhostTail"
		tail.Parent = folder
		cone(tail, lower, CFrame.new(0, -lower.Size.Y * 0.4, 0) * CFrame.Angles(math.pi, 0, 0), parts.LegLength * 1.1, lower.Size.X * 0.6, BLACK)
		cone(tail, lower, CFrame.new(0, -lower.Size.Y * 0.4 - parts.LegLength * 0.9, 0.3) * CFrame.Angles(math.pi + 0.3, 0, 0), parts.LegLength * 0.5, lower.Size.X * 0.3, Color3.fromRGB(120, 255, 200), true)
		showWhen(tail, "Flying")
		for _, d2 in ipairs(tail:GetChildren()) do
			d2.Parent = folder
		end
		tail:Destroy()
	elseif heroId == "Jake" then
		local hair, green = Color3.fromRGB(20, 20, 22), Color3.fromRGB(80, 220, 120)
		ball(folder, head, CFrame.new(0, r * 0.5, r * 0.06), Vector3.new(d * 1.06, d * 0.6, d * 1.03), hair)
		for k = 0, 5 do
			local x = (-2.5 + k) * r * 0.22
			cone(folder, head, CFrame.new(x, r * 0.9, r * (k % 2) * 0.15) * CFrame.Angles(math.rad(-15 - k * 3), 0, math.rad(-x * 30)), r * 0.7, r * 0.18, k % 2 == 1 and green or hair)
		end
		box(folder, torso, CFrame.new(0, 0, -tz - 0.02), Vector3.new(0.15, torso.Size.Y * 0.8, 0.05), Color3.fromRGB(130, 130, 140))
	elseif heroId == "XJ9" then
		local teal, joint = Color3.fromRGB(70, 190, 205), Color3.fromRGB(60, 70, 95)
		box(folder, head, CFrame.new(0, r * 0.95, 0), Vector3.new(d * 0.85, 0.15, d * 0.9), teal)
		for _, side in ipairs({ -1, 1 }) do
			box(folder, head, CFrame.new(side * r * 1.15, r * 0.95, 0.1) * CFrame.Angles(0, 0, math.rad(side * 30)), Vector3.new(d * 0.7, 0.12, d * 0.45), teal)
			cyl(folder, head, CFrame.new(side * r * 0.98, 0, 0) * CFrame.Angles(0, 0, math.pi / 2), 0.15, d * 0.35, joint)
		end
		cone(folder, lower, CFrame.new(0, lower.Size.Y * 0.4, 0) * CFrame.Angles(math.pi, 0, 0), lower.Size.Y * 1.4, lower.Size.X * 0.85, teal)
		box(folder, torso, CFrame.new(0, torso.Size.Y * 0.1, 0), Vector3.new(torso.Size.X * 1.05, 0.2, torso.Size.Z * 1.05), teal)
		for _, foot in ipairs({ parts.LeftFoot, parts.RightFoot }) do
			local flame = newPart(folder, "RocketFlame", Vector3.new(0.45, 1.3, 0.45), Color3.fromRGB(255, 190, 60), Enum.Material.Neon)
			weld(flame, foot, CFrame.new(0, -0.8, 0))
			flame:SetAttribute("ShowWhen", "FlyingOrDodge")
		end
	elseif heroId == "ElTigre" then
		local fur = look.Skin
		for _, side in ipairs({ -1, 1 }) do
			cone(folder, head, CFrame.new(side * r * 0.55, r * 0.75, 0) * CFrame.Angles(0, 0, math.rad(-side * 15)), r * 0.6, r * 0.3, fur)
			cone(folder, head, CFrame.new(side * r * 0.95, -r * 0.1, -r * 0.1) * CFrame.Angles(0, 0, math.rad(-side * 75)), r * 0.55, r * 0.22, WHITE)
		end
		for _, hand in ipairs({ lh, rh }) do
			for c = -1, 1 do
				cone(folder, hand, CFrame.new(c * 0.12, -0.2, -0.1) * CFrame.Angles(math.pi, 0, math.rad(c * 8)), 0.75, 0.06, Color3.fromRGB(215, 220, 230))
			end
		end
	elseif heroId == "Ben" then
		local hair = Color3.fromRGB(120, 75, 40)
		ball(folder, head, CFrame.new(0, r * 0.5, r * 0.05), Vector3.new(d * 1.06, d * 0.62, d * 1.03), hair)
		cone(folder, head, CFrame.new(r * 0.25, r * 0.55, -r * 0.7) * CFrame.Angles(math.rad(-70), 0, math.rad(-20)), r * 0.5, r * 0.35, hair)
		box(folder, torso, CFrame.new(0, 0, -tz - 0.02), Vector3.new(0.3, torso.Size.Y * 0.95, 0.05), BLACK)
		box(folder, torso, CFrame.new(0, 0, tz + 0.02), Vector3.new(0.3, torso.Size.Y * 0.95, 0.05), BLACK)
		local wrist = parts.LeftLowerArm
		if wrist then
			cyl(folder, wrist, CFrame.new(0, -wrist.Size.Y * 0.35, 0), 0.25, wrist.Size.X * 1.25, BLACK)
			ball(folder, wrist, CFrame.new(0, -wrist.Size.Y * 0.35, -wrist.Size.Z * 0.6), Vector3.new(0.3, 0.3, 0.12), Color3.fromRGB(90, 255, 90), true)
		end
	elseif heroId == "Aang" then
		local blue, orange, brown = Color3.fromRGB(70, 160, 240), Color3.fromRGB(230, 110, 40), Color3.fromRGB(140, 95, 55)
		box(folder, head, CFrame.new(0, r * 0.97, 0), Vector3.new(0.18, 0.05, d * 0.85), blue, true)
		box(folder, head, CFrame.new(0, r * 0.45, -r * 0.88) * CFrame.Angles(math.rad(25), 0, 0), Vector3.new(0.18, d * 0.4, 0.05), blue, true)
		ball(folder, torso, CFrame.new(0, torso.Size.Y * 0.3, 0.05), Vector3.new(torso.Size.X * 1.2, torso.Size.Y * 0.5, torso.Size.Z * 1.3), orange)
		-- Staff on a joint the client spins.
		local staff = newPart(folder, "Staff", Vector3.new(6, 0.22, 0.22), brown)
		staff.Shape = Enum.PartType.Cylinder
		motor(staff, rh, CFrame.new(0, -0.2, 0) * CFrame.Angles(0, 0, math.pi / 2), "StaffJoint")
		staff:SetAttribute("ShowWhen", "NotGliding")
		-- Glider wings while gliding.
		local wing = newPart(folder, "Glider", Vector3.new(7, 0.1, 2.6), orange)
		weld(wing, rh, CFrame.new(0, -0.4, 0))
		wing:SetAttribute("ShowWhen", "Gliding")
		-- Air scooter.
		local scooter = newPart(folder, "Scooter", Vector3.new(3.4, 2.4, 3.4), Color3.fromRGB(190, 220, 255), Enum.Material.Neon)
		local mesh = Instance.new("SpecialMesh")
		mesh.MeshType = Enum.MeshType.Sphere
		mesh.Parent = scooter
		scooter.Transparency = 0.45
		weld(scooter, lower, CFrame.new(0, -lower.Size.Y * 0.5 - parts.LegLength, 0))
		scooter:SetAttribute("ShowWhen", "Scooter")
	end
	if look.Belt and lower then
		box(folder, lower, CFrame.new(0, lower.Size.Y * 0.3, 0), Vector3.new(lower.Size.X * 1.06, 0.22, lower.Size.Z * 1.06), look.Belt)
	end
end

local function formGear(folder, parts, form, d)
	local head, torso, lower = parts.ToonHead, parts.UpperTorso, parts.LowerTorso
	local r = d * 0.5
	if form.Id == "Heatblast" then
		local fire = Instance.new("Fire")
		fire.Heat = 12
		fire.Size = d * 2.2
		fire.Color = Color3.fromRGB(255, 150, 30)
		fire.SecondaryColor = Color3.fromRGB(255, 230, 90)
		fire.Parent = head
		cone(folder, head, CFrame.new(0, r * 0.6, 0.1), d * 1.0, r * 0.95, Color3.fromRGB(255, 160, 30), true)
		for _, hand in ipairs({ parts.LeftHand, parts.RightHand }) do
			local f = Instance.new("Fire")
			f.Size = 2
			f.Heat = 6
			f.Parent = hand
		end
	elseif form.Id == "FourArms" then
		local tz = torso.Size.Z * 0.5
		box(folder, torso, CFrame.new(0, 0, -tz - 0.02), Vector3.new(0.6, torso.Size.Y * 0.8, 0.05), BLACK)
		box(folder, lower, CFrame.new(0, lower.Size.Y * 0.3, 0), Vector3.new(lower.Size.X * 1.06, 0.4, lower.Size.Z * 1.06), Color3.fromRGB(230, 190, 60))
		-- Second pair of arms on joints the client animates.
		for _, side in ipairs({ -1, 1 }) do
			local up = parts.LeftUpperArm or torso
			local armPart = newPart(folder, side < 0 and "ExtraArmL" or "ExtraArmR", Vector3.new(up.Size.X * 0.9, up.Size.Y * 1.9, up.Size.Z * 0.9), form.Body)
			motor(armPart, torso, CFrame.new(side * (torso.Size.X * 0.5 + up.Size.X * 0.4), -torso.Size.Y * 0.15, 0), side < 0 and "ExtraArmL" or "ExtraArmR")
				.C1 = CFrame.new(0, armPart.Size.Y * 0.4, 0)
		end
	elseif form.Id == "XLR8" then
		box(folder, head, CFrame.new(0, -r * 0.05, -r * 0.55), Vector3.new(d * 0.75, d * 0.38, d * 0.5), Color3.fromRGB(20, 20, 25))
		box(folder, head, CFrame.new(0, r * 0.08, -r * 0.82), Vector3.new(d * 0.55, 0.1, 0.05), Color3.fromRGB(80, 200, 255), true)
		cone(folder, lower, CFrame.new(0, 0, lower.Size.Z * 0.5) * CFrame.Angles(math.rad(115), 0, 0), lower.Size.Y * 3.5, 0.35, form.Body)
	elseif form.Id == "Cannonbolt" then
		local shell = newPart(folder, "CannonShell", Vector3.new(1, 1, 1) * parts.Height * 0.95, form.Body)
		local mesh = Instance.new("SpecialMesh")
		mesh.MeshType = Enum.MeshType.Sphere
		mesh.Parent = shell
		weld(shell, parts.Root, CFrame.new(0, -parts.Height * 0.12, 0))
		shell:SetAttribute("ShowWhen", "Always")
		shell:SetAttribute("Spin", true)
		for k = 0, 3 do
			local band = newPart(folder, "CannonBand", Vector3.new(parts.Height * 0.97, parts.Height * 0.18, parts.Height * 0.97), form.Accent)
			local m2 = Instance.new("SpecialMesh")
			m2.MeshType = Enum.MeshType.Sphere
			m2.Parent = band
			weld(band, parts.Root, CFrame.new(0, -parts.Height * 0.12, 0) * CFrame.Angles(math.rad(k * 45), 0, 0))
			band:SetAttribute("ShowWhen", "Always")
		end
	elseif form.Id == "WayBig" then
		local tz = torso.Size.Z * 0.5
		box(folder, torso, CFrame.new(0, 0, -tz - 0.02), Vector3.new(torso.Size.X * 0.25, torso.Size.Y * 0.8, 0.05), form.Accent)
		box(folder, head, CFrame.new(0, r * 1.0, 0.1), Vector3.new(0.2, d * 0.8, d * 0.9), form.Accent)
	end
end

-- Jake's dragon: built hidden, shown while flying (the human body hides).
local function dragonGear(folder, parts, scale)
	-- Welded to the LowerTorso so the Animator's Root transform banks and pitches it.
	local root = parts.LowerTorso or parts.Root
	local red, belly, wingC = Color3.fromRGB(205, 35, 30), Color3.fromRGB(245, 200, 70), Color3.fromRGB(150, 25, 25)
	local k = scale * 1.6
	local group = Instance.new("Folder")
	group.Name = "Dragon"
	group.Parent = folder
	local body = ball(group, root, CFrame.new(0, 0.3 * k, 0), Vector3.new(2.4, 2.2, 4.8) * k, red)
	ball(group, root, CFrame.new(0, -0.3 * k, -0.2 * k), Vector3.new(1.8, 1.5, 4.0) * k, belly)
	cyl(group, root, CFrame.new(0, 1.3 * k, -2.2 * k) * CFrame.Angles(math.rad(-40), 0, 0), 2.2 * k, 1.0 * k, red)
	local headC = CFrame.new(0, 2.3 * k, -3.2 * k)
	ball(group, root, headC, Vector3.new(1.6, 1.3, 2.0) * k, red)
	box(group, root, headC * CFrame.new(0, -0.2 * k, -1.1 * k), Vector3.new(1.0, 0.7, 1.3) * k, red)
	for _, side in ipairs({ -1, 1 }) do
		ball(group, root, headC * CFrame.new(side * 0.45 * k, 0.3 * k, -0.7 * k), Vector3.new(0.35, 0.35, 0.35) * k, Color3.fromRGB(255, 230, 80), true)
		cone(group, root, headC * CFrame.new(side * 0.45 * k, 0.6 * k, 0.4 * k) * CFrame.Angles(math.rad(-50), 0, 0), 1.2 * k, 0.35 * k, Color3.fromRGB(250, 225, 150))
		-- Wing on a joint the client flaps.
		local wing = newPart(group, side < 0 and "DragonWingL" or "DragonWingR", Vector3.new(4.5, 0.15, 3.0) * k, wingC)
		motor(wing, body, CFrame.new(side * 1.0 * k, 0.8 * k, -0.4 * k), side < 0 and "DragonWingL" or "DragonWingR").C1 = CFrame.new(-side * 2.2 * k, 0, 0)
		cyl(group, root, CFrame.new(side * 0.8 * k, -1.2 * k, -1.4 * k), 1.4 * k, 0.55 * k, red)
		cyl(group, root, CFrame.new(side * 0.8 * k, -1.3 * k, 1.4 * k), 1.6 * k, 0.65 * k, red)
	end
	for i = 1, 5 do
		local s = 1.2 - i * 0.17
		ball(group, root, CFrame.new(0, 0.3 * k - i * 0.1 * k, 2.2 * k + i * 0.9 * k), Vector3.new(s, s, 1.6) * k, red)
	end
	showWhen(group, "Flying")
	for _, p in ipairs(group:GetChildren()) do
		p.Parent = folder
	end
	group:Destroy()
end

-- Public -----------------------------------------------------------------------

function Looks.apply(character, heroId, form)
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if not humanoid then
		return
	end
	-- Newest call wins if several overlap (quick hero swaps, form changes).
	local gen = (character:GetAttribute("LookGen") or 0) + 1
	character:SetAttribute("LookGen", gen)
	local hero = Config.Heroes[heroId] or Config.Heroes.Jimmy
	local look = form and formLook(form) or hero.Look
	local r15 = humanoid.RigType == Enum.HumanoidRigType.R15
	if r15 then
		setScale(humanoid, look.Height or 1, look.Width or 1, look.HeadScale or 1)
		-- Let the rig rescale before measuring parts for the gear.
		task.wait(0.1)
		if not character.Parent or character:GetAttribute("LookGen") ~= gen then
			return
		end
	end
	for _, old in ipairs(character:GetChildren()) do
		if old.Name == GEAR then
			old:Destroy()
		end
	end
	for _, d in ipairs(character:GetDescendants()) do
		if d:IsA("Fire") or (d:IsA("Motor6D") and (d.Name == "StaffJoint" or d.Name:sub(1, 8) == "ExtraArm" or d.Name:sub(1, 10) == "DragonWing")) then
			d:Destroy()
		end
	end
	colorBody(character, look)
	-- Strip anything the avatar brought along.
	for _, d in ipairs(character:GetChildren()) do
		if d:IsA("Accessory") or d:IsA("Shirt") or d:IsA("Pants") or d:IsA("ShirtGraphic") then
			d:Destroy()
		end
	end

	local folder = Instance.new("Folder")
	folder.Name = GEAR
	folder.Parent = character
	local head = character:FindFirstChild("Head")
	if not head then
		return
	end
	-- Round toon head over the original (which stays as the physics part).
	local face = head:FindFirstChild("face") or head:FindFirstChildOfClass("Decal")
	if face then
		face:Destroy()
	end
	head.Transparency = 1
	local d = head.Size.Y * 1.25
	local toon = newPart(folder, "ToonHead", Vector3.new(d, d, d), look.Skin)
	local mesh = Instance.new("SpecialMesh")
	mesh.MeshType = Enum.MeshType.Sphere
	mesh.Parent = toon
	weld(toon, head, CFrame.new(0, d * 0.12, 0))
	buildFace(toon, look, form and form.Id == "FourArms" and "FourEyes" or nil)

	local parts = { ToonHead = toon, Root = character:FindFirstChild("HumanoidRootPart") }
	for _, name in ipairs(R15_PARTS) do
		parts[name] = character:FindFirstChild(name)
	end
	parts.UpperTorso = parts.UpperTorso or character:FindFirstChild("Torso")
	parts.LowerTorso = parts.LowerTorso or parts.UpperTorso
	parts.LeftHand = parts.LeftHand or character:FindFirstChild("Left Arm")
	parts.RightHand = parts.RightHand or character:FindFirstChild("Right Arm")
	local ul, ll = parts.LeftUpperLeg, parts.LeftLowerLeg
	parts.LegLength = (ul and ul.Size.Y or 1) + (ll and ll.Size.Y or 1) + 0.4
	parts.Height = humanoid.HipHeight + (parts.Root and parts.Root.Size.Y or 2) * 0.5 + 3
	if form then
		formGear(folder, parts, form, d)
		if form.Id == "Cannonbolt" then
			character:SetAttribute("HideBody", true)
		else
			character:SetAttribute("HideBody", nil)
		end
	else
		character:SetAttribute("HideBody", nil)
		heroGear(folder, parts, heroId, look, d)
		if heroId == "Jake" then
			dragonGear(folder, parts, look.Height or 1)
		end
	end
end

return Looks
]]></ProtectedString>
</Properties>
</Item>
</Item>
<Item class="Folder" referent="RBX18822"><Properties>
<string name="Name">Systems</string>
</Properties>
<Item class="ModuleScript" referent="RBX18823"><Properties>
<string name="Name">Boss</string>
<ProtectedString name="Source"><![CDATA[--!nonstrict
-- The Rift Titan: a three-phase boss fight in the classic action-game mould.
--   Phase 1  Stomp (a ground shockwave: jump over it) and Charge (dodge it).
--   Phase 2  adds a Volley of shots (parry them back with a counter).
--   Phase 3  enraged: faster, and summons gremlins.
-- Every attack is telegraphed. Enough hits break its posture: it staggers and
-- finishers deal triple damage. It appears when all three rifts are closed,
-- or from the "Titan Hunt" mission. Health scales with the players nearby.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))

local Boss = {}
local Net, Enemies, Combat, Progression, PlayerState
local active = nil
local B = Config.Boss

local function rootOf(player)
	local character = player and player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if humanoid and humanoid.Health > 0 then
		return character:FindFirstChild("HumanoidRootPart")
	end
	return nil
end

local function onGround(root)
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = { root.Parent }
	return workspace:Raycast(root.Position, Vector3.new(0, -5.5, 0), params) ~= nil
end

local function buildModel(pos)
	local model = Instance.new("Model")
	model.Name = "RiftTitan"
	local s = B.Size
	local root = Instance.new("Part")
	root.Name = "Body"
	root.Shape = Enum.PartType.Ball
	root.Size = Vector3.new(s, s, s)
	root.Color = B.Color
	root.Material = Enum.Material.SmoothPlastic
	root.CFrame = CFrame.new(pos)
	root.CustomPhysicalProperties = PhysicalProperties.new(2, 0.3, 0.3)
	root.Parent = model
	local function add(size, offset, color, material, shape)
		local p = Instance.new("Part")
		p.Size = size
		p.Color = color
		p.Material = material or Enum.Material.SmoothPlastic
		p.Shape = shape or Enum.PartType.Ball
		p.CanCollide = false
		p.CanQuery = false
		p.Massless = true
		p.CFrame = root.CFrame * offset
		p.Parent = model
		local w = Instance.new("WeldConstraint")
		w.Part0 = root
		w.Part1 = p
		w.Parent = p
		return p
	end
	for _, x in ipairs({ -1, 1 }) do
		add(Vector3.new(6, 6, 6), CFrame.new(x * 4.5, 3, -8.5), Color3.new(1, 1, 1))
		add(Vector3.new(3, 3, 3), CFrame.new(x * 4.5, 3, -11), Color3.fromRGB(255, 60, 90), Enum.Material.Neon)
		add(Vector3.new(2.5, 12, 2.5), CFrame.new(x * 7, 11, 0) * CFrame.Angles(0, 0, -x * 0.5), Color3.fromRGB(250, 230, 200), nil, Enum.PartType.Block)
		add(Vector3.new(5, 14, 5), CFrame.new(x * 12, -3, -2), B.Color, nil, Enum.PartType.Block)
	end
	add(Vector3.new(12, 2, 1.5), CFrame.new(0, -4, -10.5), Color3.fromRGB(255, 230, 255), Enum.Material.Neon, Enum.PartType.Block)
	for i = 0, 7 do
		local a = i / 8 * math.pi * 2
		add(Vector3.new(1.6, 4, 1.6), CFrame.new(math.cos(a) * 6, 11.5, math.sin(a) * 6), Color3.fromRGB(255, 210, 60), Enum.Material.Neon, Enum.PartType.Block)
	end
	local att = Instance.new("Attachment")
	att.Parent = root
	local align = Instance.new("AlignPosition")
	align.Mode = Enum.PositionAlignmentMode.OneAttachment
	align.Attachment0 = att
	align.MaxForce = 5e6
	align.MaxVelocity = B.Speed
	align.Responsiveness = 20
	align.Position = pos
	align.Parent = root
	local orient = Instance.new("AlignOrientation")
	orient.Mode = Enum.OrientationAlignmentMode.OneAttachment
	orient.Attachment0 = att
	orient.MaxTorque = 5e6
	orient.Responsiveness = 8
	orient.Parent = root
	model.PrimaryPart = root
	model:SetAttribute("Enemy", "Boss")
	model.Parent = workspace:FindFirstChild("Enemies") or workspace
	root:SetNetworkOwner(nil)
	return model, root, align, orient
end

local function nearestPlayer(pos)
	local best, bestDist = nil, 400
	for _, player in ipairs(Players:GetPlayers()) do
		local r = rootOf(player)
		if r and (r.Position - pos).Magnitude < bestDist then
			best, bestDist = player, (r.Position - pos).Magnitude
		end
	end
	return best, bestDist
end

local function telegraph(e, time, label)
	e.Model:SetAttribute("Windup", workspace:GetServerTimeNow())
	Net.fireAll("Fx", { Kind = "Telegraph", Model = e.Model, Time = time, Boss = true, Label = label })
end

local function stomp(e)
	local center = e.Root.Position - Vector3.new(0, B.Size * 0.5, 0)
	local hit = {}
	Net.fireAll("Fx", { Kind = "Shockwave", Pos = center, Radius = B.StompRadius, Time = 1.2, Color = Color3.fromRGB(255, 80, 200) })
	Net.fireAll("Fx", { Kind = "Shake", Pos = center, Amount = 0.8 })
	task.spawn(function()
		local t0 = os.clock()
		while os.clock() - t0 < 1.2 and e.Health > 0 do
			local radius = (os.clock() - t0) / 1.2 * B.StompRadius
			for _, player in ipairs(Players:GetPlayers()) do
				local r = rootOf(player)
				if r and not hit[player] then
					local flat = Vector3.new(r.Position.X - center.X, 0, r.Position.Z - center.Z).Magnitude
					if math.abs(flat - radius) < 4 and onGround(r) then
						hit[player] = true
						Combat.damagePlayer(player, B.StompDamage, center)
					end
				end
			end
			task.wait(0.05)
		end
	end)
end

local function charge(e, target)
	local r = rootOf(target)
	if not r then
		return
	end
	local dir = Vector3.new(r.Position.X - e.Root.Position.X, 0, r.Position.Z - e.Root.Position.Z)
	if dir.Magnitude < 1 then
		return
	end
	dir = dir.Unit
	local hit = {}
	e.Align.MaxVelocity = 70
	local goal = e.Root.Position + dir * 90
	e.Align.Position = goal
	task.spawn(function()
		local t0 = os.clock()
		while os.clock() - t0 < 1.4 and e.Health > 0 do
			for _, player in ipairs(Players:GetPlayers()) do
				local pr = rootOf(player)
				if pr and not hit[player] and (pr.Position - e.Root.Position).Magnitude < B.Size * 0.5 + 4 then
					hit[player] = true
					Combat.damagePlayer(player, B.ChargeDamage, e.Root.Position)
					pr.AssemblyLinearVelocity = dir * 80 + Vector3.new(0, 40, 0)
				end
			end
			task.wait(0.05)
		end
		e.Align.MaxVelocity = e.Speed
	end)
end

local function volley(e, target)
	local r = rootOf(target)
	if not r then
		return
	end
	local from = e.Root.Position + Vector3.new(0, 3, 0)
	local base = r.Position - from
	for k = -2, 2 do
		local dir = CFrame.Angles(0, math.rad(k * 9), 0):VectorToWorldSpace(base)
		Enemies.fireShot(e, from, from + dir, 65, B.SpitDamage, Color3.fromRGB(255, 80, 200))
	end
end

local function think(e, now, step)
	if e.Stun > 0 then
		e.Stun = e.Stun - step
		if e.Stun <= 0 then
			e.Align.Enabled = true
		end
	end
	local frac = e.Health / e.MaxHealth
	local phase = frac > 0.66 and 1 or (frac > 0.33 and 2 or 3)
	if phase ~= e.PhaseNum then
		e.PhaseNum = phase
		if phase > 1 then
			Net.fireAll("Notify", { Banner = B.Name .. (phase == 3 and " is ENRAGED!" or " - Phase 2"), Color = Color3.fromRGB(255, 80, 200) })
		end
		e.Speed = B.Speed * (phase == 3 and 1.6 or 1)
		e.Align.MaxVelocity = e.Speed
	end
	workspace:SetAttribute("BossHealth", math.max(0, math.floor(e.Health)))
	if e.Staggered > now then
		e.Align.Position = e.Root.Position
		return
	elseif e.Model:GetAttribute("Staggered") then
		e.Model:SetAttribute("Staggered", nil)
	end
	if now - e.PostureAt > 2 and e.Posture > 0 then
		e.Posture = math.max(0, e.Posture - Config.Combat.PostureDecay * 2 * step)
	end
	local target = nearestPlayer(e.Root.Position)
	if e.Pending then
		if now >= e.PendingAt then
			local attack = e.Pending
			e.Pending = nil
			e.Model:SetAttribute("Windup", nil)
			e.State = "Chase"
			if attack == "Stomp" then
				stomp(e)
			elseif attack == "Charge" then
				charge(e, e.Target)
			elseif attack == "Volley" then
				volley(e, e.Target)
			end
			e.NextAttack = now + (phase == 3 and 2.2 or 3.4)
		end
		return
	end
	if not target then
		return
	end
	local tr = rootOf(target)
	local ground = Enemies.groundAt(tr.Position)
	local flat = Vector3.new(tr.Position.X - e.Root.Position.X, 0, tr.Position.Z - e.Root.Position.Z)
	if flat.Magnitude > 1 then
		e.Orient.CFrame = CFrame.lookAt(Vector3.zero, flat.Unit)
	end
	if flat.Magnitude > 30 then
		e.Align.Position = Vector3.new(tr.Position.X, ground.Y + B.Size * 0.5 + 1, tr.Position.Z)
	else
		e.Align.Position = Vector3.new(e.Root.Position.X, ground.Y + B.Size * 0.5 + 1, e.Root.Position.Z)
	end
	if phase == 3 and now >= (e.NextSummon or 0) then
		e.NextSummon = now + 15
		Enemies.spawnWave(e.Root.Position, { Gremlin = 3 }, { Mission = "Boss" }, 25)
	end
	if now >= e.NextAttack then
		local options = { "Stomp", "Charge" }
		if phase >= 2 then
			table.insert(options, "Volley")
		end
		local attack = options[math.random(1, #options)]
		local windup = attack == "Stomp" and 1.0 or 0.8
		e.Pending = attack
		e.PendingAt = now + windup
		e.Target = target
		e.State = "BossWindup" -- not cancellable by counters; parry its shots instead
		telegraph(e, windup, attack)
	end
end

function Boss.active()
	return active
end

-- Spawns the Titan at `pos` (ground). onDeath(attacker) runs when it falls.
function Boss.spawn(pos, onDeath)
	if active and active.Health > 0 and active.Model.Parent then
		return active
	end
	local nearby = 0
	for _, player in ipairs(Players:GetPlayers()) do
		local r = rootOf(player)
		if r and (r.Position - pos).Magnitude < 600 then
			nearby = nearby + 1
		end
	end
	local health = B.Health * (1 + B.PerExtraPlayer * math.max(0, nearby - 1))
	local ground = Enemies.groundAt(pos)
	local model, root, align, orient = buildModel(ground + Vector3.new(0, B.Size * 0.5 + 1, 0))
	local e = {
		Model = model, Root = root, Align = align, Orient = orient, IsBoss = true, Type = "Boss",
		Def = { Posture = B.Posture, Xp = B.Xp, Cash = B.Cash, Color = B.Color, Heat = 0 },
		Health = health, MaxHealth = health, Posture = 0, PostureAt = 0, Staggered = 0, Stun = 0,
		State = "Chase", NextAttack = os.clock() + 3, Radius = B.Size * 0.5, Speed = B.Speed, PhaseNum = 1,
		Home = ground, Think = think,
	}
	e.OnDeath = function(attacker)
		workspace:SetAttribute("BossActive", false)
		Net.fireAll("Notify", { Banner = B.Name .. " DEFEATED!", Color = Color3.fromRGB(255, 220, 90) })
		for _, player in ipairs(Players:GetPlayers()) do
			local r = rootOf(player)
			if r and (r.Position - e.Root.Position).Magnitude < 400 then
				Progression.award(player, B.Xp, B.Cash, B.Name)
			end
		end
		active = nil
		if onDeath then
			onDeath(attacker)
		end
	end
	Enemies.register(e)
	active = e
	workspace:SetAttribute("BossName", B.Name)
	workspace:SetAttribute("BossMax", math.floor(health))
	workspace:SetAttribute("BossHealth", math.floor(health))
	workspace:SetAttribute("BossActive", true)
	Net.fireAll("Notify", { Banner = "THE " .. string.upper(B.Name) .. " HAS ARRIVED!", Text = "Jump its shockwaves, dodge its charge, counter its shots", Color = Color3.fromRGB(255, 80, 200) })
	Net.fireAll("Fx", { Kind = "Burst", Pos = root.Position, Color = B.Color, Count = 120, Gravity = true })
	return e
end

function Boss.init(systems)
	Net, Enemies, Combat, Progression, PlayerState = systems.Net, systems.Enemies, systems.Combat, systems.Progression, systems.Players
end

function Boss.start()
	local MapData = require(Shared:WaitForChild("MapData"))
	local anchors = MapData.Anchors or {}
	Enemies.onAllRiftsClosed = function()
		if anchors.Plaza then
			task.delay(4, function()
				Boss.spawn(anchors.Plaza)
			end)
		end
	end
end

return Boss
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX18824"><Properties>
<string name="Name">Collectibles</string>
<ProtectedString name="Source"><![CDATA[--!nonstrict
-- Rift shards: crystals scattered over every world (rooftops, ledges, and
-- every fourth one high in the sky). Each player collects their own set; a
-- shard refills health, energy and some of the ultimate meter.

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local MapData = require(Shared:WaitForChild("MapData"))

local Collectibles = {}
local Net, PlayerState, Profiles, Progression
local shards = {}  -- { Id, Pos, Level }
local taken = {}   -- [player] = { [id] = true }

local function place(levelName, level, count, seed)
	local rng = Random.new(seed)
	local lo, hi = level.Bounds.Min, level.Bounds.Max
	local span = hi - lo
	local minGap = math.max(span.X, span.Z) / (count <= 10 and 8 or 9)
	local placed = {}
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Include
	params.FilterDescendantsInstances = { workspace:FindFirstChild(levelName) }
	for _ = 1, 2000 do
		if #placed >= count then
			break
		end
		local top = Vector3.new(lo.X + span.X * (0.08 + 0.84 * rng:NextNumber()), hi.Y - 1, lo.Z + span.Z * (0.08 + 0.84 * rng:NextNumber()))
		local hit = workspace:Raycast(top, Vector3.new(0, -(hi.Y - lo.Y), 0), params)
		if hit and hit.Position.Y > lo.Y + 2 and hit.Instance.Transparency < 0.5 then
			local pos = hit.Position + Vector3.new(0, 3.7, 0)
			if #placed % 4 == 3 then
				pos = pos + Vector3.new(0, 17 + 13 * rng:NextNumber(), 0)
			end
			local ok = (pos - level.Start).Magnitude > 13
			for _, other in ipairs(placed) do
				local d = Vector3.new(other.X - pos.X, 0, other.Z - pos.Z).Magnitude
				ok = ok and d > minGap
			end
			if ok then
				table.insert(placed, pos)
			end
		end
	end
	return placed
end

local function buildShard(id, pos, folder)
	local model = Instance.new("Model")
	model.Name = "RiftShard_" .. id
	local function crystal(offset, color, flip)
		local p = Instance.new("Part")
		p.Anchored = true
		p.CanCollide = false
		p.CanQuery = false
		p.Material = Enum.Material.Neon
		p.Color = color
		p.Size = Vector3.new(1.3, 1.6, 1.3)
		local mesh = Instance.new("SpecialMesh")
		mesh.MeshType = Enum.MeshType.Sphere
		mesh.Scale = Vector3.new(0.7, 1.3, 0.7)
		mesh.Parent = p
		p.CFrame = CFrame.new(pos + offset) * CFrame.Angles(flip and math.pi or 0, 0, 0)
		p.Parent = model
		return p
	end
	local core = crystal(Vector3.new(0, 0.6, 0), Color3.fromRGB(190, 130, 255))
	crystal(Vector3.new(0, -0.6, 0), Color3.fromRGB(120, 230, 255), true)
	local light = Instance.new("PointLight")
	light.Color = Color3.fromRGB(200, 160, 255)
	light.Range = 12
	light.Brightness = 2
	light.Parent = core
	local sparkle = Instance.new("ParticleEmitter")
	sparkle.Rate = 6
	sparkle.Lifetime = NumberRange.new(0.6, 1.2)
	sparkle.Speed = NumberRange.new(1, 3)
	sparkle.SpreadAngle = Vector2.new(180, 180)
	sparkle.LightEmission = 1
	sparkle.Color = ColorSequence.new(Color3.fromRGB(230, 210, 255))
	sparkle.Size = NumberSequence.new(0.3, 0)
	sparkle.Parent = core
	model.PrimaryPart = core
	model:SetAttribute("ShardId", id)
	model.Parent = folder
end

function Collectibles.init(systems)
	Net, PlayerState, Profiles, Progression = systems.Net, systems.Players, systems.Profiles, systems.Progression
end

-- Counts per level for the HUD.
local function syncCounts(player, mine)
	local have, totals = {}, {}
	for _, s in ipairs(shards) do
		totals[s.Level] = (totals[s.Level] or 0) + 1
		if mine[s.Id] then
			have[s.Level] = (have[s.Level] or 0) + 1
		end
	end
	for level in pairs(totals) do
		player:SetAttribute("Shards_" .. level, have[level] or 0)
	end
end

function Collectibles.start()
	local folder = Instance.new("Folder")
	folder.Name = "Shards"
	folder.Parent = workspace
	local counts = { [Config.Levels.Nexus] = Config.Shards.Nexus, [Config.Levels.Retroville] = Config.Shards.Retroville }
	local seed = 4242
	for levelName, level in pairs(MapData.Levels) do
		seed = seed + 977
		for _, pos in ipairs(place(levelName, level, counts[levelName] or 12, seed)) do
			local id = #shards + 1
			table.insert(shards, { Id = id, Pos = pos, Level = levelName })
			buildShard(id, pos, folder)
		end
	end
	workspace:SetAttribute("ShardTotal_" .. Config.Levels.Nexus, 0)
	local totals = {}
	for _, s in ipairs(shards) do
		totals[s.Level] = (totals[s.Level] or 0) + 1
	end
	for levelName, n in pairs(totals) do
		workspace:SetAttribute("ShardTotal_" .. levelName, n)
	end

	-- Saved shards come back with the profile (and are hidden for that player).
	Profiles.onLoaded(function(player, data)
		local mine = taken[player] or {}
		taken[player] = mine
		for _, id in ipairs(data.Shards) do
			if shards[id] then
				mine[id] = true
				Net.fire("Fx", player, { Kind = "ShardTaken", Id = id, Pos = shards[id].Pos, Silent = true })
			end
		end
		syncCounts(player, mine)
	end)
	Players.PlayerAdded:Connect(function(player)
		taken[player] = taken[player] or {}
	end)
	for _, player in ipairs(Players:GetPlayers()) do
		taken[player] = taken[player] or {}
	end
	Players.PlayerRemoving:Connect(function(player)
		taken[player] = nil
	end)

	local accum = 0
	RunService.Heartbeat:Connect(function(dt)
		accum = accum + dt
		if accum < 0.1 then
			return
		end
		accum = 0
		for _, player in ipairs(Players:GetPlayers()) do
			local character = player.Character
			local root = character and character:FindFirstChild("HumanoidRootPart")
			local humanoid = character and character:FindFirstChildOfClass("Humanoid")
			local mine = taken[player]
			if root and humanoid and humanoid.Health > 0 and mine then
				local reach = Config.Shards.Reach * math.max(1, root.Size.Y / 2)
				for _, s in ipairs(shards) do
					if not mine[s.Id] and (s.Pos - root.Position).Magnitude < reach then
						mine[s.Id] = true
						local st = PlayerState.get(player)
						humanoid.Health = math.min(humanoid.MaxHealth, humanoid.Health + Config.Shards.Health)
						if st then
							PlayerState.addMeter(st, Config.Shards.Meter)
							st.Energy = Config.Player.MaxEnergy
							st.Shards = st.Shards + 1
						end
						local have, total = 0, 0
						for _, o in ipairs(shards) do
							if o.Level == s.Level then
								total = total + 1
								if mine[o.Id] then
									have = have + 1
								end
							end
						end
						player:SetAttribute("Shards_" .. s.Level, have)
						local data = Profiles.get(player)
						if data then
							table.insert(data.Shards, s.Id)
						end
						Progression.award(player, 15, 10, "Rift shard")
						Net.fire("Fx", player, { Kind = "ShardTaken", Id = s.Id, Pos = s.Pos })
						Net.fire("Notify", player, {
							Text = ("Rift shard %d/%d (+health, energy, ultimate)"):format(have, total),
							Color = Color3.fromRGB(200, 160, 255), Time = 2,
							Banner = have == total and "ALL RIFT SHARDS FOUND!" or nil,
						})
					end
				end
			end
		end
	end)
end

return Collectibles
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX18825"><Properties>
<string name="Name">Combat</string>
<ProtectedString name="Source"><![CDATA[--!nonstrict
-- Server-authoritative combat: attacks with 3-hit combos (third hit is a
-- finisher), projectiles, signature abilities, ultimates, ground pounds,
-- Cannonbolt's rolling damage, and damage/healing for players.
-- Clients only send intent (aim direction, ability name); every cooldown,
-- range and damage number is decided here.

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Omnitrix = require(Shared:WaitForChild("Omnitrix"))

local Combat = {}
local Net, PlayerState, Enemies, World
local projectiles = {}
local nextShot = 1
local shockwaves = {}
local breathing = {} -- [player] = aim
local regenAt = {}   -- [player] = time
local breathTick = 0

local function charOf(player)
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if humanoid and root and humanoid.Health > 0 then
		return character, humanoid, root
	end
	return nil
end

local function canAttack(st, character)
	if st.Intangible or character:GetAttribute("MvIntangible") then
		return false
	end
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if humanoid and humanoid.SeatPart then
		return false
	end
	if st.Hero == "Ben" and (st.Omni:IsInputLocked() or st.Omni.State == Omnitrix.State.Selecting) then
		return false
	end
	return true
end

local function attackDef(st)
	local form = PlayerState.form(st)
	if form then
		return form.Attack
	end
	return (Config.Heroes[st.Hero] or Config.Heroes.Jimmy).Attack
end

local function bodyScale(character)
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	local v = humanoid and humanoid:FindFirstChild("BodyHeightScale")
	return v and v.Value or 1
end

-- Damage -------------------------------------------------------------------------

function Combat.isImmune(player)
	local st = PlayerState.get(player)
	local character = player.Character
	if not st or not character then
		return true
	end
	if st.Intangible or os.clock() < st.DodgeUntil then
		return true
	end
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if humanoid and humanoid.SeatPart then
		return true
	end
	return st.Hero == "Ben" and st.Omni:IsInvulnerable()
end

function Combat.damagePlayer(player, amount, sourcePos)
	local character, humanoid = charOf(player)
	if not character or Combat.isImmune(player) then
		return
	end
	local st = PlayerState.get(player)
	local now = os.clock()
	if st.BlockUntil and now < st.BlockUntil then
		amount = amount * (1 - Config.Combat.BlockReduce)
		Net.fireAll("Fx", { Kind = "Block", Player = player })
	end
	humanoid:TakeDamage(amount)
	regenAt[player] = now + Config.Player.RegenDelay
	PlayerState.addMeter(st, amount * 0.25)
	character:SetAttribute("HurtAt", workspace:GetServerTimeNow())
	-- Getting hit breaks the combo.
	st.Combo = 0
	player:SetAttribute("Combo", 0)
end

-- Every landed hit grows the freeflow combo; it lapses after a few quiet seconds.
function Combat.registerHit(player)
	local st = PlayerState.get(player)
	if not st then
		return
	end
	local now = os.clock()
	if now - (st.ComboAt or 0) > Config.Combat.ComboTimeout then
		st.Combo = 0
	end
	st.Combo = (st.Combo or 0) + 1
	st.ComboAt = now
	player:SetAttribute("Combo", st.Combo)
	player:SetAttribute("ComboAt", workspace:GetServerTimeNow())
end

local function onCounter(player)
	local st = PlayerState.get(player)
	local character, _, root = charOf(player)
	if not st or not character or not canAttack(st, character) then
		return
	end
	if not PlayerState.ready(st, "Counter", Config.Combat.CounterCooldown) then
		return
	end
	local countered = Enemies.counter(player, root.Position)
	if countered > 0 then
		st.DodgeUntil = math.max(st.DodgeUntil, os.clock() + Config.Combat.CounterImmunity)
		character:SetAttribute("CounterAt", workspace:GetServerTimeNow())
		Net.fireAll("Fx", { Kind = "Counter", Player = player, Pos = root.Position, Count = countered })
	else
		st.BlockUntil = os.clock() + Config.Combat.BlockTime
		character:SetAttribute("BlockAt", workspace:GetServerTimeNow())
	end
end

local function onTakedown(player)
	local st = PlayerState.get(player)
	local character, _, root = charOf(player)
	if not st or not character or not canAttack(st, character) then
		return
	end
	if os.clock() - (st.ComboAt or 0) > Config.Combat.ComboTimeout or (st.Combo or 0) < Config.Combat.TakedownCombo then
		return
	end
	local best, bestDist = nil, Config.Combat.TakedownRange
	for _, e in ipairs(Enemies.list()) do
		if e.Health > 0 and e.Model.Parent then
			local d = (e.Root.Position - root.Position).Magnitude - e.Radius
			if d < bestDist then
				best, bestDist = e, d
			end
		end
	end
	if not best then
		return
	end
	st.Combo = st.Combo - Config.Combat.TakedownCombo
	player:SetAttribute("Combo", st.Combo)
	Net.fireAll("Fx", { Kind = "Takedown", Player = player, Pos = best.Root.Position, Model = best.Model })
	local amount = best.IsBoss and 250 or best.Health + 1
	Enemies.damage(best, amount, Vector3.new(0, 60, 0), player, { Posture = 2 })
end

local function hitEnemiesInSphere(center, radius, damage, knockScale, attacker, alreadyHit)
	local hits = 0
	for _, e in ipairs(Enemies.list()) do
		if e.Health > 0 and e.Root.Parent and not (alreadyHit and alreadyHit[e]) then
			local to = e.Root.Position - center
			if to.Magnitude < radius + e.Radius then
				if alreadyHit then
					alreadyHit[e] = true
				end
				local flat = Vector3.new(to.X, 0, to.Z)
				local dir = flat.Magnitude > 0.01 and flat.Unit or Vector3.new(0, 0, 1)
				Enemies.damage(e, damage, dir * 40 * knockScale + Vector3.new(0, 30 * knockScale, 0), attacker)
				hits = hits + 1
			end
		end
	end
	return hits
end

local function shockwave(center, maxRadius, speed, damage, color, attacker)
	table.insert(shockwaves, { Center = center, Radius = 0, Max = maxRadius, Speed = speed, Damage = damage, Hit = {}, Attacker = attacker })
	Net.fireAll("Fx", { Kind = "Shockwave", Pos = center, Radius = maxRadius, Time = maxRadius / speed, Color = color })
end

-- Projectiles -----------------------------------------------------------------------

local function fire(player, origin, velocity, a, damageMul, radiusMul, homing)
	local id = nextShot
	nextShot = nextShot + 1
	local shot = {
		Id = id, Pos = origin, Vel = velocity, Life = homing and 3 or 2.5, Damage = a.Damage * damageMul,
		Radius = (a.Radius or 0.6) * radiusMul, Knock = (a.Knockback or 20) / 40, Owner = player, Homing = homing,
	}
	projectiles[id] = shot
	if not homing then
		Net.fireAll("Fx", { Kind = "Shot", Id = id, Pos = origin, Vel = velocity, Color = a.Color, Radius = shot.Radius, Life = shot.Life })
	else
		local p = Instance.new("Part")
		p.Name = "Missile"
		p.Anchored = true
		p.CanCollide = false
		p.CanQuery = false
		p.Material = Enum.Material.Neon
		p.Color = Color3.fromRGB(255, 210, 90)
		p.Size = Vector3.new(0.6, 0.6, 1.6)
		p.CFrame = CFrame.lookAt(origin, origin + velocity)
		local trail = Instance.new("Fire")
		trail.Size = 2
		trail.Heat = 0
		trail.Parent = p
		p.Parent = workspace
		shot.Part = p
	end
	return shot
end

local function endShot(shot, pos)
	projectiles[shot.Id] = nil
	if shot.Part then
		shot.Part:Destroy()
		Net.fireAll("Fx", { Kind = "Burst", Pos = pos, Color = Color3.fromRGB(255, 200, 90), Count = 10 })
	else
		Net.fireAll("Fx", { Kind = "ShotEnd", Id = shot.Id, Pos = pos })
	end
end

local function stepProjectiles(dt)
	for _, shot in pairs(projectiles) do
		shot.Life = shot.Life - dt
		if shot.Homing then
			local best, bestDist = nil, 200
			for _, e in ipairs(Enemies.list()) do
				if e.Health > 0 and e.Root.Parent then
					local d = (e.Root.Position - shot.Pos).Magnitude
					if d < bestDist then
						best, bestDist = e, d
					end
				end
			end
			if best then
				local want = (best.Root.Position - shot.Pos).Unit * 120
				shot.Vel = shot.Vel:Lerp(want, math.min(1, dt * 4))
			else
				shot.Vel = shot.Vel + Vector3.new(0, -60 * dt, 0)
			end
		end
		local move = shot.Vel * dt
		local params = RaycastParams.new()
		params.FilterType = Enum.RaycastFilterType.Exclude
		local exclude = { workspace:FindFirstChild("Enemies") }
		if shot.Owner.Character then
			table.insert(exclude, shot.Owner.Character)
		end
		params.FilterDescendantsInstances = exclude
		local hit = workspace:Raycast(shot.Pos, move, params)
		local done = false
		-- Enemies along the segment.
		for _, e in ipairs(Enemies.list()) do
			if not done and e.Health > 0 and e.Root.Parent then
				local rel = e.Root.Position - shot.Pos
				local along = math.clamp(rel:Dot(move.Unit), 0, move.Magnitude)
				local closest = shot.Pos + move.Unit * along
				if (e.Root.Position - closest).Magnitude < shot.Radius + e.Radius + 0.2 then
					local dir = shot.Vel.Unit
					Enemies.damage(e, shot.Damage, dir * 40 * shot.Knock + Vector3.new(0, 15 * shot.Knock, 0), shot.Owner)
					endShot(shot, closest)
					done = true
				end
			end
		end
		if not done then
			if hit or shot.Life <= 0 then
				endShot(shot, hit and hit.Position or shot.Pos)
			else
				shot.Pos = shot.Pos + move
				if shot.Part then
					shot.Part.CFrame = CFrame.lookAt(shot.Pos, shot.Pos + shot.Vel)
				end
			end
		end
	end
end

-- Attacks --------------------------------------------------------------------------

local function onAttack(player, aim)
	aim = Net.unit(aim)
	local st = PlayerState.get(player)
	local character, _, root = charOf(player)
	if not aim or not st or not character or not canAttack(st, character) then
		return
	end
	local a = attackDef(st)
	if not a then
		return
	end
	local now = os.clock()
	if (st.Cooldowns.Attack or 0) > now + 0.03 then
		return
	end
	local combo = a.Cooldown >= 0.2
	if combo and now - st.LastAttack < a.Cooldown + Config.Moves.ComboWindow + 0.1 then
		st.AttackStep = (st.AttackStep + 1) % 3
	else
		st.AttackStep = 0
	end
	st.LastAttack = now
	local finisher = combo and st.AttackStep == 2
	st.Cooldowns.Attack = now + a.Cooldown + (finisher and 0.15 or 0)
	local dmg = finisher and Config.Moves.FinisherDamage or 1
	local knock = finisher and Config.Moves.FinisherKnock or 1
	local dur = finisher and 0.38 or 0.25
	character:SetAttribute("AttackStep", st.AttackStep)
	character:SetAttribute("AttackDur", dur)
	character:SetAttribute("AttackAt", workspace:GetServerTimeNow())
	local scale = bodyScale(character)
	local chest = root.Position + Vector3.new(0, 0.8 * scale, 0)

	if a.Kind == "Projectile" then
		local right = aim:Cross(Vector3.new(0, 1, 0))
		right = right.Magnitude > 0.01 and right.Unit or Vector3.new(1, 0, 0)
		for k = 1, a.Count or 1 do
			local spread = (a.Count or 1) > 1 and (k - ((a.Count or 1) + 1) / 2) * 0.08 or 0
			local dir = (aim + right * spread).Unit
			fire(player, chest + dir * 2.5, dir * a.Speed, a, dmg, finisher and 1.7 or 1, false)
		end
	elseif a.Kind == "Melee" then
		local flatAim = Vector3.new(aim.X, 0, aim.Z)
		flatAim = flatAim.Magnitude > 0.01 and flatAim.Unit or Vector3.new(0, 0, -1)
		local range = a.Range * (finisher and 1.3 or 1)
		local hits = 0
		for _, e in ipairs(Enemies.list()) do
			if e.Health > 0 and e.Root.Parent then
				local to = e.Root.Position - root.Position
				local flat = Vector3.new(to.X, 0, to.Z)
				local inFront = flat.Magnitude < 0.01 or flat.Unit:Dot(flatAim) > (finisher and -1.1 or 0.2)
				if flat.Magnitude < range + 2.5 * scale + e.Radius and math.abs(to.Y) < 6 * scale + e.Radius and inFront then
					local dir = flat.Magnitude > 0.01 and flat.Unit or flatAim
					Enemies.damage(e, a.Damage * dmg, dir * (a.Knockback or 40) * knock * 0.6 + Vector3.new(0, (a.Knockback or 40) * knock * 0.3, 0), player, { Melee = true, Posture = finisher and 1.6 or 1 })
					hits = hits + 1
				end
			end
		end
		Net.fireAll("Fx", { Kind = "Slash", Pos = root.Position + flatAim * range * 0.5, Dir = flatAim, Color = a.Color, Finisher = finisher, Hits = hits, Player = player })
	end
end

-- Signature abilities, ultimates ---------------------------------------------------------

local function aimPoint(character, aim, maxDist)
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = { character, workspace:FindFirstChild("Enemies") }
	local origin = character:GetPivot().Position + Vector3.new(0, 2, 0)
	local hit = workspace:Raycast(origin, aim * maxDist, params)
	return hit and hit.Position or origin + aim * maxDist
end

local function coneDamage(player, root, aim, range, halfAngle, damage, knock)
	local cosHalf = math.cos(math.rad(halfAngle))
	local hits = 0
	for _, e in ipairs(Enemies.list()) do
		if e.Health > 0 and e.Root.Parent then
			local to = e.Root.Position - root.Position
			local d = to.Magnitude
			if d < range + e.Radius and d > 0.1 and to.Unit:Dot(aim) > cosHalf then
				Enemies.damage(e, damage, to.Unit * knock + Vector3.new(0, knock * 0.3, 0), player)
				hits = hits + 1
			end
		end
	end
	return hits
end

local function dropAnvil(player, target)
	local anvil = Instance.new("Part")
	anvil.Name = "Anvil"
	anvil.Anchored = true
	anvil.CanCollide = false
	anvil.Size = Vector3.new(4, 3, 6)
	anvil.Color = Color3.fromRGB(70, 70, 80)
	anvil.Material = Enum.Material.Metal
	anvil.CFrame = CFrame.new(target + Vector3.new(0, 60, 0))
	anvil.Parent = workspace
	local tween = TweenService:Create(anvil, TweenInfo.new(0.7, Enum.EasingStyle.Quad, Enum.EasingDirection.In), { CFrame = CFrame.new(target + Vector3.new(0, 1.5, 0)) })
	tween:Play()
	tween.Completed:Connect(function()
		hitEnemiesInSphere(target, 13, 70, 1.4, player)
		Net.fireAll("Fx", { Kind = "Burst", Pos = target, Color = Color3.fromRGB(255, 230, 120), Count = 30, Gravity = true })
		Net.fireAll("Fx", { Kind = "Shake", Pos = target, Amount = 0.5 })
		task.delay(1.5, function()
			anvil:Destroy()
		end)
	end)
end

local function earthPillar(player, root)
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = { root.Parent, workspace:FindFirstChild("Enemies") }
	local down = workspace:Raycast(root.Position, Vector3.new(0, -12, 0), params)
	local ground = down and down.Position.Y or root.Position.Y - 3
	local rock = Instance.new("Part")
	rock.Name = "EarthPillar"
	rock.Anchored = true
	rock.Size = Vector3.new(6, 1, 6)
	rock.Color = Color3.fromRGB(115, 92, 72)
	rock.Material = Enum.Material.Slate
	rock.CFrame = CFrame.new(root.Position.X, ground - 0.5, root.Position.Z)
	rock.Parent = workspace
	TweenService:Create(rock, TweenInfo.new(0.35, Enum.EasingStyle.Back), { Size = Vector3.new(6, 14, 6), CFrame = CFrame.new(root.Position.X, ground + 6.5, root.Position.Z) }):Play()
	Net.fireAll("Fx", { Kind = "Burst", Pos = Vector3.new(root.Position.X, ground, root.Position.Z), Color = Color3.fromRGB(150, 115, 80), Count = 30, Gravity = true })
	task.delay(8, function()
		local sink = TweenService:Create(rock, TweenInfo.new(1), { Size = Vector3.new(6, 1, 6), CFrame = CFrame.new(rock.Position.X, ground - 0.5, rock.Position.Z) })
		sink:Play()
		sink.Completed:Wait()
		rock:Destroy()
	end)
end

local function onAbility(player, name, aim, held)
	aim = Net.unit(aim) or Vector3.new(0, 0, -1)
	local st = PlayerState.get(player)
	local character, _, root = charOf(player)
	if not st or not character or type(name) ~= "string" then
		return
	end
	local hero = st.Hero
	if name == "Ult" then
		if hero == "Ben" then
			return
		end
		if st.Meter < 100 or not canAttack(st, character) then
			return
		end
		PlayerState.addMeter(st, -100)
		local def = Config.Heroes[hero]
		shockwave(root.Position, 107, 150, 160, def.Accent, player)
		Net.fire("Notify", player, { Banner = def.Ult .. "!" })
		return
	end
	if name == "Breath" then
		if hero == "Jake" and held and st.Energy > 5 and canAttack(st, character) then
			breathing[player] = aim
		else
			breathing[player] = nil
		end
		Net.fireAll("Fx", { Kind = "Breath", Player = player, On = breathing[player] ~= nil })
		return
	end
	if not canAttack(st, character) then
		return
	end
	if name == "Sig" then
		if hero == "Timmy" and PlayerState.ready(st, "Sig", 1.5) then
			dropAnvil(player, aimPoint(character, aim, 200))
			Net.fire("Notify", player, { Text = "POOF! Anvil!", Color = Color3.fromRGB(255, 230, 80), Time = 1 })
		elseif hero == "XJ9" and PlayerState.ready(st, "Sig", 3) then
			for _ = 1, 6 do
				local v = aim * 50 + Vector3.new(math.random(-20, 20), 30, math.random(-20, 20))
				fire(player, root.Position + Vector3.new(0, 3, 0), v, { Damage = 30, Radius = 0.9, Knockback = 50, Color = Color3.fromRGB(255, 210, 90) }, 1, 1, true)
			end
		end
	elseif name == "Sig2" then
		if hero == "Danny" and st.Energy >= 30 and PlayerState.ready(st, "Sig2", 4) then
			st.Energy = st.Energy - 30
			coneDamage(player, root, aim, 47, 40, 40, 60)
			Net.fireAll("Fx", { Kind = "Wail", Player = player, Dir = aim })
			Net.fire("Notify", player, { Text = "GHOST WAIL!", Color = Color3.fromRGB(120, 255, 150), Time = 1 })
		elseif hero == "Aang" and PlayerState.ready(st, "Sig2", 2) then
			earthPillar(player, root)
		end
	end
end

local function onPound(player)
	local st = PlayerState.get(player)
	local character, _, root = charOf(player)
	if not st or not character or not canAttack(st, character) then
		return
	end
	-- Only a pound the server saw start, from at least a few studs up.
	if not st.PoundAt or os.clock() - st.PoundAt > 3 or not st.PoundStartY or st.PoundStartY - root.Position.Y < 4 then
		return
	end
	st.PoundAt = nil
	if not PlayerState.ready(st, "Pound", 0.7) then
		return
	end
	local scale = math.max(1, bodyScale(character))
	local def = Config.Heroes[st.Hero]
	shockwave(root.Position - Vector3.new(0, 2.5 * scale, 0), Config.Moves.PoundRadius * math.sqrt(scale), 170, Config.Moves.PoundDamage * scale, def and def.Accent or Color3.new(1, 1, 1), player)
end

function Combat.init(systems)
	Net, PlayerState, Enemies, World = systems.Net, systems.Players, systems.Enemies, systems.World
	Net.on("Attack", 20, onAttack)
	Net.on("Ability", 10, onAbility)
	Net.on("Pound", 3, onPound)
	Net.on("Counter", 6, onCounter)
	Net.on("Takedown", 3, onTakedown)
end

function Combat.start()
	Players.PlayerRemoving:Connect(function(player)
		breathing[player] = nil
		regenAt[player] = nil
	end)
	RunService.Heartbeat:Connect(function(dt)
		stepProjectiles(dt)
		for i = #shockwaves, 1, -1 do
			local w = shockwaves[i]
			w.Radius = w.Radius + w.Speed * dt
			hitEnemiesInSphere(w.Center, w.Radius, w.Damage, 1.5, w.Attacker, w.Hit)
			if w.Radius >= w.Max then
				table.remove(shockwaves, i)
			end
		end
		-- Fire breath: energy drains every frame, damage ticks at 10 Hz.
		breathTick = breathTick + dt
		local tick = breathTick >= 0.1
		if tick then
			breathTick = 0
		end
		for player, aim in pairs(breathing) do
			local st = PlayerState.get(player)
			local character, _, root = charOf(player)
			if not st or not character or st.Energy <= 0 or not canAttack(st, character) then
				breathing[player] = nil
				Net.fireAll("Fx", { Kind = "Breath", Player = player, On = false })
			else
				st.Energy = math.max(0, st.Energy - 28 * dt)
				if tick then
					coneDamage(player, root, aim, 27, 25, 7, 3)
				end
			end
		end
		local now = os.clock()
		for player, st in pairs(PlayerState.all()) do
			local character, humanoid, root = charOf(player)
			if character then
				-- Regeneration after a few seconds without damage.
				if now > (regenAt[player] or 0) and humanoid.Health < humanoid.MaxHealth then
					humanoid.Health = math.min(humanoid.MaxHealth, humanoid.Health + Config.Player.Regen * dt)
				end
				-- Cannonbolt rolls through enemies.
				local form = PlayerState.form(st)
				if form and form.Roll then
					local v = root.AssemblyLinearVelocity
					if Vector3.new(v.X, 0, v.Z).Magnitude > 17 then
						for _, e in ipairs(Enemies.list()) do
							if e.Health > 0 and e.Root.Parent and (e.Root.Position - root.Position).Magnitude < 6 and (e.RolledAt or 0) < now then
								e.RolledAt = now + 0.4
								Enemies.damage(e, 80, v.Unit * 50 + Vector3.new(0, 20, 0), player)
							end
						end
					end
				end
			end
		end
	end)
end

return Combat
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX18826"><Properties>
<string name="Name">Courses</string>
<ProtectedString name="Source"><![CDATA[--!nonstrict
-- Timed courses through glowing gates: the Nexus Flight Ring Challenge and
-- Retroville's Hover Race. Each player runs their own attempt; passing gate 1
-- starts the clock, the last gate stops it.

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local MapData = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("MapData"))

local Courses = {}
local Net, Profiles, Progression
local courses = {}  -- { Name, Gates = { { Part, Pos, Radius } } }
local runs = {}     -- [player][courseIndex] = { Next, Start, Best }

function Courses.init(systems)
	Net, Profiles, Progression = systems.Net, systems.Profiles, systems.Progression
end

function Courses.start()
	for levelName, level in pairs(MapData.Levels) do
		local folder = workspace:FindFirstChild(levelName)
		if folder and level.Course then
			local course = { Name = level.Course.Name, Gates = {} }
			for _, gateName in ipairs(level.Course.Gates) do
				local part = folder:FindFirstChild(gateName, true)
				if part then
					local r = math.max(part.Size.X, part.Size.Y, part.Size.Z) * 0.5
					table.insert(course.Gates, { Part = part, Pos = part.Position, Radius = r })
				end
			end
			if #course.Gates > 0 then
				table.insert(courses, course)
			end
		end
	end
	Players.PlayerRemoving:Connect(function(player)
		runs[player] = nil
	end)
	RunService.Heartbeat:Connect(function()
		local now = os.clock()
		for _, player in ipairs(Players:GetPlayers()) do
			local character = player.Character
			local root = character and character:FindFirstChild("HumanoidRootPart")
			if root then
				-- Hover-car drivers count with the car's position.
				local humanoid = character:FindFirstChildOfClass("Humanoid")
				local pos = humanoid and humanoid.SeatPart and humanoid.SeatPart.Position or root.Position
				local mine = runs[player]
				if not mine then
					mine = {}
					runs[player] = mine
				end
				for ci, course in ipairs(courses) do
					local run = mine[ci]
					if not run then
						run = { Next = 1, Start = 0, Best = nil }
						mine[ci] = run
					end
					local gate = course.Gates[run.Next]
					if gate and (gate.Pos - pos).Magnitude < gate.Radius then
						if run.Next == 1 then
							run.Start = now
							Net.fire("Notify", player, { Text = course.Name .. ": GO!", Color = Color3.fromRGB(140, 255, 200), Time = 1.5 })
						end
						run.Next = run.Next + 1
						if run.Next > #course.Gates then
							local time = now - run.Start
							local data = Profiles.get(player)
							local saved = data and data.Best[course.Name]
							run.Best = run.Best or saved
							local best = not run.Best or time < run.Best
							if best then
								run.Best = time
								if data then
									data.Best[course.Name] = math.floor(time * 100) / 100
								end
							end
							Progression.award(player, best and 100 or 50, best and 60 or 25, course.Name)
							Net.fire("Notify", player, { Banner = ("%s: %.2fs%s"):format(course.Name, time, best and "  NEW BEST!" or ""), Color = Color3.fromRGB(140, 255, 200) })
							run.Next = 1
						end
						Net.fire("Fx", player, { Kind = "Gate", Course = ci, Next = run.Next, Gate = course.Gates[run.Next] and course.Gates[run.Next].Part, Count = #course.Gates, Name = course.Name, Best = run.Best })
					end
				end
			end
		end
	end)
end

return Courses
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX18827"><Properties>
<string name="Name">Enemies</string>
<ProtectedString name="Source"><![CDATA[--!nonstrict
-- Enemies, freeflow-combat style: every attack is telegraphed (a wind-up the
-- target sees as a "!" and a COUNTER prompt), so a well-timed counter cancels
-- it. Hits build posture; a broken posture staggers the enemy and opens it to
-- a finisher. Types: Gremlin (melee), Brute (heavy ground slam), Spitter
-- (ranged; its shots can be parried back), Hunter (wanted-level squads).
-- Also runs Retroville's rift patrols (3 waves to close a rift).

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local MapData = require(Shared:WaitForChild("MapData"))

local Enemies = {}
local Net, PlayerState, Combat, Progression, HeatSystem
local list = {}
local rifts = {}
local shots = {}      -- enemy projectiles
local nextShot = -1   -- negative ids: enemy shots (player shots are positive)
local folder
local rng = Random.new(1337)
local PURPLE = Color3.fromRGB(170, 80, 230)

local function addPart(model, root, size, offset, color, material, shape)
	local p = Instance.new("Part")
	p.Size = size
	p.Color = color
	p.Material = material or Enum.Material.SmoothPlastic
	p.Shape = shape or Enum.PartType.Ball
	p.CanCollide = false
	p.CanQuery = false
	p.Massless = true
	p.CFrame = root.CFrame * offset
	p.Parent = model
	local w = Instance.new("WeldConstraint")
	w.Part0 = root
	w.Part1 = p
	w.Parent = p
	return p
end

local function makeModel(typeName, def, pos)
	local model = Instance.new("Model")
	model.Name = typeName
	local s = def.Size
	local root = Instance.new("Part")
	root.Name = "Body"
	root.Shape = Enum.PartType.Ball
	root.Size = Vector3.new(s, s, s)
	root.Color = def.Color
	root.Material = Enum.Material.SmoothPlastic
	root.CFrame = CFrame.new(pos)
	root.CustomPhysicalProperties = PhysicalProperties.new(0.5, 0.3, 0.5)
	root.Parent = model
	local k = s / 3.2
	for _, x in ipairs({ -0.6, 0.6 }) do
		addPart(model, root, Vector3.new(1.1, 1.1, 1.1) * k, CFrame.new(x * k, 0.5 * k, -1.2 * k), Color3.new(1, 1, 1))
		addPart(model, root, Vector3.new(0.5, 0.5, 0.5) * k, CFrame.new(x * k, 0.5 * k, -1.65 * k), Color3.fromRGB(20, 10, 30))
	end
	if typeName == "Brute" then
		for _, x in ipairs({ -1, 1 }) do
			addPart(model, root, Vector3.new(0.6, 2.2, 0.6) * k, CFrame.new(x * 1.1 * k, 1.6 * k, 0) * CFrame.Angles(0, 0, -x * 0.5), Color3.fromRGB(240, 220, 200), nil, Enum.PartType.Block)
			addPart(model, root, Vector3.new(1.2, 2.6, 1.2) * k, CFrame.new(x * 1.7 * k, -0.4 * k, -0.3 * k), def.Color, nil, Enum.PartType.Block)
		end
		addPart(model, root, Vector3.new(2.2, 0.5, 0.4) * k, CFrame.new(0, -0.6 * k, -1.45 * k), Color3.fromRGB(255, 240, 220), Enum.Material.Neon, Enum.PartType.Block)
	elseif typeName == "Spitter" then
		addPart(model, root, Vector3.new(0.9, 0.9, 1.6) * k, CFrame.new(0, -0.3 * k, -1.5 * k), Color3.fromRGB(60, 140, 60), nil, Enum.PartType.Block)
		addPart(model, root, Vector3.new(0.5, 0.5, 0.5) * k, CFrame.new(0, -0.3 * k, -2.3 * k), Color3.fromRGB(200, 255, 120), Enum.Material.Neon)
	elseif typeName == "Hunter" then
		addPart(model, root, Vector3.new(2.6, 0.6, 1.0) * k, CFrame.new(0, 0.5 * k, -1.2 * k), Color3.fromRGB(30, 30, 40), nil, Enum.PartType.Block)
		addPart(model, root, Vector3.new(2.0, 0.15, 0.2) * k, CFrame.new(0, 0.55 * k, -1.72 * k), Color3.fromRGB(255, 60, 60), Enum.Material.Neon, Enum.PartType.Block)
		addPart(model, root, Vector3.new(0.15, 1.6, 0.15) * k, CFrame.new(0.6 * k, 2 * k, 0), Color3.fromRGB(200, 200, 210), nil, Enum.PartType.Block)
	else
		for _, x in ipairs({ -0.6, 0.6 }) do
			addPart(model, root, Vector3.new(0.4, 1.4, 0.4) * k, CFrame.new(x * 1.3 * k, 1.6 * k, 0) * CFrame.Angles(0, 0, -x * 0.6), Color3.fromRGB(90, 30, 140), nil, Enum.PartType.Block)
		end
		addPart(model, root, Vector3.new(1.4, 0.3, 0.3) * k, CFrame.new(0, -0.5 * k, -1.45 * k), Color3.fromRGB(255, 220, 255), Enum.Material.Neon, Enum.PartType.Block)
	end
	local att = Instance.new("Attachment")
	att.Parent = root
	local align = Instance.new("AlignPosition")
	align.Mode = Enum.PositionAlignmentMode.OneAttachment
	align.Attachment0 = att
	align.MaxForce = 6000 * k * k * k
	align.MaxVelocity = def.Speed
	align.Responsiveness = 25
	align.Position = pos
	align.Parent = root
	local orient = Instance.new("AlignOrientation")
	orient.Mode = Enum.OrientationAlignmentMode.OneAttachment
	orient.Attachment0 = att
	orient.MaxTorque = 5000 * k * k * k
	orient.Responsiveness = 15
	orient.Parent = root
	model.PrimaryPart = root
	model:SetAttribute("Enemy", typeName)
	model:SetAttribute("MaxHealth", def.Health)
	model:SetAttribute("Health", def.Health)
	model.Parent = folder
	root:SetNetworkOwner(nil)
	return model, root, align, orient
end

function Enemies.groundAt(pos)
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = { folder }
	local hit = workspace:Raycast(pos + Vector3.new(0, 30, 0), Vector3.new(0, -120, 0), params)
	return hit and hit.Position or pos
end

-- opts: { Rift = index, Mission = tag, HuntFor = player }
function Enemies.spawn(pos, typeName, opts)
	typeName = typeName or "Gremlin"
	opts = opts or {}
	local def = Config.EnemyTypes[typeName]
	pos = Enemies.groundAt(pos) + Vector3.new(0, def.Size * 0.5 + 1, 0)
	local model, root, align, orient = makeModel(typeName, def, pos)
	local e = {
		Model = model, Root = root, Align = align, Orient = orient, Def = def, Type = typeName,
		Health = def.Health, MaxHealth = def.Health, Posture = 0, PostureAt = 0, Staggered = 0,
		State = "Chase", StateUntil = 0, NextAttack = os.clock() + rng:NextNumber(0.5, 2), Stun = 0,
		Radius = def.Size * 0.5, Rift = opts.Rift, Mission = opts.Mission, HuntFor = opts.HuntFor,
		Phase = rng:NextNumber(0, 6.28), Home = pos,
	}
	table.insert(list, e)
	Net.fireAll("Fx", { Kind = "Burst", Pos = pos, Color = def.Color, Count = 12 })
	return e
end

-- Bosses and other custom enemies join the same list so every attack hits them.
function Enemies.register(e)
	table.insert(list, e)
end

function Enemies.list()
	return list
end

function Enemies.count(predicate)
	local n = 0
	for _, e in ipairs(list) do
		if e.Health > 0 and e.Model.Parent and predicate(e) then
			n = n + 1
		end
	end
	return n
end

local function kill(e, attacker)
	e.Health = 0
	Net.fireAll("Fx", { Kind = "Burst", Pos = e.Root.Position, Color = e.Def.Color or PURPLE, Count = e.IsBoss and 120 or 26, Gravity = true })
	if e.OnDeath then
		e.OnDeath(attacker)
	end
	e.Model:Destroy()
	local st = attacker and PlayerState.get(attacker)
	if st then
		PlayerState.addMeter(st, 5)
		st.Kills = st.Kills + 1
		attacker:SetAttribute("Kills", st.Kills)
		if Progression then
			Progression.award(attacker, e.Def.Xp or 10, e.Def.Cash or 5, e.Type)
		end
		if HeatSystem and e.Def.Heat then
			HeatSystem.addChaos(attacker, e.Def.Heat)
		end
	end
end

-- Damage from a player. opts.Melee lets a hit on a staggered enemy become a finisher.
function Enemies.damage(e, amount, knock, attacker, opts)
	if e.Health <= 0 or not e.Model.Parent then
		return false
	end
	local now = os.clock()
	local finisher = opts and opts.Melee and e.Staggered > now
	if finisher then
		amount = e.IsBoss and amount * 3 + 120 or e.Health
		e.Staggered = 0
		e.Model:SetAttribute("Staggered", nil)
		Net.fireAll("Fx", { Kind = "Finisher", Pos = e.Root.Position, Model = e.Model, Attacker = attacker })
		local humanoid = attacker and attacker.Character and attacker.Character:FindFirstChildOfClass("Humanoid")
		if humanoid then
			humanoid.Health = math.min(humanoid.MaxHealth, humanoid.Health + Config.Combat.FinisherHeal)
		end
	end
	local st = attacker and PlayerState.get(attacker)
	if st and Progression then
		amount = amount * (st.DamageMul or 1)
	end
	e.Health = e.Health - amount
	e.Model:SetAttribute("Health", math.max(0, math.floor(e.Health)))
	if not e.IsBoss or finisher then
		e.Stun = 0.35
		e.Align.Enabled = false
		e.Root.AssemblyLinearVelocity = knock
	end
	if e.State == "Windup" and not e.IsBoss and (opts and opts.Melee) then
		-- A solid hit interrupts small enemies' wind-ups.
		e.State = "Recover"
		e.StateUntil = now + 0.4
		e.Model:SetAttribute("Windup", nil)
	end
	-- Posture.
	e.Posture = e.Posture + amount * (opts and opts.Posture or 1)
	e.PostureAt = now
	if e.Posture >= (e.Def.Posture or 100) and e.Staggered < now and e.Health > 0 then
		e.Posture = 0
		e.Staggered = now + Config.Combat.StaggerTime
		e.State = "Recover"
		e.StateUntil = e.Staggered
		e.Model:SetAttribute("Windup", nil)
		e.Model:SetAttribute("Staggered", true)
		Net.fireAll("Fx", { Kind = "Stagger", Pos = e.Root.Position, Model = e.Model })
	end
	Net.fireAll("Fx", { Kind = "Hit", Pos = e.Root.Position, Color = Color3.new(1, 1, 1), Model = e.Model, Attacker = attacker })
	if st then
		PlayerState.addMeter(st, amount * 0.06 * (st.MeterMul or 1))
		if Combat then
			Combat.registerHit(attacker)
		end
	end
	if e.Health <= 0 then
		kill(e, attacker)
		return true
	end
	return false
end

-- Counter: cancel the wind-up of every enemy about to hit this player.
function Enemies.counter(player, pos)
	local countered = 0
	for _, e in ipairs(list) do
		if e.Health > 0 and e.Model.Parent and e.State == "Windup" and (e.Target == player or (e.Root.Position - pos).Magnitude < Config.Combat.CounterRange) then
			if (e.Root.Position - pos).Magnitude < Config.Combat.CounterRange + e.Radius then
				e.State = "Recover"
				e.StateUntil = os.clock() + 1.0
				e.Model:SetAttribute("Windup", nil)
				local away = e.Root.Position - pos
				away = Vector3.new(away.X, 0, away.Z)
				away = away.Magnitude > 0.1 and away.Unit or Vector3.new(0, 0, 1)
				Enemies.damage(e, Config.Combat.CounterDamage, away * 45 + Vector3.new(0, 20, 0), player, { Posture = 3, Melee = false })
				countered = countered + 1
			end
		end
	end
	-- Parry incoming shots back at whoever fired them.
	for id, s in pairs(shots) do
		if (s.Pos - pos).Magnitude < 12 and s.Vel:Dot(pos - s.Pos) > 0 then
			Net.fireAll("Fx", { Kind = "ShotEnd", Id = id, Pos = s.Pos })
			shots[id] = nil
			if s.Shooter and s.Shooter.Health > 0 then
				Enemies.damage(s.Shooter, s.Damage * 2.5, Vector3.new(0, 25, 0), player, { Posture = 2 })
				Net.fireAll("Fx", { Kind = "Deflect", From = s.Pos, To = s.Shooter.Root.Position })
			end
			countered = countered + 1
		end
	end
	return countered
end

local function nearestPlayer(pos, range)
	local best, bestDist = nil, range or Config.Enemy.AggroRange
	for _, player in ipairs(Players:GetPlayers()) do
		local character = player.Character
		local root = character and character:FindFirstChild("HumanoidRootPart")
		local humanoid = character and character:FindFirstChildOfClass("Humanoid")
		if root and humanoid and humanoid.Health > 0 then
			local d = (root.Position - pos).Magnitude
			if d < bestDist then
				best, bestDist = player, d
			end
		end
	end
	return best, bestDist
end

local function rootOf(player)
	local character = player and player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if humanoid and humanoid.Health > 0 then
		return character:FindFirstChild("HumanoidRootPart")
	end
	return nil
end

function Enemies.fireShot(shooter, from, target, speed, damage, color)
	local id = nextShot
	nextShot = nextShot - 1
	local vel = (target - from).Unit * speed
	shots[id] = { Pos = from, Vel = vel, Life = 3, Damage = damage, Shooter = shooter }
	Net.fireAll("Fx", { Kind = "Shot", Id = id, Pos = from, Vel = vel, Color = color or Color3.fromRGB(150, 255, 90), Radius = 0.9, Life = 3 })
end

local function strike(e, now)
	local def = e.Def
	local target = e.Target
	local troot = rootOf(target)
	e.Model:SetAttribute("Windup", nil)
	e.State = "Recover"
	e.StateUntil = now + 0.6
	e.NextAttack = now + rng:NextNumber(1.2, 2.2)
	if not troot then
		return
	end
	if def.Ranged then
		Enemies.fireShot(e, e.Root.Position, troot.Position, 75, def.Damage, def.Color)
		return
	end
	-- Lunge, then check the hit.
	e.Align.MaxVelocity = def.Speed * 4
	e.Align.Position = troot.Position
	task.delay(0.15, function()
		e.Align.MaxVelocity = def.Speed
		if e.Health <= 0 or not e.Model.Parent then
			return
		end
		if def.Slam then
			Net.fireAll("Fx", { Kind = "Shockwave", Pos = e.Root.Position - Vector3.new(0, e.Radius, 0), Radius = def.Slam, Time = 0.3, Color = def.Color })
			for _, player in ipairs(Players:GetPlayers()) do
				local r = rootOf(player)
				if r and (r.Position - e.Root.Position).Magnitude < def.Slam + 2 then
					Combat.damagePlayer(player, def.Damage, e.Root.Position)
				end
			end
		else
			local r = rootOf(target)
			if r and (r.Position - e.Root.Position).Magnitude < def.Reach + e.Radius + 2 then
				Combat.damagePlayer(target, def.Damage, e.Root.Position)
			end
		end
	end)
end

local function think(e, now, step)
	local def = e.Def
	if e.Stun > 0 then
		e.Stun = e.Stun - step
		if e.Stun <= 0 then
			e.Align.Enabled = true
		end
	end
	-- Posture recovers when left alone.
	if now - e.PostureAt > 2 and e.Posture > 0 then
		e.Posture = math.max(0, e.Posture - Config.Combat.PostureDecay * step)
	end
	local pos = e.Root.Position
	if e.Staggered > now then
		e.Align.Position = pos
		return
	elseif e.Model:GetAttribute("Staggered") then
		e.Model:SetAttribute("Staggered", nil)
	end
	if e.State == "Windup" then
		if now >= e.StateUntil then
			strike(e, now)
		end
		return
	end
	if e.State == "Recover" and now < e.StateUntil then
		return
	end
	e.State = "Chase"
	local player, dist
	if e.HuntFor and rootOf(e.HuntFor) then
		player = e.HuntFor
		dist = (rootOf(player).Position - pos).Magnitude
	else
		player, dist = nearestPlayer(pos)
	end
	local bob = math.sin(now * 3 + e.Phase) * 1.2
	if not player then
		e.Align.Position = e.Home + Vector3.new(math.cos(now * 0.5 + e.Phase) * 6, 2 + bob, math.sin(now * 0.5 + e.Phase) * 6)
		return
	end
	local target = rootOf(player).Position
	local flat = Vector3.new(target.X - pos.X, 0, target.Z - pos.Z)
	if flat.Magnitude > 0.1 then
		e.Orient.CFrame = CFrame.lookAt(Vector3.zero, flat.Unit)
	end
	if def.Ranged and dist < def.KeepAway then
		e.Align.Position = pos - flat.Unit * 6 + Vector3.new(0, bob, 0)
	else
		e.Align.Position = target + Vector3.new(0, 1 + bob, 0)
	end
	if dist < def.Reach + e.Radius + 1.5 and now >= e.NextAttack then
		e.State = "Windup"
		e.StateUntil = now + def.Windup
		e.Target = player
		e.Align.Position = pos
		e.Model:SetAttribute("Windup", workspace:GetServerTimeNow())
		Net.fireAll("Fx", { Kind = "Telegraph", Model = e.Model, Target = player, Time = def.Windup, Ranged = def.Ranged == true })
	end
end

local function stepShots(dt)
	for id, s in pairs(shots) do
		s.Life = s.Life - dt
		local move = s.Vel * dt
		local hitPlayer
		for _, player in ipairs(Players:GetPlayers()) do
			local r = rootOf(player)
			if r then
				local rel = r.Position - s.Pos
				local along = math.clamp(rel:Dot(move.Unit), 0, move.Magnitude)
				if (r.Position - (s.Pos + move.Unit * along)).Magnitude < 2.6 then
					hitPlayer = player
				end
			end
		end
		if hitPlayer then
			Combat.damagePlayer(hitPlayer, s.Damage, s.Pos)
			Net.fireAll("Fx", { Kind = "ShotEnd", Id = id, Pos = s.Pos })
			shots[id] = nil
		elseif s.Life <= 0 then
			Net.fireAll("Fx", { Kind = "ShotEnd", Id = id, Pos = s.Pos })
			shots[id] = nil
		else
			s.Pos = s.Pos + move
		end
	end
end

local function buildRiftVisual(pos)
	local model = Instance.new("Model")
	model.Name = "Rift"
	for i = 0, 23 do
		local a = i / 24 * math.pi * 2
		local p = Instance.new("Part")
		p.Anchored = true
		p.CanCollide = false
		p.CanQuery = false
		p.Material = Enum.Material.Neon
		p.Color = i % 2 == 0 and PURPLE or Color3.fromRGB(255, 120, 220)
		p.Size = Vector3.new(1.6, 1.6, 2.4)
		p.CFrame = CFrame.new(pos + Vector3.new(math.cos(a) * 9, 11 + math.sin(a) * 9, 0)) * CFrame.Angles(0, 0, a)
		p.Parent = model
	end
	local core = Instance.new("Part")
	core.Name = "Core"
	core.Anchored = true
	core.CanCollide = false
	core.CanQuery = false
	core.Material = Enum.Material.Neon
	core.Color = Color3.fromRGB(60, 20, 90)
	core.Transparency = 0.3
	core.Shape = Enum.PartType.Cylinder
	core.Size = Vector3.new(0.6, 16, 16)
	core.CFrame = CFrame.new(pos + Vector3.new(0, 11, 0)) * CFrame.Angles(0, math.pi / 2, 0)
	core.Parent = model
	local emitter = Instance.new("ParticleEmitter")
	emitter.Color = ColorSequence.new(PURPLE, Color3.fromRGB(255, 150, 255))
	emitter.Rate = 30
	emitter.Speed = NumberRange.new(4, 10)
	emitter.SpreadAngle = Vector2.new(180, 180)
	emitter.Lifetime = NumberRange.new(0.6, 1.4)
	emitter.LightEmission = 1
	emitter.Parent = core
	model.Parent = folder
	return model
end

local WAVES = {
	{ Gremlin = 4 },
	{ Gremlin = 3, Spitter = 2 },
	{ Gremlin = 3, Spitter = 2, Brute = 1 },
}

function Enemies.spawnWave(center, composition, opts, spread)
	for typeName, n in pairs(composition) do
		for _ = 1, n do
			Enemies.spawn(center + Vector3.new(rng:NextNumber(-spread, spread), 6, rng:NextNumber(-spread, spread)), typeName, opts)
		end
	end
end

function Enemies.allRiftsClosed()
	for _, r in ipairs(rifts) do
		if not r.Closed then
			return false
		end
	end
	return #rifts > 0
end

function Enemies.init(systems)
	Net, PlayerState, Combat = systems.Net, systems.Players, systems.Combat
	Progression, HeatSystem = systems.Progression, systems.Heat
	folder = Instance.new("Folder")
	folder.Name = "Enemies"
	folder.Parent = workspace
end

function Enemies.start()
	for levelName, level in pairs(MapData.Levels) do
		for _, r in ipairs(level.Rifts) do
			table.insert(rifts, { Name = r.Name, Pos = r.Pos, Level = levelName, Wave = 0, Closed = false, Visual = buildRiftVisual(r.Pos) })
		end
	end
	Enemies.onAllRiftsClosed = Enemies.onAllRiftsClosed or function() end

	local accum = 0
	RunService.Heartbeat:Connect(function(dt)
		stepShots(dt)
		accum = accum + dt
		if accum < 0.05 then
			return
		end
		local step = accum
		accum = 0
		local now = os.clock()
		for i = #list, 1, -1 do
			local e = list[i]
			if not e.Model.Parent or e.Health <= 0 then
				table.remove(list, i)
			elseif e.Think then
				e.Think(e, now, step)
			else
				think(e, now, step)
			end
		end
		for index, rift in ipairs(rifts) do
			if not rift.Closed then
				if rift.Wave == 0 then
					local player, dist = nearestPlayer(rift.Pos)
					if player and dist < 80 then
						rift.Wave = 1
						Net.fireAll("Notify", { Text = "A dimensional rift opens! Wave 1/3", Color = PURPLE })
						Enemies.spawnWave(rift.Pos, WAVES[1], { Rift = index }, 25)
					end
				elseif Enemies.count(function(e)
					return e.Rift == index
				end) == 0 then
					if rift.Wave >= 3 then
						rift.Closed = true
						rift.Visual:Destroy()
						Net.fireAll("Notify", { Banner = "RIFT CLOSED!", Text = rift.Name:gsub("_", " ") .. " is safe again" })
						for player, st in pairs(PlayerState.all()) do
							PlayerState.addMeter(st, 25)
							local root = rootOf(player)
							if Progression and root and (root.Position - rift.Pos).Magnitude < 250 then
								Progression.award(player, 120, 60, "Rift closed")
							end
						end
						if Enemies.allRiftsClosed() then
							Enemies.onAllRiftsClosed()
						end
					else
						rift.Wave = rift.Wave + 1
						Net.fireAll("Notify", { Text = "Wave " .. rift.Wave .. "/3", Color = PURPLE })
						Enemies.spawnWave(rift.Pos, WAVES[rift.Wave], { Rift = index }, 30)
					end
				end
			end
		end
	end)

	task.spawn(function()
		while true do
			task.wait(150)
			for _, rift in ipairs(rifts) do
				if rift.Closed then
					rift.Closed = false
					rift.Wave = 0
					rift.Visual = buildRiftVisual(rift.Pos)
				end
			end
		end
	end)
end

function Enemies.rifts()
	return rifts
end

return Enemies
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX18828"><Properties>
<string name="Name">Heat</string>
<ProtectedString name="Source"><![CDATA[--!nonstrict
-- Wanted level, open-world-crime-game style but for superheroes: the more rift
-- monsters you smash in Retroville, the more "threat stars" you collect.
-- While you have stars, Hunter squads are dispatched after you; keep fighting
-- and it escalates, break away (no combat, no hunters near) and the stars
-- cool off one by one. Shown on the HUD as flashing stars while cooling.

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local HeatRules = require(Shared:WaitForChild("Heat"))

local HeatSystem = {}
local Net, PlayerState, Enemies
local heat = {} -- [player] = Heat

local function heatOf(player)
	local h = heat[player]
	if not h then
		h = HeatRules.new(Config)
		heat[player] = h
	end
	return h
end

local function inRetroville(player)
	local st = PlayerState.get(player)
	return st and st.Level == Config.Levels.Retroville
end

function HeatSystem.addChaos(player, amount)
	if not inRetroville(player) then
		return
	end
	local h = heatOf(player)
	local before = h:Stars()
	h:AddChaos(amount, os.clock())
	if h:Stars() > before then
		Net.fire("Notify", player, { Text = ("Threat level %d! Hunters are coming for you"):format(h:Stars()), Color = Color3.fromRGB(255, 120, 90), Time = 2.5 })
	end
end

function HeatSystem.clear(player)
	heat[player] = nil
	player:SetAttribute("Heat", 0)
	player:SetAttribute("HeatCooling", false)
end

local function huntersNear(player, root)
	for _, e in ipairs(Enemies.list()) do
		if e.HuntFor == player and e.Health > 0 and e.Model.Parent and (e.Root.Position - root.Position).Magnitude < Config.Heat.NearRange then
			return true
		end
	end
	return false
end

local function dispatch(player, root, count)
	for i = 1, count do
		local a = (i / count) * math.pi * 2 + math.random() * 0.5
		local pos = root.Position + Vector3.new(math.cos(a) * 75, 10, math.sin(a) * 75)
		Enemies.spawn(pos, "Hunter", { HuntFor = player })
	end
end

function HeatSystem.init(systems)
	Net, PlayerState, Enemies = systems.Net, systems.Players, systems.Enemies
end

function HeatSystem.start()
	Players.PlayerRemoving:Connect(function(player)
		heat[player] = nil
	end)
	local accum = 0
	RunService.Heartbeat:Connect(function(dt)
		accum = accum + dt
		if accum < 0.25 then
			return
		end
		local step = accum
		accum = 0
		local now = os.clock()
		for player, h in pairs(heat) do
			local character = player.Character
			local root = character and character:FindFirstChild("HumanoidRootPart")
			local humanoid = character and character:FindFirstChildOfClass("Humanoid")
			if not inRetroville(player) or not root or not humanoid or humanoid.Health <= 0 then
				-- Leaving the world or getting KO'd clears your threat.
				if h.Value > 0 then
					HeatSystem.clear(player)
				end
			else
				local near = huntersNear(player, root)
				local spawnCount = h:Tick(step, now, near)
				if spawnCount > 0 then
					dispatch(player, root, spawnCount)
				end
				player:SetAttribute("Heat", h.Value)
				player:SetAttribute("HeatCooling", h:Cooling(now, near))
			end
		end
	end)
end

return HeatSystem
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX18829"><Properties>
<string name="Name">Heroes</string>
<ProtectedString name="Source"><![CDATA[--!nonstrict
-- Hero selection, looks and stats, Ben's Omnitrix, and replication of each
-- client's movement state (flying, dodging, emoting...) as character
-- attributes so every client can animate every character.

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Omnitrix = require(Shared:WaitForChild("Omnitrix"))
local Looks = require(script.Parent.Parent:WaitForChild("Lib"):WaitForChild("Looks"))

local Heroes = {}
local Net, PlayerState, World

-- Movement state keys the client may report, with their type and limits.
local STATE_KEYS = {
	Flying = "boolean", Gliding = "boolean", Dodge = "boolean", DodgeAir = "boolean", Pounding = "boolean",
	Emote = "boolean", WallSlide = "boolean", Boosting = "boolean", Jetpack = "boolean", Scooter = "boolean",
	Intangible = "boolean", Takeoff = "boolean", Grapple = "boolean", Breath = "boolean",
	Slide = "boolean", WallRun = "boolean", Climb = "boolean", Swing = "boolean", WallSide = "number", Lunge = "boolean",
	DodgeSide = "number", FlyBank = "number", FlyPitch = "number",
}

local function heroDef(st)
	return Config.Heroes[st.Hero] or Config.Heroes.Jimmy
end

-- Walk speed / jump from the hero or active form.
function Heroes.applyStats(player)
	local st = PlayerState.get(player)
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if not st or not humanoid then
		return
	end
	local hero = heroDef(st)
	local form = PlayerState.form(st)
	humanoid.UseJumpPower = false
	humanoid.WalkSpeed = form and form.Walk or hero.Walk
	humanoid.JumpHeight = form and form.JumpHeight or hero.JumpHeight
	character:SetAttribute("Hero", st.Hero)
	character:SetAttribute("Form", form and form.Id or nil)
	character:SetAttribute("AirJumps", form and 0 or hero.AirJumps)
	character:SetAttribute("Meter", math.floor(st.Meter))
end

function Heroes.refreshLook(player)
	local st = PlayerState.get(player)
	local character = player.Character
	if not st or not character then
		return
	end
	Heroes.applyStats(player)
	task.spawn(Looks.apply, character, st.Hero, PlayerState.form(st))
end

function Heroes.select(player, heroId)
	local st = PlayerState.get(player)
	if not st or not Config.Heroes[heroId] then
		return false
	end
	st.Hero = heroId
	st.Omni = Omnitrix.new(Config.Omnitrix)
	st.Energy = Config.Player.MaxEnergy
	st.Intangible = false
	Heroes.refreshLook(player)
	local hero = Config.Heroes[heroId]
	Net.fire("Notify", player, { Text = "Now playing: " .. hero.Name .. " (" .. hero.Universe .. ")", Color = hero.Accent })
	Net.fireAll("Fx", { Kind = "Burst", Pos = player.Character and player.Character:GetPivot().Position, Color = hero.Accent, Count = 40 })
	return true
end

local function onCharacter(player, character)
	local humanoid = character:WaitForChild("Humanoid", 10)
	if not humanoid then
		return
	end
	-- Procedural animation replaces the default Animate script on R15 rigs.
	if humanoid.RigType == Enum.HumanoidRigType.R15 then
		local animate = character:WaitForChild("Animate", 2)
		if animate then
			animate:Destroy()
		end
	end
	humanoid.MaxHealth = Config.Player.MaxHealth
	humanoid.Health = Config.Player.MaxHealth
	humanoid.BreakJointsOnDeath = false
	local st = PlayerState.get(player)
	if st and st.Hero == "Ben" then
		st.Omni = Omnitrix.new(Config.Omnitrix)
	end
	Heroes.refreshLook(player)
end

local function onState(player, state)
	local st = PlayerState.get(player)
	local character = player.Character
	if not st or not character or type(state) ~= "table" then
		return
	end
	local hero = heroDef(st)
	for key, kind in pairs(STATE_KEYS) do
		local v = state[key]
		if type(v) == kind and not (kind == "number" and v ~= v) then
			if kind == "number" then
				v = math.clamp(v, -90, 90)
				if key == "DodgeSide" then
					v = v < 0 and -1 or 1
				end
			end
			-- Only heroes who can fly report flight; only Danny goes intangible.
			if key == "Flying" and v and not (hero.CanFly and not PlayerState.form(st)) then
				v = false
			end
			if key == "Intangible" then
				-- Same 15-energy threshold as the client to switch on.
				v = v and st.Hero == "Danny" and (st.Intangible and st.Energy > 0 or st.Energy >= 15)
				st.Intangible = v
			end
			if key == "Pounding" and v and not character:GetAttribute("MvPounding") then
				local root = character:FindFirstChild("HumanoidRootPart")
				st.PoundStartY = root and root.Position.Y or nil
				st.PoundAt = os.clock()
			end
			if key == "Dodge" and v and not character:GetAttribute("MvDodge") then
				-- Server-side dodge cooldown bounds the immunity window.
				local now = os.clock()
				-- Immunity is much shorter than the cooldown, so toggling can't chain it.
				if now - st.LastDodge >= Config.Moves.DodgeCooldown * 0.9 then
					st.LastDodge = now
					st.DodgeUntil = now + 0.25
				else
					v = false
				end
			end
			character:SetAttribute("Mv" .. key, v)
		end
	end
end

local function onOmnitrix(player, action, slot)
	local st = PlayerState.get(player)
	if not st or st.Hero ~= "Ben" or type(action) ~= "string" then
		return
	end
	local m = st.Omni
	local ok = false
	if action == "dial" then
		ok = m:OpenDial()
	elseif action == "cancel" then
		ok = m:CancelDial()
	elseif action == "slot" and type(slot) == "number" then
		if m.State == Omnitrix.State.Selecting then
			ok = m:Confirm(slot)
		else
			ok = m:QuickSwap(slot)
		end
	elseif action == "glitch" then
		ok = m:TriggerGlitch()
		if ok then
			Net.fire("Notify", player, { Text = "MASTER CONTROL GLITCH - Cannonbolt shield!", Color = Color3.fromRGB(255, 220, 80) })
		end
	elseif action == "overclock" then
		if st.Meter >= 100 then
			ok = m:TriggerOverclock()
			if ok then
				PlayerState.addMeter(st, -100)
				Net.fire("Notify", player, { Banner = "WAY BIG OVERCLOCK!" })
			end
		end
	end
	if not ok and action ~= "cancel" and action ~= "dial" then
		Net.fire("Notify", player, { Text = m.State == Omnitrix.State.Recharging and "Omnitrix is recharging..." or "Can't transform right now", Color = Color3.fromRGB(255, 140, 120), Time = 1.5 })
	end
end

function Heroes.init(systems)
	Net, PlayerState, World = systems.Net, systems.Players, systems.World
	Net.on("State", 20, onState)
	Net.on("Omnitrix", 8, onOmnitrix)
	Net.on("SelectHero", 2, function(player, heroId)
		if type(heroId) ~= "string" then
			return
		end
		if World and not World.nearTerminal(player) then
			Net.fire("Notify", player, { Text = "Walk up to a dimensional terminal to swap heroes", Time = 2 })
			return
		end
		Heroes.select(player, heroId)
	end)
end

function Heroes.start()
	local function hook(player)
		player.CharacterAdded:Connect(function(character)
			onCharacter(player, character)
		end)
		if player.Character then
			task.spawn(onCharacter, player, player.Character)
		end
	end
	Players.PlayerAdded:Connect(hook)
	for _, player in ipairs(Players:GetPlayers()) do
		hook(player)
	end

	-- Omnitrix ticks, Danny's intangibility energy, and form changes.
	RunService.Heartbeat:Connect(function(dt)
		for player, st in pairs(PlayerState.all()) do
			local character = player.Character
			if st.Hero == "Ben" and character then
				local before = st.Omni.ActiveForm
				local beforeState = st.Omni.State
				st.Omni:Tick(dt)
				if st.Omni.ActiveForm ~= before then
					Heroes.refreshLook(player)
					local form = PlayerState.form(st)
					if form then
						Net.fire("Notify", player, { Text = "It's " .. form.Id .. "!", Color = Config.Heroes.Ben.Accent, Time = 2.5 })
					end
				end
				if st.Omni.State ~= beforeState then
					character:SetAttribute("Omnitrix", st.Omni.State)
					if beforeState == Omnitrix.State.Recharging and st.Omni.State == Omnitrix.State.Human then
						Net.fire("Notify", player, { Text = "Omnitrix recharged", Color = Color3.fromRGB(90, 255, 90), Time = 2 })
					end
				end
				character:SetAttribute("AlienTime", math.ceil(st.Omni.AlienTimeRemaining))
			end
			if st.Intangible then
				st.Energy = math.max(0, st.Energy - 12 * dt)
				if st.Energy <= 0 and character then
					st.Intangible = false
					character:SetAttribute("MvIntangible", false)
				end
			elseif st.Energy < Config.Player.MaxEnergy then
				st.Energy = math.min(Config.Player.MaxEnergy, st.Energy + Config.Player.EnergyRegen * dt)
			end
		end
	end)
end

return Heroes
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX18830"><Properties>
<string name="Name">Missions</string>
<ProtectedString name="Source"><![CDATA[--!nonstrict
-- Open-world missions: glowing markers around Retroville. Walk up and press E
-- to start; each has an objective, a waypoint and a timer, and pays XP and
-- cash. Completions are saved.
--   Rift Rush        clear three waves at Downtown before time runs out
--   Express Delivery hop in the delivery hover car, rush it to the Neutron house
--   Rooftop Run      reach the tower-top checkpoints by any means
--   Titan Hunt       summon and defeat the Rift Titan

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local MapData = require(Shared:WaitForChild("MapData"))

local Missions = {}
local Net, PlayerState, Enemies, World, Boss, Progression, Profiles
local active = {} -- [player] = mission run

local DEFS = {
	{ Id = "RiftRush", Name = "Rift Rush", Time = 150, Xp = 250, Cash = 150, Anchor = "Downtown", Blurb = "Clear three waves of rift monsters" },
	{ Id = "Delivery", Name = "Express Delivery", Time = 75, Xp = 200, Cash = 180, Anchor = "School", Blurb = "Rush the delivery hover car to the Neutron house" },
	{ Id = "Rooftop", Name = "Rooftop Run", Time = 110, Xp = 220, Cash = 140, Anchor = "TowerBase", Blurb = "Hit every tower-top checkpoint" },
	{ Id = "Titan", Name = "Titan Hunt", Time = 300, Xp = 300, Cash = 200, Anchor = "Plaza", Blurb = "Bring down the Rift Titan" },
}

local function rootOf(player)
	local character = player and player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if humanoid and humanoid.Health > 0 then
		return character:FindFirstChild("HumanoidRootPart"), humanoid
	end
	return nil
end

local function objective(player, run, text, pos)
	run.Text = text
	run.Waypoint = pos
	Net.fire("Objective", player, { Id = run.Def.Id, Name = run.Def.Name, Text = text, Pos = pos, Ends = run.EndsServer })
end

local function finish(player, success, reason)
	local run = active[player]
	if not run then
		return
	end
	active[player] = nil
	if run.Cleanup then
		run.Cleanup()
	end
	Net.fire("Objective", player, { Clear = true })
	if success then
		Net.fire("Notify", player, { Banner = "MISSION PASSED", Text = run.Def.Name, Color = Color3.fromRGB(255, 220, 90) })
		Progression.award(player, run.Def.Xp, run.Def.Cash, run.Def.Name)
		local data = Profiles.get(player)
		if data then
			data.Missions[run.Def.Id] = (data.Missions[run.Def.Id] or 0) + 1
		end
	else
		Net.fire("Notify", player, { Banner = "MISSION FAILED", Text = reason or run.Def.Name, Color = Color3.fromRGB(255, 110, 100) })
	end
end

local STARTERS = {}

STARTERS.RiftRush = function(player, run, anchor)
	run.Tag = "Mission_" .. player.UserId
	run.Wave = 1
	local waves = { { Gremlin = 4, Spitter = 1 }, { Gremlin = 4, Spitter = 2 }, { Gremlin = 3, Spitter = 2, Brute = 1 } }
	Enemies.spawnWave(anchor, waves[1], { Mission = run.Tag }, 25)
	objective(player, run, "Clear the rift monsters: wave 1/3", anchor)
	run.Tick = function()
		local alive = Enemies.count(function(e)
			return e.Mission == run.Tag
		end)
		if alive == 0 then
			if run.Wave >= 3 then
				finish(player, true)
			else
				run.Wave = run.Wave + 1
				Enemies.spawnWave(anchor, waves[run.Wave], { Mission = run.Tag }, 30)
				objective(player, run, "Clear the rift monsters: wave " .. run.Wave .. "/3", anchor)
			end
		end
	end
	run.Cleanup = function()
		for _, e in ipairs(Enemies.list()) do
			if e.Mission == run.Tag and e.Model.Parent then
				e.Model:Destroy()
			end
		end
	end
end

STARTERS.Delivery = function(player, run, anchor)
	local dest = MapData.Anchors.NeutronHouse
	local car = World.buildHoverCar(anchor + Vector3.new(14, 0, 0), 0, Color3.fromRGB(250, 200, 40))
	run.Car = car
	objective(player, run, "Get in the delivery hover car", car.PrimaryPart.Position)
	run.Tick = function()
		if not car.Parent then
			finish(player, false, "The delivery car was lost")
			return
		end
		local _, humanoid = rootOf(player)
		local seat = humanoid and humanoid.SeatPart
		local inCar = seat and seat:IsDescendantOf(car)
		if inCar and run.Text ~= "Deliver the package!" then
			objective(player, run, "Deliver the package!", dest)
		elseif not inCar and run.Text == "Deliver the package!" then
			objective(player, run, "Get back in the delivery hover car", car.PrimaryPart.Position)
		end
		if inCar and (car.PrimaryPart.Position - dest).Magnitude < 30 then
			finish(player, true)
		end
	end
	run.Cleanup = function()
		task.delay(8, function()
			if car.Parent then
				car:Destroy()
			end
		end)
	end
end

STARTERS.Rooftop = function(player, run)
	local points = MapData.Anchors.Towers
	run.Index = 1
	local rings = {}
	for i, p in ipairs(points) do
		local ring = Instance.new("Part")
		ring.Name = "Checkpoint"
		ring.Anchored = true
		ring.CanCollide = false
		ring.CanQuery = false
		ring.Shape = Enum.PartType.Cylinder
		ring.Material = Enum.Material.Neon
		ring.Color = i == 1 and Color3.fromRGB(255, 220, 60) or Color3.fromRGB(120, 255, 210)
		ring.Transparency = 0.45
		ring.Size = Vector3.new(0.6, 16, 16)
		ring.CFrame = CFrame.new(p + Vector3.new(0, 4, 0)) * CFrame.Angles(0, 0, math.pi / 2)
		ring.Parent = workspace
		rings[i] = ring
	end
	objective(player, run, "Checkpoint 1/" .. #points, points[1])
	run.Tick = function()
		local root = rootOf(player)
		local p = points[run.Index]
		if root and p and (root.Position - (p + Vector3.new(0, 4, 0))).Magnitude < 12 then
			rings[run.Index]:Destroy()
			Net.fire("Fx", player, { Kind = "Burst", Pos = p, Color = Color3.fromRGB(255, 220, 60), Count = 30 })
			run.Index = run.Index + 1
			if run.Index > #points then
				finish(player, true)
			else
				rings[run.Index].Color = Color3.fromRGB(255, 220, 60)
				objective(player, run, ("Checkpoint %d/%d"):format(run.Index, #points), points[run.Index])
			end
		end
	end
	run.Cleanup = function()
		for _, ring in pairs(rings) do
			if ring.Parent then
				ring:Destroy()
			end
		end
	end
end

STARTERS.Titan = function(player, run, anchor)
	local done = false
	local boss = Boss.spawn(anchor, function()
		done = true
	end)
	objective(player, run, "Defeat the " .. Config.Boss.Name, boss and boss.Root.Position or anchor)
	run.Tick = function()
		local current = Boss.active()
		if done or not current then
			finish(player, true)
		elseif current.Root.Parent then
			run.Waypoint = current.Root.Position
		end
	end
	run.AllowDeath = true
end

local function start(player, def)
	if active[player] then
		Net.fire("Notify", player, { Text = "Finish your current mission first", Time = 2 })
		return
	end
	local st = PlayerState.get(player)
	if not st or st.Level ~= Config.Levels.Retroville then
		return
	end
	local anchor = MapData.Anchors[def.Anchor]
	local run = { Def = def, Ends = os.clock() + def.Time, EndsServer = workspace:GetServerTimeNow() + def.Time }
	active[player] = run
	Net.fire("Notify", player, { Banner = string.upper(def.Name), Text = def.Blurb, Color = Color3.fromRGB(255, 220, 90) })
	STARTERS[def.Id](player, run, anchor)
end

local function buildMarker(def)
	local pos = MapData.Anchors[def.Anchor]
	if not pos then
		return
	end
	local ground = Enemies.groundAt(pos)
	local marker = Instance.new("Part")
	marker.Name = "MissionMarker_" .. def.Id
	marker.Anchored = true
	marker.CanCollide = false
	marker.CanQuery = false
	marker.Shape = Enum.PartType.Cylinder
	marker.Material = Enum.Material.Neon
	marker.Color = Color3.fromRGB(255, 210, 60)
	marker.Transparency = 0.4
	marker.Size = Vector3.new(0.4, 8, 8)
	marker.CFrame = CFrame.new(ground + Vector3.new(0, 0.3, 0)) * CFrame.Angles(0, 0, math.pi / 2)
	marker:SetAttribute("Mission", def.Name)
	marker.Parent = workspace:FindFirstChild("Interactables") or workspace
	local beam = Instance.new("Part")
	beam.Anchored = true
	beam.CanCollide = false
	beam.CanQuery = false
	beam.Material = Enum.Material.Neon
	beam.Color = Color3.fromRGB(255, 210, 60)
	beam.Transparency = 0.7
	beam.Size = Vector3.new(1.5, 80, 1.5)
	beam.CFrame = CFrame.new(ground + Vector3.new(0, 40, 0))
	beam.Parent = marker
	local prompt = Instance.new("ProximityPrompt")
	prompt.ActionText = "Start mission"
	prompt.ObjectText = def.Name
	prompt.KeyboardKeyCode = Enum.KeyCode.E
	prompt.HoldDuration = 0.4
	prompt.MaxActivationDistance = 12
	prompt.RequiresLineOfSight = false
	prompt.Parent = marker
	prompt.Triggered:Connect(function(player)
		start(player, def)
	end)
	local gui = Instance.new("BillboardGui")
	gui.Size = UDim2.fromOffset(240, 50)
	gui.StudsOffset = Vector3.new(0, 9, 0)
	gui.MaxDistance = 300
	gui.Parent = marker
	local label = Instance.new("TextLabel")
	label.BackgroundTransparency = 1
	label.Size = UDim2.fromScale(1, 1)
	label.Font = Enum.Font.FredokaOne
	label.TextScaled = true
	label.TextColor3 = Color3.fromRGB(255, 220, 90)
	label.TextStrokeTransparency = 0.2
	label.Text = "★ " .. def.Name
	label.Parent = gui
end

function Missions.init(systems)
	Net, PlayerState, Enemies, World, Boss = systems.Net, systems.Players, systems.Enemies, systems.World, systems.Boss
	Progression, Profiles = systems.Progression, systems.Profiles
end

function Missions.start()
	if not MapData.Anchors then
		return
	end
	for _, def in ipairs(DEFS) do
		buildMarker(def)
	end
	Players.PlayerRemoving:Connect(function(player)
		local run = active[player]
		if run and run.Cleanup then
			run.Cleanup()
		end
		active[player] = nil
	end)
	local accum = 0
	RunService.Heartbeat:Connect(function(dt)
		accum = accum + dt
		if accum < 0.2 then
			return
		end
		accum = 0
		local now = os.clock()
		for player, run in pairs(active) do
			local root = rootOf(player)
			local st = PlayerState.get(player)
			if not run.AllowDeath and not root then
				finish(player, false, "You were knocked out")
			elseif st and st.Level ~= Config.Levels.Retroville then
				finish(player, false, "You left Retroville")
			elseif now > run.Ends then
				finish(player, false, "Out of time")
			elseif run.Tick then
				local ok, err = pcall(run.Tick)
				if not ok then
					warn("[Missions] " .. tostring(err))
					finish(player, false)
				end
			end
		end
	end)
end

return Missions
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX18831"><Properties>
<string name="Name">Net</string>
<ProtectedString name="Source"><![CDATA[--!nonstrict
-- Creates every remote from Shared/Remotes and wraps client->server handlers
-- with per-player rate limiting and a type guard, so systems only ever see
-- well-formed requests from players who are in the game.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")

local Remotes = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Remotes"))

local Net = {}
local folder
local events = {}
local buckets = {} -- [player][name] = { tokens, last }

function Net.init()
	folder = Instance.new("Folder")
	folder.Name = "Remotes"
	for _, name in ipairs(Remotes.Events) do
		local e = Instance.new("RemoteEvent")
		e.Name = name
		e.Parent = folder
		events[name] = e
	end
	folder.Parent = ReplicatedStorage
	Players.PlayerRemoving:Connect(function(player)
		buckets[player] = nil
	end)
end

-- Token bucket: `rate` requests per second with bursts up to `burst`.
local function allow(player, name, rate, burst)
	local now = os.clock()
	local per = buckets[player]
	if not per then
		per = {}
		buckets[player] = per
	end
	local b = per[name]
	if not b then
		b = { tokens = burst, last = now }
		per[name] = b
	end
	b.tokens = math.min(burst, b.tokens + (now - b.last) * rate)
	b.last = now
	if b.tokens < 1 then
		return false
	end
	b.tokens = b.tokens - 1
	return true
end

-- handler(player, ...) runs only within the rate limit and with a live character.
function Net.on(name, rate, handler)
	local e = events[name]
	assert(e, "unknown remote " .. tostring(name))
	e.OnServerEvent:Connect(function(player, ...)
		if player.Parent == nil or not allow(player, name, rate, math.max(2, rate)) then
			return
		end
		local ok, err = pcall(handler, player, ...)
		if not ok then
			warn(("[Net] %s from %s failed: %s"):format(name, player.Name, tostring(err)))
		end
	end)
end

function Net.fire(name, player, ...)
	events[name]:FireClient(player, ...)
end

function Net.fireAll(name, ...)
	events[name]:FireAllClients(...)
end

-- Validation helpers for remote payloads.
function Net.isVector(v)
	return typeof(v) == "Vector3" and v.X == v.X and v.Y == v.Y and v.Z == v.Z
		and math.abs(v.X) < 1e6 and math.abs(v.Y) < 1e6 and math.abs(v.Z) < 1e6
end

function Net.unit(v)
	if not Net.isVector(v) or v.Magnitude < 1e-3 then
		return nil
	end
	return v.Unit
end

function Net.isNumber(v, lo, hi)
	return type(v) == "number" and v == v and v >= lo and v <= hi
end

return Net
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX18832"><Properties>
<string name="Name">Players</string>
<ProtectedString name="Source"><![CDATA[--!nonstrict
-- Per-player authoritative state: chosen hero, Omnitrix, ultimate meter,
-- cooldowns, energy for server-checked abilities, and damage immunity windows.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Omnitrix = require(Shared:WaitForChild("Omnitrix"))

local PlayerState = {}
local states = {}

function PlayerState.new(player)
	return {
		Player = player,
		Hero = "Jimmy",
		Omni = Omnitrix.new(Config.Omnitrix),
		Meter = 0,
		Energy = Config.Player.MaxEnergy,
		Cooldowns = {},       -- [name] = time when ready
		AttackStep = 0,
		LastAttack = -10,
		Intangible = false,
		DodgeUntil = 0,
		LastDodge = -10,
		Level = Config.Levels.Nexus,
		Kills = 0,
		Shards = 0,
		RegenAt = 0,
		Combo = 0,
		ComboAt = 0,
		DamageMul = 1,
		MeterMul = 1,
	}
end

function PlayerState.init()
	Players.PlayerAdded:Connect(function(player)
		states[player] = PlayerState.new(player)
	end)
	for _, player in ipairs(Players:GetPlayers()) do
		if not states[player] then
			states[player] = PlayerState.new(player)
		end
	end
	Players.PlayerRemoving:Connect(function(player)
		states[player] = nil
	end)
end

function PlayerState.get(player)
	return states[player]
end

function PlayerState.all()
	return states
end

-- Cooldown helper: true (and arms it) when `name` is ready.
function PlayerState.ready(st, name, seconds)
	local now = os.clock()
	if (st.Cooldowns[name] or 0) > now then
		return false
	end
	st.Cooldowns[name] = now + seconds
	return true
end

function PlayerState.addMeter(st, amount)
	st.Meter = math.clamp(st.Meter + amount, 0, 100)
	local character = st.Player.Character
	if character then
		character:SetAttribute("Meter", math.floor(st.Meter))
	end
end

-- Active Omnitrix form definition (nil when human or not Ben).
function PlayerState.form(st)
	if st.Hero ~= "Ben" then
		return nil
	end
	local index = Omnitrix.FormIndex(st.Omni.ActiveForm, Config)
	if index then
		return Config.Forms[index]
	end
	return nil
end

return PlayerState
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX18833"><Properties>
<string name="Name">Profiles</string>
<ProtectedString name="Source"><![CDATA[--!nonstrict
-- Saved player progress: level, XP, skill points and ranks, cash, collected
-- rift shards, course best times, missions completed.
--
-- One DataStore key per player, read-modify-write with UpdateAsync only, a
-- session lock so two servers never own the same profile (no dupes or
-- rollbacks when someone hops servers), retries with backoff, staggered
-- autosaves, and a final save on leave and on shutdown (BindToClose).
-- If a live server can't load someone's data they are kicked rather than
-- given a blank profile that would overwrite their real save. In Studio
-- without API access the game still runs with an unsaved profile.

local Players = game:GetService("Players")
local DataStoreService = game:GetService("DataStoreService")
local RunService = game:GetService("RunService")
local HttpService = game:GetService("HttpService")

local Profiles = {}
local STORE_NAME = "MultiverseToonsProfiles_v1"
local VERSION = 1
local AUTOSAVE = 60
local LOCK_STALE = AUTOSAVE * 2.5

local store
local profiles = {}   -- [player] = { Data = table, Saving = bool, NoSave = bool }
local loadedCallbacks = {}
local jobId = game.JobId ~= "" and game.JobId or ("studio-" .. HttpService:GenerateGUID(false))

local function defaultProfile()
	return {
		version = VERSION,
		Level = 1, Xp = 0, SkillPoints = 0, Skills = {}, Cash = 0, SkillPointsBought = 0,
		Shards = {},       -- array of shard ids
		Best = {},         -- course name -> seconds
		Missions = {},     -- mission id -> times completed
	}
end

local MIGRATIONS = {
	-- [1] = function(data) ... return data end,
}

local function migrate(data)
	data.version = data.version or 1
	while data.version < VERSION do
		local step = MIGRATIONS[data.version]
		if not step then
			error("missing migration from v" .. tostring(data.version))
		end
		data = step(data)
		data.version = data.version + 1
	end
	-- Fill fields added since (defensive; keeps old saves valid).
	for k, v in pairs(defaultProfile()) do
		if data[k] == nil then
			data[k] = v
		end
	end
	return data
end

local function withRetry(attempts, fn)
	local wait = 1
	for attempt = 1, attempts do
		local ok, a, b = pcall(fn)
		if ok then
			return true, a, b
		end
		warn(("[Profiles] attempt %d/%d failed: %s"):format(attempt, attempts, tostring(a)))
		if attempt < attempts then
			task.wait(wait)
			wait = math.min(wait * 2, 16)
		end
	end
	return false
end

local function key(player)
	return "u" .. player.UserId
end

-- Claim the lock and load. Returns data, or nil + reason ("locked" / "error").
local function claim(player)
	local result, reason
	local ok = withRetry(4, function()
		result, reason = nil, nil
		store:UpdateAsync(key(player), function(stored)
			local now = os.time()
			if stored and stored.lock and stored.lock.job ~= jobId and now - (stored.lock.time or 0) < LOCK_STALE then
				reason = "locked"
				return nil -- abort: another server owns this profile
			end
			local data = migrate(stored and stored.data or defaultProfile())
			result = data
			return { data = data, lock = { job = jobId, time = now } }
		end)
	end)
	if not ok then
		return nil, "error"
	end
	return result, reason
end

local function save(player, release)
	local entry = profiles[player]
	if not entry or entry.NoSave or not store then
		return true
	end
	local snapshot = HttpService:JSONDecode(HttpService:JSONEncode(entry.Data)) -- detach + validate JSON-safe
	return withRetry(release and 5 or 3, function()
		store:UpdateAsync(key(player), function(stored)
			if stored and stored.lock and stored.lock.job ~= jobId then
				return nil -- we lost the lock; never overwrite the new owner's data
			end
			return { data = snapshot, lock = (not release) and { job = jobId, time = os.time() } or nil }
		end)
	end)
end

local function setAttributes(player, data)
	player:SetAttribute("Level", data.Level)
	player:SetAttribute("Xp", data.Xp)
	player:SetAttribute("Cash", data.Cash)
	player:SetAttribute("SkillPoints", data.SkillPoints)
	for name, rank in pairs(data.Skills) do
		player:SetAttribute("Skill_" .. name, rank)
	end
end

local function onPlayerAdded(player)
	local data, reason
	if store then
		for _ = 1, 5 do
			data, reason = claim(player)
			if data or reason ~= "locked" then
				break
			end
			task.wait(4) -- the previous server may still be releasing it
		end
	end
	if not player.Parent then
		return
	end
	local entry
	if data then
		entry = { Data = data }
	elseif not store or RunService:IsStudio() then
		entry = { Data = defaultProfile(), NoSave = true }
		if store then
			warn("[Profiles] couldn't load data in Studio; using an unsaved profile")
		end
	else
		player:Kick(reason == "locked" and "Your progress is still saving from another server. Please rejoin in a moment."
			or "Your progress couldn't load right now. Please rejoin.")
		return
	end
	profiles[player] = entry
	setAttributes(player, entry.Data)
	player:SetAttribute("ProfileLoaded", true)
	for _, fn in ipairs(loadedCallbacks) do
		task.spawn(fn, player, entry.Data)
	end
	-- Staggered autosave.
	task.spawn(function()
		task.wait((player.UserId % AUTOSAVE) + 5)
		while profiles[player] == entry do
			save(player, false)
			task.wait(AUTOSAVE)
		end
	end)
end

function Profiles.get(player)
	local entry = profiles[player]
	return entry and entry.Data
end

-- fn(player, data) runs when a player's profile is ready (also for players already loaded).
function Profiles.onLoaded(fn)
	table.insert(loadedCallbacks, fn)
	for player, entry in pairs(profiles) do
		task.spawn(fn, player, entry.Data)
	end
end

function Profiles.sync(player)
	local data = Profiles.get(player)
	if data then
		setAttributes(player, data)
	end
end

function Profiles.init()
	local ok, result = pcall(function()
		return DataStoreService:GetDataStore(STORE_NAME)
	end)
	store = ok and result or nil
	if not store then
		warn("[Profiles] DataStores unavailable (unpublished place or API access off); progress won't save")
	end
end

function Profiles.start()
	Players.PlayerAdded:Connect(onPlayerAdded)
	for _, player in ipairs(Players:GetPlayers()) do
		task.spawn(onPlayerAdded, player)
	end
	Players.PlayerRemoving:Connect(function(player)
		if profiles[player] then
			save(player, true)
			profiles[player] = nil
		end
	end)
	game:BindToClose(function()
		if RunService:IsStudio() and not store then
			return
		end
		local pending = 0
		for player in pairs(profiles) do
			pending = pending + 1
			task.spawn(function()
				save(player, true)
				pending = pending - 1
			end)
		end
		local deadline = os.clock() + 25
		while pending > 0 and os.clock() < deadline do
			task.wait(0.2)
		end
	end)
end

return Profiles
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX18834"><Properties>
<string name="Name">Progression</string>
<ProtectedString name="Source"><![CDATA[--!nonstrict
-- Rewards and growth: XP and cash for kills, missions, courses and shards;
-- level-ups grant skill points; skills (Vitality, Power, Reserves, Aero,
-- Agility, Focus) apply to the hero; the Gear Locker in the Nexus sells
-- health packs, ultimate charge and extra skill points. All server-side;
-- the client only asks.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local MapData = require(Shared:WaitForChild("MapData"))
local Rules = require(Shared:WaitForChild("Progression"))

local Progression = {}
local Net, Profiles, PlayerState

function Progression.effects(player)
	local data = Profiles.get(player)
	return Rules.effects(data and data.Skills)
end

-- Apply skill effects that live on the character (max health).
function Progression.applyToCharacter(player)
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if not humanoid then
		return
	end
	local fx = Progression.effects(player)
	local st = PlayerState.get(player)
	if st then
		st.DamageMul = fx.Damage
		st.MeterMul = fx.Meter
	end
	local max = Config.Player.MaxHealth + fx.MaxHealth
	local frac = humanoid.Health / math.max(1, humanoid.MaxHealth)
	humanoid.MaxHealth = max
	humanoid.Health = math.clamp(frac * max, 1, max)
end

function Progression.award(player, xp, cash, reason)
	local data = Profiles.get(player)
	if not data then
		return
	end
	data.Cash = data.Cash + math.max(0, math.floor(cash or 0))
	local levels = Rules.addXp(data, xp or 0, Config)
	Profiles.sync(player)
	if (xp or 0) > 0 or (cash or 0) > 0 then
		Net.fire("Fx", player, { Kind = "Reward", Xp = math.floor(xp or 0), Cash = math.floor(cash or 0), Reason = reason })
	end
	if levels > 0 then
		Net.fire("Notify", player, { Banner = "LEVEL UP! Level " .. data.Level, Text = "+" .. levels .. " skill point" .. (levels > 1 and "s" or "") .. " - press K to spend", Color = Color3.fromRGB(255, 220, 90) })
		Net.fireAll("Fx", { Kind = "Burst", Pos = player.Character and player.Character:GetPivot().Position, Color = Color3.fromRGB(255, 220, 90), Count = 50 })
		local humanoid = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
		if humanoid then
			humanoid.Health = humanoid.MaxHealth
		end
	end
end

local function near(player, pos, range)
	local character = player.Character
	return character and pos and (character:GetPivot().Position - pos).Magnitude < range
end

local function onSkill(player, skill)
	local data = Profiles.get(player)
	if not data or type(skill) ~= "string" then
		return
	end
	if Rules.buySkill(data, skill, Config) then
		Profiles.sync(player)
		Progression.applyToCharacter(player)
		Net.fire("Notify", player, { Text = Config.Skills[skill].Name .. " rank " .. data.Skills[skill], Color = Color3.fromRGB(255, 220, 90), Time = 2 })
	end
end

local function onShop(player, itemId)
	local data = Profiles.get(player)
	local st = PlayerState.get(player)
	if not data or not st or type(itemId) ~= "string" then
		return
	end
	local services = MapData.Services or {}
	if not near(player, services.GearLocker, 30) then
		Net.fire("Notify", player, { Text = "Visit the Gear Locker in the Nexus to shop", Time = 2 })
		return
	end
	local item
	for _, it in ipairs(Config.Shop) do
		if it.Id == itemId then
			item = it
		end
	end
	if not item then
		return
	end
	local price = item.Price
	if item.Id == "SkillPoint" then
		price = Rules.skillPointPrice(data.SkillPointsBought, Config)
	end
	if data.Cash < price then
		Net.fire("Notify", player, { Text = "Not enough cash ($" .. price .. ")", Color = Color3.fromRGB(255, 140, 120), Time = 2 })
		return
	end
	data.Cash = data.Cash - price
	if item.Id == "Medkit" then
		local humanoid = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
		if humanoid then
			humanoid.Health = math.min(humanoid.MaxHealth, humanoid.Health + 60)
		end
	elseif item.Id == "Charge" then
		PlayerState.addMeter(st, 50)
	elseif item.Id == "SkillPoint" then
		data.SkillPoints = data.SkillPoints + 1
		data.SkillPointsBought = data.SkillPointsBought + 1
	end
	Profiles.sync(player)
	Net.fire("Notify", player, { Text = "Bought " .. item.Name, Color = Color3.fromRGB(140, 255, 160), Time = 2 })
	Net.fire("OpenShop", player, { Prices = Progression.prices(player) })
end

function Progression.prices(player)
	local data = Profiles.get(player)
	local prices = {}
	for _, it in ipairs(Config.Shop) do
		prices[it.Id] = it.Id == "SkillPoint" and Rules.skillPointPrice(data and data.SkillPointsBought or 0, Config) or it.Price
	end
	return prices
end

local function servicePrompt(pos, action, object, onTrigger)
	if not pos then
		return
	end
	local anchor = Instance.new("Part")
	anchor.Name = "ServicePrompt_" .. object
	anchor.Anchored = true
	anchor.CanCollide = false
	anchor.CanQuery = false
	anchor.Transparency = 1
	anchor.Size = Vector3.new(4, 4, 4)
	anchor.CFrame = CFrame.new(pos + Vector3.new(0, 3, 0))
	anchor.Parent = workspace:FindFirstChild("Interactables") or workspace
	local prompt = Instance.new("ProximityPrompt")
	prompt.ActionText = action
	prompt.ObjectText = object
	prompt.KeyboardKeyCode = Enum.KeyCode.E
	prompt.HoldDuration = 0
	prompt.MaxActivationDistance = 18
	prompt.RequiresLineOfSight = false
	prompt.Parent = anchor
	prompt.Triggered:Connect(onTrigger)
	local gui = Instance.new("BillboardGui")
	gui.Size = UDim2.fromOffset(200, 40)
	gui.StudsOffset = Vector3.new(0, 7, 0)
	gui.MaxDistance = 200
	gui.Parent = anchor
	local label = Instance.new("TextLabel")
	label.BackgroundTransparency = 1
	label.Size = UDim2.fromScale(1, 1)
	label.Font = Enum.Font.FredokaOne
	label.TextScaled = true
	label.TextColor3 = Color3.fromRGB(255, 230, 120)
	label.TextStrokeTransparency = 0.2
	label.Text = object
	label.Parent = gui
end

function Progression.init(systems)
	Net, Profiles, PlayerState = systems.Net, systems.Profiles, systems.Players
	Net.on("Skill", 5, onSkill)
	Net.on("Shop", 4, onShop)
end

function Progression.start()
	local services = MapData.Services or {}
	servicePrompt(services.GearLocker, "Shop", "Gear Locker", function(player)
		Net.fire("OpenShop", player, { Prices = Progression.prices(player) })
	end)
	servicePrompt(services.UpgradeBench, "Skills", "Upgrade Bench", function(player)
		Net.fire("OpenShop", player, { Skills = true })
	end)
	Profiles.onLoaded(function(player)
		Progression.applyToCharacter(player)
	end)
	local function hook(player)
		player.CharacterAdded:Connect(function()
			task.wait(0.5)
			Progression.applyToCharacter(player)
		end)
	end
	Players.PlayerAdded:Connect(hook)
	for _, player in ipairs(Players:GetPlayers()) do
		hook(player)
	end
end

return Progression
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX18835"><Properties>
<string name="Name">Traffic</string>
<ProtectedString name="Source"><![CDATA[--!nonstrict
-- Ambient traffic: hover cars cruise Retroville's main roads, stop for
-- people in the way, and turn around at the end of the road. Any of them can
-- be hijacked: walk up and press E to drive it.

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local MapData = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("MapData"))

local Traffic = {}
local World, Enemies
local cars = {}
local COUNT = 12
local SPEED = 38
local COLORS = {
	Color3.fromRGB(60, 140, 230), Color3.fromRGB(250, 200, 40), Color3.fromRGB(80, 200, 120), Color3.fromRGB(240, 240, 245),
	Color3.fromRGB(240, 120, 40), Color3.fromRGB(160, 90, 220), Color3.fromRGB(40, 40, 50),
}

local function laneFor(road, dirSign)
	-- Drive on the right: offset from the centre line by a quarter of the road width.
	local axis = road.Axis == "X" and Vector3.new(1, 0, 0) or Vector3.new(0, 0, 1)
	local right = Vector3.new(-axis.Z, 0, axis.X) * dirSign
	return axis * dirSign, road.C + right * road.W * 0.25
end

local function spawnCar(road, index)
	local dirSign = index % 2 == 0 and 1 or -1
	local dir, laneCenter = laneFor(road, dirSign)
	local along = (math.random() - 0.5) * road.L * 0.8
	local pos = laneCenter + dir * along
	local yaw = math.deg(math.atan2(-dir.X, -dir.Z))
	local model = World.buildHoverCar(pos, yaw, COLORS[(index % #COLORS) + 1])
	model.Name = "TrafficCar"
	local body = model.PrimaryPart
	local car = {
		Model = model, Body = body, Seat = model:FindFirstChild("DriverSeat"), Road = road, Sign = dirSign,
		Velocity = body:FindFirstChild("DriveVelocity"), Orientation = body:FindFirstChild("DriveOrientation"), AI = true,
	}
	table.insert(cars, car)
	return car
end

local function blocked(car, dir)
	local pos = car.Body.Position
	for _, player in ipairs(Players:GetPlayers()) do
		local character = player.Character
		local root = character and character:FindFirstChild("HumanoidRootPart")
		if root then
			local rel = root.Position - pos
			local ahead = rel:Dot(dir)
			if ahead > 0 and ahead < 16 and (rel - dir * ahead).Magnitude < 5 then
				return true
			end
		end
	end
	return false
end

local function drive(car, dt)
	if car.Seat and car.Seat.Occupant then
		car.AI = false -- hijacked: it's the driver's car now
		return
	end
	if not car.AI or not car.Velocity then
		return
	end
	local road = car.Road
	local dir, laneCenter = laneFor(road, car.Sign)
	local pos = car.Body.Position
	-- Turn around at the end of the road.
	local fromCenter = (pos - road.C):Dot(road.Axis == "X" and Vector3.new(1, 0, 0) or Vector3.new(0, 0, 1)) * car.Sign
	if fromCenter > road.L * 0.47 then
		car.Sign = -car.Sign
		dir, laneCenter = laneFor(road, car.Sign)
	end
	-- Hold the lane and a hover height.
	local toLane = laneCenter - pos
	local lateral = toLane - dir * toLane:Dot(dir)
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = { car.Model, workspace:FindFirstChild("Enemies") }
	local hit = workspace:Raycast(pos + Vector3.new(0, 4, 0), Vector3.new(0, -60, 0), params)
	local groundY = hit and hit.Position.Y or pos.Y - 4
	local vy = math.clamp((groundY + 4 - pos.Y) * 3, -30, 30)
	local speed = blocked(car, dir) and 0 or SPEED
	car.Velocity.MaxForce = 2e5
	car.Velocity.VectorVelocity = dir * speed + Vector3.new(lateral.X, 0, lateral.Z) * 2 + Vector3.new(0, vy, 0)
	car.Orientation.CFrame = CFrame.lookAt(Vector3.zero, dir)
end

function Traffic.init(systems)
	World, Enemies = systems.World, systems.Enemies
end

function Traffic.start()
	local roads = MapData.Roads or {}
	if #roads == 0 then
		return
	end
	table.sort(roads, function(a, b)
		return a.L > b.L
	end)
	task.wait(3)
	for i = 1, COUNT do
		spawnCar(roads[((i - 1) % math.min(#roads, 8)) + 1], i)
	end
	local accum = 0
	RunService.Heartbeat:Connect(function(dt)
		accum = accum + dt
		if accum < 0.1 then
			return
		end
		accum = 0
		for i = #cars, 1, -1 do
			local car = cars[i]
			if not car.Model.Parent or not car.Body.Parent then
				table.remove(cars, i)
			else
				drive(car, 0.1)
			end
		end
	end)
	-- Keep the streets busy: replace cars that were taken and abandoned far away.
	task.spawn(function()
		while true do
			task.wait(60)
			local ai = 0
			for _, car in ipairs(cars) do
				if car.AI then
					ai = ai + 1
				end
			end
			for i = ai + 1, COUNT do
				spawnCar(roads[math.random(1, math.min(#roads, 8))], i)
			end
			-- Clean up abandoned cars nobody is near.
			for i = #cars, 1, -1 do
				local car = cars[i]
				if not car.AI and not (car.Seat and car.Seat.Occupant) then
					local near = false
					for _, player in ipairs(Players:GetPlayers()) do
						local character = player.Character
						if character and (character:GetPivot().Position - car.Body.Position).Magnitude < 250 then
							near = true
						end
					end
					if not near then
						car.Model:Destroy()
						table.remove(cars, i)
					end
				end
			end
		end
	end)
end

return Traffic
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX18836"><Properties>
<string name="Name">World</string>
<ProtectedString name="Source"><![CDATA[--!nonstrict
-- The two worlds baked into Workspace by tools/build_place.py (Nexus
-- Observatory hub and Retroville), described by Shared/MapData: spawning,
-- dimensional terminals (swap hero / travel), recall, and Jimmy's hover cars.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local MapData = require(Shared:WaitForChild("MapData"))

local World = {}
local Net, PlayerState
local terminals = {} -- { Name, Pos, Level, Universe, Hero, Travel }

function World.level(name)
	return MapData.Levels[name]
end

function World.startCFrame(levelName)
	local level = MapData.Levels[levelName] or MapData.Levels[Config.Levels.Nexus]
	return CFrame.new(level.Start + Vector3.new(0, 4, 0)) * CFrame.Angles(0, math.rad(level.StartYaw), 0)
end

function World.levelOf(player)
	local st = PlayerState.get(player)
	return st and st.Level or Config.Levels.Nexus
end

function World.nearTerminal(player, wantTravel)
	local character = player.Character
	if not character then
		return nil
	end
	local pos = character:GetPivot().Position
	for _, t in ipairs(terminals) do
		if (t.Pos - pos).Magnitude < 26 and (not wantTravel or t.Travel == wantTravel) then
			return t
		end
	end
	return nil
end

function World.travel(player, levelName)
	local st = PlayerState.get(player)
	local character = player.Character
	if not st or not character or not MapData.Levels[levelName] then
		return
	end
	-- Leave any vehicle first.
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if humanoid and humanoid.SeatPart then
		humanoid.Sit = false
		task.wait()
	end
	st.Level = levelName
	player:SetAttribute("Level", levelName)
	character:PivotTo(World.startCFrame(levelName))
	local root = character:FindFirstChild("HumanoidRootPart")
	if root then
		root.AssemblyLinearVelocity = Vector3.zero
	end
	Net.fire("Notify", player, { Banner = MapData.Levels[levelName].Name, Text = MapData.Levels[levelName].Blurb })
end

local function buildTerminal(t)
	local anchor = Instance.new("Part")
	anchor.Name = "TerminalPrompt_" .. t.Name
	anchor.Anchored = true
	anchor.CanCollide = false
	anchor.CanQuery = false
	anchor.Transparency = 1
	anchor.Size = Vector3.new(4, 4, 4)
	anchor.CFrame = CFrame.new(t.Pos + Vector3.new(0, 4, 0))
	anchor.Parent = workspace:FindFirstChild("Interactables") or workspace
	local prompt = Instance.new("ProximityPrompt")
	prompt.ActionText = t.Travel and "Swap hero / Travel" or "Swap hero"
	prompt.ObjectText = t.Universe .. " terminal"
	prompt.KeyboardKeyCode = Enum.KeyCode.E
	prompt.HoldDuration = 0
	prompt.MaxActivationDistance = 16
	prompt.RequiresLineOfSight = false
	prompt.Parent = anchor
	prompt.Triggered:Connect(function(player)
		Net.fire("OpenTerminal", player, { Name = t.Name, Universe = t.Universe, Hero = t.Hero, Travel = t.Travel })
	end)
	-- Floating label.
	local gui = Instance.new("BillboardGui")
	gui.Size = UDim2.fromOffset(220, 50)
	gui.StudsOffset = Vector3.new(0, 6, 0)
	gui.MaxDistance = 220
	gui.AlwaysOnTop = false
	gui.Parent = anchor
	local label = Instance.new("TextLabel")
	label.BackgroundTransparency = 1
	label.Size = UDim2.fromScale(1, 1)
	label.Font = Enum.Font.FredokaOne
	label.TextScaled = true
	label.TextColor3 = Color3.new(1, 1, 1)
	label.TextStrokeTransparency = 0.2
	label.Text = t.Universe
	label.Parent = gui
end

-- Jimmy's retro hover convertible: a seat on a hover body the driver's client flies.
function World.buildHoverCar(pos, yaw, bodyColor)
	local model = Instance.new("Model")
	model.Name = "HoverCar"
	local base = CFrame.new(pos + Vector3.new(0, 3, 0)) * CFrame.Angles(0, math.rad(yaw), 0)
	local function part(name, size, offset, color, material, shape)
		local p = Instance.new("Part")
		p.Name = name
		p.Size = size
		p.CFrame = base * offset
		p.Color = color
		p.Material = material or Enum.Material.SmoothPlastic
		p.TopSurface = Enum.SurfaceType.Smooth
		p.BottomSurface = Enum.SurfaceType.Smooth
		if shape then
			p.Shape = shape
		end
		p.Parent = model
		return p
	end
	local body = part("Body", Vector3.new(6.5, 1.6, 12), CFrame.new(), bodyColor or Color3.fromRGB(210, 40, 40))
	part("Fin", Vector3.new(6.7, 0.5, 3), CFrame.new(0, 0.9, 4.5), Color3.fromRGB(240, 240, 245))
	part("Windshield", Vector3.new(5.6, 1.4, 0.2), CFrame.new(0, 1.5, -2) * CFrame.Angles(math.rad(-20), 0, 0), Color3.fromRGB(150, 220, 255), Enum.Material.Glass).Transparency = 0.4
	part("Grille", Vector3.new(5, 0.8, 0.3), CFrame.new(0, -0.1, -6.1), Color3.fromRGB(220, 220, 230), Enum.Material.Metal)
	for _, x in ipairs({ -2.2, 2.2 }) do
		part("Headlight", Vector3.new(1, 1, 0.3), CFrame.new(x, 0.2, -6.15), Color3.fromRGB(255, 250, 210), Enum.Material.Neon)
		for _, z in ipairs({ -4, 4 }) do
			part("HoverPad", Vector3.new(0.5, 2.4, 2.4), CFrame.new(x, -1.1, z) * CFrame.Angles(0, 0, math.pi / 2), Color3.fromRGB(110, 230, 255), Enum.Material.Neon, Enum.PartType.Cylinder)
		end
	end
	local seat = Instance.new("Seat")
	seat.Name = "DriverSeat"
	seat.Size = Vector3.new(2.4, 0.6, 2.4)
	seat.CFrame = base * CFrame.new(0, 1.1, 0.5)
	seat.Color = Color3.fromRGB(240, 240, 245)
	seat.Parent = model
	local prompt = Instance.new("ProximityPrompt")
	prompt.ActionText = "Drive"
	prompt.ObjectText = "Hover car"
	prompt.KeyboardKeyCode = Enum.KeyCode.E
	prompt.HoldDuration = 0
	prompt.MaxActivationDistance = 14
	prompt.RequiresLineOfSight = false
	prompt.Parent = seat
	prompt.Triggered:Connect(function(player)
		local character = player.Character
		local humanoid = character and character:FindFirstChildOfClass("Humanoid")
		if humanoid and not seat.Occupant and humanoid.Health > 0 then
			seat:Sit(humanoid)
		end
	end)
	for _, p in ipairs(model:GetChildren()) do
		if p ~= body then
			local w = Instance.new("WeldConstraint")
			w.Part0 = body
			w.Part1 = p
			w.Parent = p
		end
		p.CustomPhysicalProperties = PhysicalProperties.new(0.3, 0.3, 0.2)
	end
	model.PrimaryPart = body
	-- The driver's client controls these (Controllers/Vehicle).
	local att = Instance.new("Attachment")
	att.Name = "Drive"
	att.Parent = body
	local lv = Instance.new("LinearVelocity")
	lv.Name = "DriveVelocity"
	lv.Attachment0 = att
	lv.MaxForce = 0
	lv.VectorVelocity = Vector3.zero
	lv.Parent = body
	local ao = Instance.new("AlignOrientation")
	ao.Name = "DriveOrientation"
	ao.Mode = Enum.OrientationAlignmentMode.OneAttachment
	ao.Attachment0 = att
	ao.MaxTorque = 1e7
	ao.Responsiveness = 18
	ao.CFrame = base.Rotation
	ao.Parent = body
	model.Parent = workspace:FindFirstChild("Vehicles") or workspace
	seat:GetPropertyChangedSignal("Occupant"):Connect(function()
		local occupant = seat.Occupant
		local player = occupant and Players:GetPlayerFromCharacter(occupant.Parent)
		if player then
			body:SetNetworkOwner(player)
			lv.MaxForce = 2e5
		else
			lv.MaxForce = 0
			lv.VectorVelocity = Vector3.zero
			-- Keep the heading the driver left it at (their orientation target was local).
			local _, yaw = body.CFrame:ToEulerAnglesYXZ()
			ao.CFrame = CFrame.Angles(0, yaw, 0)
			pcall(function()
				body:SetNetworkOwnershipAuto()
			end)
		end
	end)
	return model
end

function World.init(systems)
	Net, PlayerState = systems.Net, systems.Players
	for _, name in ipairs({ "Interactables", "Vehicles" }) do
		if not workspace:FindFirstChild(name) then
			local f = Instance.new("Folder")
			f.Name = name
			f.Parent = workspace
		end
	end
	for levelName, level in pairs(MapData.Levels) do
		for _, t in ipairs(level.Terminals) do
			table.insert(terminals, { Name = t.Name, Pos = t.Pos, Level = levelName, Universe = t.Universe, Hero = t.Hero, Travel = t.Travel })
		end
	end
	Net.on("Travel", 2, function(player, target)
		if type(target) ~= "string" or not MapData.Levels[target] then
			return
		end
		-- Recall to the hub works anywhere; other worlds need their terminal.
		if target ~= Config.Levels.Nexus and not World.nearTerminal(player, target) then
			return
		end
		World.travel(player, target)
	end)
end

-- Day and night: a full day every Config.DayLengthSeconds.
local function dayNight()
	local Lighting = game:GetService("Lighting")
	local start = Lighting.ClockTime
	local t0 = os.clock()
	while true do
		local hours = (start + (os.clock() - t0) / Config.DayLengthSeconds * 24) % 24
		Lighting.ClockTime = hours
		local night = hours < 6 or hours > 19
		Lighting.Brightness = night and 1.2 or 2.6
		workspace:SetAttribute("Night", night)
		task.wait(1)
	end
end

function World.start()
	task.spawn(dayNight)
	for _, t in ipairs(terminals) do
		buildTerminal(t)
	end
	for _, level in pairs(MapData.Levels) do
		for _, car in ipairs(level.HoverCars) do
			World.buildHoverCar(car.Pos, car.Yaw)
		end
	end
	local function hook(player)
		player:SetAttribute("Level", Config.Levels.Nexus)
		player.CharacterAdded:Connect(function(character)
			character:WaitForChild("HumanoidRootPart", 10)
			task.wait(0.1)
			character:PivotTo(World.startCFrame(World.levelOf(player)))
		end)
	end
	Players.PlayerAdded:Connect(hook)
	for _, player in ipairs(Players:GetPlayers()) do
		hook(player)
	end
end

return World
]]></ProtectedString>
</Properties>
</Item>
</Item>
</Item>
</Item>
<Item class="StarterPlayer" referent="RBX18837"><Properties>
<string name="Name">StarterPlayer</string>
<bool name="CharacterUseJumpPower">false</bool>
<float name="CharacterJumpHeight">7.5000</float>
<float name="CharacterWalkSpeed">21.0000</float>
<bool name="LoadCharacterAppearance">false</bool>
<bool name="EnableMouseLockOption">false</bool>
